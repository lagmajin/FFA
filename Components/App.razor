﻿<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="/css/FFA.styles.css" />
    <link rel="stylesheet" href="/css/timeweather.css" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    @using Microsoft.AspNetCore.Components.Authorization
    @using Microsoft.AspNetCore.Components.Web
    <CascadingAuthenticationState>
        <Routes @rendermode="InteractiveServer" />
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <!-- Blazor Server script for interactive server render mode -->
    <script src="/_framework/blazor.server.js"></script>
    <script>
        // Report client-side errors to server for diagnosis (uses navigator.sendBeacon if available)
        function reportClientError(payload) {
            try {
                const url = '/clientlog';
                const body = JSON.stringify(payload);
                if (navigator.sendBeacon) {
                    const blob = new Blob([body], { type: 'application/json' });
                    navigator.sendBeacon(url, blob);
                } else {
                    fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body }).catch(() => { });
                }
            } catch (e) { try { console.warn('reportClientError failed', e); } catch { } }
        }

        // global error
        window.addEventListener('error', function (event) {
            try {
                console.error('Global error:', event.error || event.message);
                reportClientError({ level: 'error', message: event.message || String(event.error), stack: (event.error && event.error.stack) || null, source: event.filename || null, lineno: event.lineno || null, colno: event.colno || null, url: location.href, userAgent: navigator.userAgent });
            } catch (e) { }
        });

        // unhandled promise rejection
        window.addEventListener('unhandledrejection', function (event) {
            try {
                console.error('Unhandled rejection:', event.reason);
                var msg = (event.reason && event.reason.message) ? event.reason.message : String(event.reason);
                var stack = (event.reason && event.reason.stack) ? event.reason.stack : null;
                reportClientError({ level: 'error', message: msg, stack: stack, url: location.href, userAgent: navigator.userAgent });
            } catch (e) { }
        });

        // pagehide visibility
        window.addEventListener('pagehide', function (event) {
            try { console.log('pagehide event detected'); } catch (e) { console.warn('pagehide handler error', e); }
        });

        document.addEventListener('visibilitychange', function () {
            try { if (document.visibilityState === 'hidden') { console.log('visibilitychange: hidden'); } } catch (e) { console.warn('visibilitychange handler error', e); }
        });
    </script>
</body>

</html>
