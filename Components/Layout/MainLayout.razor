@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@inherits LayoutComponentBase
@inject NavigationManager NavManager
@implements IAsyncDisposable

<header>
    <div class="header-content">
        <h1>FFA World</h1>
        <nav class="right-nav">
            <AuthorizeView>
                <Authorized>
                    <a href="#" class="nav-link" @onclick="SignOut">ログアウト</a>
                </Authorized>
                <NotAuthorized>
                    @if (currentIsHomePage)
                    {
                        <NavLink href="/login">ログイン</NavLink>
                        <NavLink href="/register">新規登録</NavLink>
                        <a href="#" class="nav-link" @onclick="TestPlay">テストプレイ</a>
                    }
                    else
                    {
                        <NavLink href="/login">ログイン</NavLink>
                        <NavLink href="/register">新規登録</NavLink>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

<main>
    <ErrorBoundary @ref="mainErrorBoundary">
        <ChildContent>
            @Body
        </ChildContent>
        <ErrorContent Context="ex">
            <div class="error-container" style="padding: 2rem; margin: 2rem; background-color: #fee; border: 2px solid #c00; border-radius: 8px;">
                <h2 style="color: #c00;">🚨 ページエラーが発生しました</h2>
                <p><strong>種類:</strong> @ex.GetType().Name</p>
                <p><strong>メッセージ:</strong> @ex.Message</p>
                @if (ex.InnerException != null)
                {
                    <p><strong>内部エラー:</strong> @ex.InnerException.Message</p>
                }
                <details style="margin: 10px 0;">
                    <summary style="cursor: pointer;">スタックトレース</summary>
                    <pre style="background: #f5f5f5; padding: 10px; overflow-x: auto; font-size: 11px; white-space: pre-wrap;">@ex.StackTrace</pre>
                </details>
                <div style="margin-top: 15px;">
                    <button @onclick="RecoverMain" style="padding: 10px 20px; background: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer; margin-right: 10px;">
                        回復を試みる
                    </button>
                    <a href="/status" class="action-button" style="padding: 10px 20px; background: #2196F3; color: white; text-decoration: none; border-radius: 4px;">ステータスへ</a>
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</main>

<footer>
    <nav>
        <NavLink href="/guide">ガイド</NavLink>
        <NavLink href="/about">About</NavLink>
        <NavLink href="/contact">Contact</NavLink>
    </nav>
</footer>

<div id="blazor-error-ui" data-nosnippet style="display:none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
    <pre id="blazor-error-details" style="white-space: pre-wrap; display: none; max-width: 30rem; overflow:auto;"> </pre>
</div>

<script src="/js/auth.js"></script>
<link href="/css/timeweather.css" rel="stylesheet" />
<script src="/js/signalr.min.js"></script>
<component type="typeof(Components.Systems.TimeWeather)" render-mode="InteractiveServer" />
<component type="typeof(Components.Systems.KarmaBadge)" render-mode="InteractiveServer" />
<script>
    (function () {
        try {
            // バナーは表示せず、コンソールにだけ記録する
            window.addEventListener('error', function (e) {
                try {
                    const info = (e && e.error && e.error.stack) ? e.error.stack : (e && e.message) || String(e);
                    console.warn('[blazor-error suppressed]', info);
                } catch (ex) { /* swallow */ }
            });

            window.addEventListener('unhandledrejection', function (e) {
                try {
                    const reason = e && e.reason ? e.reason : 'unknown';
                    const text = (reason && reason.stack) ? reason.stack : (reason && reason.message) ? reason.message : String(reason);
                    console.warn('[blazor-error suppressed]', text);
                } catch (ex) { /* swallow */ }
            });

            const ui = document.getElementById('blazor-error-ui');
            if (ui) {
                const dismiss = ui.querySelector('.dismiss');
                if (dismiss) dismiss.addEventListener('click', function () { ui.style.display = 'none'; });
                const reload = ui.querySelector('.reload');
                if (reload) reload.addEventListener('click', function (ev) { ev.preventDefault(); location.reload(); });
            }
        } catch (err) {
            console.error(err);
        }
    })();
</script>

@code {
    private ErrorBoundary? mainErrorBoundary;
    private bool currentIsHomePage = false;

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UpdateIsHomePage();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateIsHomePage();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateIsHomePage()
    {
        var uri = new Uri(Navigation.Uri);
        currentIsHomePage = uri.AbsolutePath == "/";
    }

    private void RecoverMain()
    {
        mainErrorBoundary?.Recover();
    }

    private async Task TestPlay(MouseEventArgs e)
    {
        const string testUsername = "testplayer";
        const string testPassword = "test123";

        try
        {
            // Ensure test user exists
            var userService = new Services.UserService();
            var existingUser = userService.GetByUsername(testUsername);
            if (existingUser == null)
            {
                userService.Register(testUsername, testPassword, Models.Job.Warrior);
            }

            // Call signin API via JavaScript
            var url = Navigation.ToAbsoluteUri("/signin").ToString();
            var payload = new { Username = testUsername, Password = testPassword };
            var ok = await JS.InvokeAsync<bool>("fetchSignIn", url, payload);
            if (ok)
            {
                // Navigate to status with force reload to apply auth state
                Navigation.NavigateTo("/status", true);
            }
            else
            {
                Console.WriteLine("テストプレイのサインインに失敗しました。");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"TestPlay error: {ex.Message}");
        }
    }

    private async Task SignOut(MouseEventArgs e)
    {
        try
        {
            await JS.InvokeAsync<bool>("fetchSignOut", Navigation.ToAbsoluteUri("/signout").ToString());
        }
        catch { }
        // Always force full browser reload to clear SignalR circuit and auth state
        Navigation.NavigateTo("/signout", true);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
