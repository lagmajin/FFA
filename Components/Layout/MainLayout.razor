@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inherits LayoutComponentBase
@inject NavigationManager NavManager
@implements IAsyncDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Color="Color.Primary" Fixed="true" Style="display:flex; flex-wrap:nowrap;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />

        <MudText Typo="Typo.h6" Style="white-space:nowrap;">FFA World</MudText>

        <MudSpacer />

        <div style="display:flex; align-items:center; gap:4px; flex-shrink:0; margin-left:auto;">
            <AuthorizeView>
                <Authorized>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.ExitToApp" OnClick="SignOut">ログアウト</MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudButton Href="/register" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.PersonAdd">新規登録</MudButton>
                    <MudButton Href="/login" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">ログイン</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SportsEsports" OnClick="TestPlay">テストプレイ</MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="1">
        <MudDrawerHeader Class="d-flex justify-start pa-0">
            <MudText Typo="Typo.h6" Style="font-weight:700;">メニュー</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/guide" Icon="@Icons.Material.Filled.Info">ガイド</MudNavLink>
            <MudNavLink Href="/about" Icon="@Icons.Material.Filled.Info">About</MudNavLink>
            <MudNavLink Href="/contact" Icon="@Icons.Material.Filled.Mail">Contact</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">ホーム</MudNavLink>
            <MudNavLink Href="/market" Icon="@Icons.Material.Filled.Store">マーケット</MudNavLink>
            <MudNavLink Href="/ranking" Icon="@Icons.Material.Filled.EmojiEvents">ランキング</MudNavLink>
            <MudNavLink Href="/sky-arena" Icon="@Icons.Material.Filled.SelfImprovement">天空闘技場</MudNavLink>
            <MudNavLink Href="/chat" Icon="@Icons.Material.Filled.Chat">チャット</MudNavLink>
            <MudNavLink Href="/tavern" Icon="@Icons.Material.Filled.LocalBar">酒場</MudNavLink>
            <MudNavLink Href="/exploration" Icon="@Icons.Material.Filled.Explore">探索</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <main Style="padding: 72px 20px 20px 20px; background-color: #d0d0d0;">
            <ErrorBoundary @ref="mainErrorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
            <div class="error-container" style="padding: 2rem; margin: 2rem; background-color: #fee; border: 2px solid #c00; border-radius: 8px;">
                <h2 style="color: #c00;">🚨 ページエラーが発生しました</h2>
                <p><strong>種類:</strong> @ex.GetType().Name</p>
                <p><strong>メッセージ:</strong> @ex.Message</p>
                @if (ex.InnerException != null)
                {
                    <p><strong>内部エラー:</strong> @ex.InnerException.Message</p>
                }
                <details style="margin: 10px 0;">
                    <summary style="cursor: pointer;">スタックトレース</summary>
                    <pre style="background: #f5f5f5; padding: 10px; overflow-x: auto; font-size: 11px; white-space: pre-wrap;">@ex.StackTrace</pre>
                </details>
                <div style="margin-top: 15px;">
                    <button @onclick="RecoverMain" style="padding: 10px 20px; background: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer; margin-right: 10px;">
                        回復を試みる
                    </button>
                    <a href="/status" class="action-button" style="padding: 10px 20px; background: #2196F3; color: white; text-decoration: none; border-radius: 4px;">ステータスへ</a>
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>
        </main>

        <footer Style="padding: 20px; text-align: center; border-top: 1px solid #eee; margin-top: 40px;">
            <nav>
                <NavLink href="/guide" style="margin-right: 16px;">ガイド</NavLink>
                <NavLink href="/about" style="margin-right: 16px;">About</NavLink>
                <NavLink href="/contact">Contact</NavLink>
            </nav>
        </footer>

        <!-- Compact error UI: show unobtrusive icon; expand details on click -->
        <div id="blazor-error-ui" data-nosnippet style="display:none;">
            <div id="blazor-error-compact" style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <span title="エラーが発生しました">⚠️</span>
                <span style="font-size:0.9rem;">An error occurred</span>
                <a href="." class="reload" style="margin-left:8px;">Reload</a>
                <span class="dismiss" title="閉じる">🗙</span>
            </div>
            <div id="blazor-error-brief" style="display:none; font-size:0.85rem; margin-top:6px; max-width:30rem; white-space:pre-wrap; overflow:auto;"></div>
            <details id="blazor-error-details-panel" style="display:none; margin-top:6px; max-width:30rem;">
                <summary style="cursor:pointer; font-weight:bold;">詳細を表示</summary>
                <pre id="blazor-error-details" style="white-space: pre-wrap;"> </pre>
            </details>
        </div>

        <script src="/js/auth.js"></script>
        <script src="/js/signalr.min.js"></script>
        <component type="typeof(Components.Systems.TimeWeather)" render-mode="InteractiveServer" />
        <component type="typeof(Components.Systems.KarmaBadge)" render-mode="InteractiveServer" />
    </MudMainContent>
</MudLayout>
<script>
    (function () {
        try {
            // バナーは表示せず、コンソールにだけ記録する
            window.addEventListener('error', function (e) {
                try {
                    const info = (e && e.error && e.error.stack) ? e.error.stack : (e && e.message) || String(e);
                    console.warn('[blazor-error suppressed]', info);
                } catch (ex) { /* swallow */ }
            });

            window.addEventListener('unhandledrejection', function (e) {
                try {
                    const reason = e && e.reason ? e.reason : 'unknown';
                    const text = (reason && reason.stack) ? reason.stack : (reason && reason.message) ? reason.message : String(reason);
                    console.warn('[blazor-error suppressed]', text);
                } catch (ex) { /* swallow */ }
            });

            const ui = document.getElementById('blazor-error-ui');
            if (ui) {
                const compact = document.getElementById('blazor-error-compact');
                const brief = document.getElementById('blazor-error-brief');
                const detailsPanel = document.getElementById('blazor-error-details-panel');
                const detailsPre = document.getElementById('blazor-error-details');
                const dismiss = ui.querySelector('.dismiss');
                const reload = ui.querySelector('.reload');

                // Dismiss hides the compact UI only; details remain logged to console/startup.log
                if (dismiss) dismiss.addEventListener('click', function () { ui.style.display = 'none'; });
                if (reload) reload.addEventListener('click', function (ev) { ev.preventDefault(); location.reload(); });

                // Toggle details on compact click
                if (compact) compact.addEventListener('click', function () {
                    if (!detailsPanel) return;
                    const shown = detailsPanel.style.display === 'block';
                    detailsPanel.style.display = shown ? 'none' : 'block';
                    brief.style.display = shown ? 'none' : 'block';
                });

                // When blazor sets the UI visible, keep only compact visible and show brief text
                const observer = new MutationObserver(function (mutations) {
                    mutations.forEach(function (m) {
                        if (m.attributeName === 'style') {
                            try {
                                if (ui.style.display !== 'none') {
                                    // keep compact visible, hide detailed stack by default
                                    if (detailsPanel) detailsPanel.style.display = 'none';
                                    if (brief) {
                                        // copy first line of details into brief
                                        const full = detailsPre ? detailsPre.innerText || detailsPre.textContent : '';
                                        const first = full ? full.split('\n')[0] : '';
                                        brief.textContent = first ? first : 'An error occurred (click to view details)';
                                        brief.style.display = 'block';
                                    }
                                }
                            } catch (e) { }
                        }
                    });
                });
                observer.observe(ui, { attributes: true });
            }
        } catch (err) {
            console.error(err);
        }
    })();
</script>

@code {
    private ErrorBoundary? mainErrorBoundary;
    private bool currentIsHomePage = false;
    private bool isDark = false;
    private bool drawerOpen = false;

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UpdateIsHomePage();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void DrawerToggle()
    {
        drawerOpen = !drawerOpen;
    }

    private void ToggleTheme()
    {
        isDark = !isDark;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateIsHomePage();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateIsHomePage()
    {
        var uri = new Uri(Navigation.Uri);
        currentIsHomePage = uri.AbsolutePath == "/";
    }

    private void RecoverMain()
    {
        mainErrorBoundary?.Recover();
    }

    private async Task TestPlay(MouseEventArgs e)
    {
        const string testUsername = "testplayer";
        const string testPassword = "test123";

        try
        {
            // Ensure test user exists
            var userService = new Services.UserService();
            var existingUser = userService.GetByUsername(testUsername);
            if (existingUser == null)
            {
                userService.Register(testUsername, testPassword, Models.Job.Warrior);
            }

            // Call signin API via JavaScript (use relative path without leading '/' to avoid double-slash)
            var url = Navigation.ToAbsoluteUri("signin").ToString();
            var payload = new { Username = testUsername, Password = testPassword };
            var ok = await JS.InvokeAsync<bool>("fetchSignIn", url, payload);
            if (ok)
            {
                // Navigate to status with force reload to apply auth state
                Navigation.NavigateTo("/status", true);
            }
            else
            {
                Console.WriteLine("テストプレイのサインインに失敗しました。");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"TestPlay error: {ex.Message}");
        }
    }

    private async Task SignOut(MouseEventArgs e)
    {
        try
        {
            await JS.InvokeAsync<bool>("fetchSignOut", Navigation.ToAbsoluteUri("/signout").ToString());
        }
        catch { }
        // Always force full browser reload to clear SignalR circuit and auth state
        Navigation.NavigateTo("/signout", true);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
