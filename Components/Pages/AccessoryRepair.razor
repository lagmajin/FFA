@page "/accessory-repair/{accessoryId:int}"
@rendermode InteractiveServer

@using FFA.Models
@using FFA.Services
@inject UserService UserService
@inject AccessoryService AccessoryService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider

<h1>装飾品修理</h1>

@if (!isAuth)
{
    <p>ログインしてください。</p>
}
else
{
    @if (accessory != null)
    {
        <div class="accessory-repair-container">
            <h2>@accessory.Name</h2>
            <div class="accessory-info">
                <div>タイプ: @accessory.Type</div>
                <div>現在の耐久度: @accessory.CurrentDurability / @accessory.Durability</div>
                <div>修理費用: @accessory.RepairCost ギル</div>
                <div>修理で回復: @accessory.RepairAmount 耐久度</div>
                <div>あなたの所持金: @(user?.Gil ?? 0) ギル</div>
            </div>

            @if (repairResult != null)
            {
                <div class="repair-result @repairResult.Success.ToString().ToLower()">
                    <h3>修理結果</h3>
                    <p>@repairResult.Message</p>
                </div>
            }

            @if (accessory.CurrentDurability < accessory.Durability)
            {
                <button class="action-button" @onclick="RepairAccessory">修理する</button>
            }
            else
            {
                <p>耐久度は満点です</p>
            }
            <button class="action-button" @onclick="NavigateBack">戻る</button>
        </div>
    }
    else
    {
        <p>装飾品が見つかりません。</p>
    }
}

@code {
    [Parameter]
    public int accessoryId { get; set; }

    private bool isAuth = false;
    private string? username;
    private User? user;
    private Accessory? accessory;
    private AccessoryRepairResult? repairResult;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authUser = state.User;
        isAuth = authUser?.Identity?.IsAuthenticated ?? false;
        username = authUser?.Identity?.Name;

        if (isAuth && !string.IsNullOrEmpty(username))
        {
            user = UserService.GetByUsername(username);
            accessory = AccessoryService.GetByOwner(username).FirstOrDefault(a => a.Id == accessoryId);
        }
    }

    private async Task RepairAccessory()
    {
        if (accessory == null || username == null) return;

        repairResult = (AccessoryRepairResult)AccessoryService.RepairAccessory(username, accessory.Id);
        user = UserService.GetByUsername(username);
        accessory = AccessoryService.GetByOwner(username).FirstOrDefault(a => a.Id == accessoryId);
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/accessory-management");
    }
}
