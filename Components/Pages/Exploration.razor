</style>

@code {
    private User? currentUser;
    private List<Models.Dungeon> dungeons = new();
    private string selectedType = "Exploration";
    
    // 探索中 state
    private bool isExploring = false;
    private Models.Dungeon? currentDungeon;
    private ExplorationSession? currentSession;
    private Enemy? currentEnemy;
    private List<BattleLogEntry> battleLog = new();
    private ExplorationBattleState battleState = ExplorationBattleState.Idle;
    private bool isPlayerTurn = true;
    
    private int lastExp = 0;
    private int lastGil = 0;
    private string lastDrop = "";
    private string dungeonResultMessage = "";
    private bool IsFloorClear => currentSession?.MonstersDefeated >= (currentSession?.TotalMonsters ?? 0);

    private int enemyHpPercent => currentEnemy != null ? (currentEnemy.HP * 100 / currentEnemy.MaxHP) : 0;
    private int playerHpPercent => currentUser != null ? (currentUser.HP * 100 / currentUser.MaxHP) : 100;
    private int progressPercent => currentDungeon != null && currentSession != null 
        ? ((currentSession.CurrentFloor - 1) * 100 + (currentSession.MonstersDefeated * 100 / currentSession.TotalMonsters)) / currentDungeon.MaxFloors 
        : 0;

    protected override void OnInitialized()
    {
        LoadDungeons();
        var users = UserService.GetAllUsers().ToList();
        currentUser = users.FirstOrDefault();
    }

    private void LoadDungeons()
    {
        // 固定ダンジョンリスト（JSONから読み込む予定）
        dungeons = new List<Models.Dungeon>
        {
            new Models.Dungeon 
            { 
                Id = 1, Name = "Slime Cave", JapaneseName = "スライム洞窟", 
                Type = DungeonType.Exploration, Description = "初心者のためのコラーな洞窟",
                RecommendedLevel = 1, MaxFloors = 3, MonsterCountPerFloor = 3,
                FloorClearBonusGil = 50, FloorClearBonusExp = 30,
                DungeonClearBonusGil = 200, DungeonClearBonusExp = 100,
                MonsterTypes = new List<string> { "Slime", "Bat", "Spider" }
            },
            new Models.Dungeon 
            { 
                Id = 2, Name = "Goblin Fortress", JapaneseName = "ゴブリン城塞", 
                Type = DungeonType.Exploration, Description = "ゴブリンが占領した古い城塞",
                RecommendedLevel = 5, MaxFloors = 5, MonsterCountPerFloor = 4,
                FloorClearBonusGil = 100, FloorClearBonusExp = 60,
                DungeonClearBonusGil = 500, DungeonClearBonusExp = 300,
                MonsterTypes = new List<string> { "Goblin", "Orc", "Wolf", "Skeleton" }
            },
            new Models.Dungeon 
            { 
                Id = 3, Name = "Ancient Ruins", JapaneseName = "古代遗迹", 
                Type = DungeonType.Exploration, Description = "ミステリアスな古代神殿の遗迹",
                RecommendedLevel = 10, MaxFloors = 7, MonsterCountPerFloor = 5,
                FloorClearBonusGil = 200, FloorClearBonusExp = 100,
                DungeonClearBonusGil = 1000, DungeonClearBonusExp = 500,
                MonsterTypes = new List<string> { "Skeleton", "Ghost", "Mummy", "Golem" }
            },
            new Models.Dungeon 
            { 
                Id = 4, Name = "Dragon's Lair", JapaneseName = "竜の巢", 
                Type = DungeonType.Exploration, Description = "恐るべき竜が待つ最深部のダンジョン",
                RecommendedLevel = 20, MaxFloors = 10, MonsterCountPerFloor = 6,
                FloorClearBonusGil = 500, FloorClearBonusExp = 250,
                DungeonClearBonusGil = 3000, DungeonClearBonusExp = 1500,
                MonsterTypes = new List<string> { "Dragon", "Drake", "Wyvern", "Hydra" }
            },
            // クイックバトル
            new Models.Dungeon 
            { 
                Id = 101, Name = "Training Grounds", JapaneseName = "訓練場", 
                Type = DungeonType.QuickBattle, Description = "腕を試すためのシンプルな闘技場",
                RecommendedLevel = 1, MaxFloors = 1, MonsterCountPerFloor = 1,
                FloorClearBonusGil = 20, FloorClearBonusExp = 10,
                DungeonClearBonusGil = 20, DungeonClearBonusExp = 10,
                MonsterTypes = new List<string> { "Slime", "Bat" }
            },
            new Models.Dungeon 
            { 
                Id = 102, Name = "Quick Quest", JapaneseName = "即時クエスト", 
                Type = DungeonType.QuickBattle, Description = "サクっと戦闘して経験を積みよう",
                RecommendedLevel = 3, MaxFloors = 1, MonsterCountPerFloor = 1,
                FloorClearBonusGil = 30, FloorClearBonusExp = 15,
                DungeonClearBonusGil = 30, DungeonClearBonusExp = 15,
                MonsterTypes = new List<string> { "Goblin", "Wolf", "Skeleton" }
            },
            new Models.Dungeon 
            { 
                Id = 103, Name = "Boss Rush", JapaneseName = "ボスラッシュ", 
                Type = DungeonType.QuickBattle, Description = "強力なボスとの出会い",
                RecommendedLevel = 10, MaxFloors = 1, MonsterCountPerFloor = 1,
                FloorClearBonusGil = 200, FloorClearBonusExp = 100,
                DungeonClearBonusGil = 200, DungeonClearBonusExp = 100,
                MonsterTypes = new List<string> { "Orc Chief", "Dragon", "Lich" }
            }
        };
    }

    private List<Models.Dungeon> GetFilteredDungeons()
    {
        var type = selectedType == "Exploration" ? DungeonType.Exploration : DungeonType.QuickBattle;
        return dungeons.Where(d => d.Type == type).ToList();
    }

    private void SelectType(string type)
    {
        selectedType = type;
    }

    private void StartDungeon(Models.Dungeon dungeon)
    {
        if (currentUser == null) return;
        
        currentDungeon = dungeon;
        isExploring = true;
        battleState = ExplorationBattleState.Idle;
        
        // セッション初期化
        currentSession = new ExplorationSession
        {
            Username = currentUser.Username,
            DungeonId = dungeon.Id,
            DungeonName = dungeon.Name,
            CurrentFloor = 1,
            MonstersDefeated = 0,
            TotalMonsters = dungeon.MonsterCountPerFloor,
            TotalGil = 0,
            TotalExp = 0,
            Drops = new List<string>(),
            IsActive = true,
            StartTime = DateTime.UtcNow
        };
        
        battleLog.Clear();
        AddLog("system", $"🎮 {dungeon.JapaneseName}を開始した！");
        
        // 最初の敵を出现
        SpawnEnemy();
    }

    private void SpawnEnemy()
    {
        if (currentDungeon == null || currentUser == null) return;
        
        var playerLevel = currentUser.Exp / 100 + 1;
        currentEnemy = DungeonService.GenerateRandomEnemy(playerLevel);
        
        // ダンジョンの-monsterTypesから选择
        if (currentDungeon.MonsterTypes.Count > 0)
        {
            var monsterName = currentDungeon.MonsterTypes[new Random().Next(currentDungeon.MonsterTypes.Count)];
            currentEnemy.Name = monsterName;
        }
        
        // フロア数に基づいて敵强化
        var floorMultiplier = 1.0 + (currentSession!.CurrentFloor - 1) * 0.2;
        currentEnemy.HP = (int)(currentEnemy.HP * floorMultiplier);
        currentEnemy.MaxHP = currentEnemy.HP;
        currentEnemy.Attack = (int)(currentEnemy.Attack * floorMultiplier);
        currentEnemy.Defense = (int)(currentEnemy.Defense * floorMultiplier);
        currentEnemy.Exp = (int)(currentEnemy.Exp * floorMultiplier);
        currentEnemy.Gil = (int)(currentEnemy.Gil * floorMultiplier);
        
        battleState = ExplorationBattleState.Battling;
        isPlayerTurn = true;
        
        AddLog("system", $"👾 {currentEnemy.Name}が出现了！ (Floor {currentSession.CurrentFloor})");
    }

    private async Task PlayerAttack()
    {
        if (currentUser == null || currentEnemy == null || currentSession == null) return;
        
        isPlayerTurn = false;
        
        var result = DungeonService.PlayerAttack(currentUser, currentEnemy, new DungeonService.BattleSession());
        
        AddLog("player", result.Message);
        
        if (result.BattleEnded && result.PlayerWon)
        {
            await HandleVictory();
        }
        else
        {
            await Task.Delay(500);
            await EnemyTurn();
        }
    }

    private async Task PlayerDefend()
    {
        if (currentUser == null || currentEnemy == null) return;
        
        isPlayerTurn = false;
        
        var session = new DungeonService.BattleSession { IsDefending = true };
        var result = DungeonService.PlayerDefend(currentUser, currentEnemy, session);
        
        AddLog("player", result.Message);
        
        await Task.Delay(500);
        await EnemyTurn();
    }

    private async Task PlayerFlee()
    {
        if (currentUser == null || currentEnemy == null || currentSession == null) return;
        
        isPlayerTurn = false;
        
        var session = new DungeonService.BattleSession();
        var result = DungeonService.PlayerFlee(currentUser, currentEnemy, session);
        
        AddLog("player", result.Message);
        
        if (result.Success)
        {
            // 逃走成功 - ダンジョン終了
            await EndDungeon(false);
        }
        else
        {
            await Task.Delay(500);
            await EnemyTurn();
        }
    }

    private async Task EnemyTurn()
    {
        if (currentUser == null || currentEnemy == null) return;
        
        var session = new DungeonService.BattleSession { IsDefending = false };
        var result = DungeonService.EnemyAttack(currentUser, currentEnemy, session);
        
        AddLog("enemy", result.Message);
        
        if (result.BattleEnded && !result.PlayerWon)
        {
            await HandleDefeat();
        }
        else
        {
            isPlayerTurn = true;
        }
    }

    private async Task HandleVictory()
    {
        if (currentUser == null || currentEnemy == null || currentSession == null || currentDungeon == null) return;
        
        // 報酬计算
        lastExp = currentEnemy.Exp;
        lastGil = currentEnemy.Gil;
        
        // ドロップ判定
        var drop = DungeonService.RollDrop(currentEnemy);
        if (!string.IsNullOrEmpty(drop))
        {
            lastDrop = drop;
            currentSession.Drops.Add(drop);
            AddLog("system", $"★ ドロップ: {drop}");
        }
        
        // セッション更新
        currentSession.MonstersDefeated++;
        currentSession.TotalExp += lastExp;
        currentSession.TotalGil += lastGil;
        
        currentUser.Exp += lastExp;
        currentUser.Gil += lastGil;
        
        // クエスト進捗更新
        QuestService.UpdateProgress(currentUser, enemyName: currentEnemy.Name);
        
        AddLog("system", $"🎉 {currentEnemy.Name}を倒した！ +{lastExp}Exp, +{lastGil}Gil");
        
        battleState = ExplorationBattleState.Victory;
        
        UserService.UpdateUser(currentUser);
    }

    private async Task ContinueExploration()
    {
        if (currentDungeon == null || currentSession == null || currentUser == null) return;
        
        // フロアクリアチェック
        if (currentSession.MonstersDefeated >= currentSession.TotalMonsters)
        {
            if (currentSession.CurrentFloor >= currentDungeon.MaxFloors)
            {
                // ダンジョンクリア
                await EndDungeon(true);
                return;
            }
            else
            {
                // 次のフロア
                currentSession.CurrentFloor++;
                currentSession.MonstersDefeated = 0;
                currentSession.TotalMonsters = currentDungeon.MonsterCountPerFloor;
                
                // フロアクリアボーナス
                currentSession.TotalExp += currentDungeon.FloorClearBonusExp;
                currentSession.TotalGil += currentDungeon.FloorClearBonusGil;
                currentUser.Exp += currentDungeon.FloorClearBonusExp;
                currentUser.Gil += currentDungeon.FloorClearBonusGil;
                
                AddLog("system", $"🏰 フロア {currentSession.CurrentFloor - 1} クリア！ bonus: +{currentDungeon.FloorClearBonusExp}Exp, +{currentDungeon.FloorClearBonusGil}Gil");
                
                UserService.UpdateUser(currentUser);
            }
        }
        
        battleState = ExplorationBattleState.Idle;
        SpawnEnemy();
    }

    private async Task HandleDefeat()
    {
        if (currentUser == null || currentSession == null) return;
        
        battleState = ExplorationBattleState.Defeat;
        
        // 経験値損失
        var expLoss = 10 + (currentUser.Exp / 20);
        currentUser.Exp = Math.Max(0, currentUser.Exp - expLoss);
        
        // ギル損失
        var gilLoss = Math.Max(100, currentUser.Gil / 20);
        currentUser.Gil = Math.Max(0, currentUser.Gil - gilLoss);
        
        // HPを1に
        currentUser.HP = 1;
        
        dungeonResultMessage = $"経験値 -{expLoss}, ギル -{gilLoss} を失った...";
        
        AddLog("system", $"💀 倒れた... {dungeonResultMessage}");
        
        UserService.UpdateUser(currentUser);
    }

    private async Task EndDungeon(bool isClear)
    {
        if (currentUser == null || currentSession == null || currentDungeon == null) return;
        
        if (isClear)
        {
            // ダンジョンクリアボーナス
            currentSession.TotalExp += currentDungeon.DungeonClearBonusExp;
            currentSession.TotalGil += currentDungeon.DungeonClearBonusGil;
            currentUser.Exp += currentDungeon.DungeonClearBonusExp;
            currentUser.Gil += currentDungeon.DungeonClearBonusGil;
            
            AddLog("system", $"🏆 ダンジョンクリア！ bonus: +{currentDungeon.DungeonClearBonusExp}Exp, +{currentDungeon.DungeonClearBonusGil}Gil");
            
            battleState = ExplorationBattleState.DungeonClear;
        }
        
        currentSession.IsActive = false;
        currentSession.EndTime = DateTime.UtcNow;
        
        UserService.UpdateUser(currentUser);
    }

    private void ReturnToSelect()
    {
        isExploring = false;
        currentDungeon = null;
        currentSession = null;
        currentEnemy = null;
        battleLog.Clear();
        battleState = ExplorationBattleState.Idle;
    }

    private void AddLog(string className, string message)
    {
        battleLog.Add(new BattleLogEntry { Class = className, Message = message });
        if (battleLog.Count > 30)
        {
            battleLog.RemoveAt(0);
        }
    }

    enum ExplorationBattleState
    {
        Idle,
        Battling,
        Victory,
        Defeat,
        DungeonClear
    }

    class BattleLogEntry
    {
        public string Class { get; set; } = "";
        public string Message { get; set; } = "";
    }
}
