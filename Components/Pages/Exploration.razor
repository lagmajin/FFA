        text-align: center;
        margin: 20px 0;
    }

    .hp-bar {
        height: 20px;
        background: #e0e0e0;
        border-radius: 10px;
        overflow: hidden;
        margin: 10px auto;
        max-width: 300px;
    }

    .hp-fill {
        height: 100%;
        background: #f44336;
