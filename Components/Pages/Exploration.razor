@page "/exploration"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject Services.UserService UserService
@inject Services.DungeonService DungeonService
@inject Services.QuestService QuestService
@inject IJSRuntime JS

<PageTitle>探索ダンジョン</PageTitle>

<div class="exploration-container">
    <h1 class="page-title">🗺️ 探索ダンジョン</h1>

    @if (!isExploring)
    {
        <!-- ダンジョン選択画面 -->
        <div class="dungeon-select-section">
            <h2>ダンジョンを選択</h2>
            
            <div class="dungeon-type-tabs">
                <button class="tab-btn @(selectedType == "Exploration" ? "active" : "")" 
                        @onclick='() => SelectType("Exploration")'>
                    🏰 探索型
                </button>
                <button class="tab-btn @(selectedType == "QuickBattle" ? "active" : "")" 
                        @onclick='() => SelectType("QuickBattle")'>
                    ⚔️ 戦闘型
                </button>
            </div>

            <div class="dungeon-grid">
                @foreach (var dungeon in GetFilteredDungeons())
                {
                    <div class="dungeon-card @(currentUser != null && currentUser.Level >= dungeon.RecommendedLevel ? "" : "locked")">
                        <div class="dungeon-icon">
                            @if (dungeon.Type == DungeonType.Exploration)
                            { <text>🏰</text> }
                            else
                            { <text>⚔️</text> }
                        </div>
                        <div class="dungeon-name japanese-text">@dungeon.JapaneseName</div>
                        <div class="dungeon-info">
                            <p>推奨Lv: @dungeon.RecommendedLevel</p>
                            @if (dungeon.Type == DungeonType.Exploration)
                            {
                                <p>フロア: @dungeon.MaxFloors</p>
                            }
                        </div>
                        <p class="dungeon-desc japanese-text">@dungeon.Description</p>
                        <button class="enter-btn" 
                                disabled="@(currentUser != null && currentUser.Level < dungeon.RecommendedLevel)"
                                @onclick="() => StartDungeon(dungeon)">
                            入る
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- 探索中画面 -->
        <div class="exploration-status">
            <div class="floor-indicator">
                <h2>🏰 @currentDungeon?.JapaneseName - @currentSession?.CurrentFloor/F @currentDungeon?.MaxFloors フロア</h2>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @progressPercent%"></div>
                </div>
                <p>戦闘進行: @currentSession?.MonstersDefeated / @currentSession?.TotalMonsters</p>
            </div>
        </div>

        @if (currentEnemy != null)
        {
            <div class="battle-section">
                <div class="enemy-display">
                    <h3>👾 @currentEnemy.Name</h3>
                    <div class="hp-bar">
                        <div class="hp-fill" style="width: @enemyHpPercent%"></div>
                    </div>
                    <p>HP: @currentEnemy.HP / @currentEnemy.MaxHP</p>
                    <p>ATK: @currentEnemy.Attack | DEF: @currentEnemy.Defense</p>
                </div>

                <div class="player-display">
                    <h3>⚔️ @currentUser?.Username</h3>
                    <div class="hp-bar player-hp">
                        <div class="hp-fill" style="width: @playerHpPercent%"></div>
                    </div>
                    <p>HP: @currentUser?.HP / @currentUser?.MaxHP</p>
                </div>

                @if (!isPlayerTurn)
                {
                    <div class="waiting-message">相手のターン...</div>
                }
            </div>

            <div class="action-buttons">
                <button class="action-btn attack" @onclick="PlayerAttack" disabled="@(!isPlayerTurn)">
                    ⚔️ 攻撃
                </button>
                <button class="action-btn defend" @onclick="PlayerDefend" disabled="@(!isPlayerTurn)">
                    🛡️ 防御
                </button>
                <button class="action-btn flee" @onclick="PlayerFlee" disabled="@(!isPlayerTurn)">
                    🏃 逃げる
                </button>
            </div>
        }

        <div class="battle-log">
            @foreach (var log in battleLog)
            {
                <p class="@log.Class">@log.Message</p>
            }
        </div>

        @if (battleState == ExplorationBattleState.Victory)
        {
            <div class="result-modal victory">
                <h2>🎉 戦闘勝利！</h2>
                <p>経験値: +@lastExp</p>
                <p>ギル: +@lastGil</p>
                @if (!string.IsNullOrEmpty(lastDrop))
                {
                    <p class="drop">ドロップ: @lastDrop</p>
                }
                <button class="continue-btn" @onclick="ContinueExploration">
                    @(IsFloorClear ? "次のフロアへ →" : "次の敵へ →")
                </button>
            </div>
        }

        @if (battleState == ExplorationBattleState.Defeat)
        {
            <div class="result-modal defeat">
                <h2>💀 敗北...</h2>
                <p>@dungeonResultMessage</p>
                <div class="rewards-summary">
                    <h3>本次探索の成果</h3>
                    <p>獲得経験値: @currentSession?.TotalExp</p>
                    <p>獲得ギル: @currentSession?.TotalGil</p>
                    @if (currentSession?.Drops.Count > 0)
                    {
                        <p>ドロップ: @string.Join(", ", currentSession.Drops)</p>
                    }
                </div>
                <button class="return-btn" @onclick="ReturnToSelect">街に戻る</button>
            </div>
        }

        @if (battleState == ExplorationBattleState.DungeonClear)
        {
            <div class="result-modal dungeon-clear">
                <h2>🏆 ダンジョンクリア！</h2>
                <div class="clear-bonus">
                    <p>フロアクリア bonus: +@currentDungeon?.FloorClearBonusExp Exp, +@currentDungeon?.FloorClearBonusGil Gil</p>
                    <p class="big">ダンジョンクリア bonus: +@currentDungeon?.DungeonClearBonusExp Exp, +@currentDungeon?.DungeonClearBonusGil Gil</p>
                </div>
                <button class="return-btn" @onclick="ReturnToSelect">街に戻る</button>
            </div>
        }
    }
</div>

<style>
    .exploration-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
    }

    .page-title {
        text-align: center;
        color: #4a4a4a;
        margin-bottom: 30px;
    }

    .dungeon-type-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        justify-content: center;
    }

    .tab-btn {
        padding: 10px 30px;
        border: 2px solid #ddd;
        background: #f5f5f5;
        cursor: pointer;
        border-radius: 5px;
