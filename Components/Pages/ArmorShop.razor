@page "/armor-shop"
@rendermode InteractiveServer

@using FFA.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject Services.UserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<h1>防具屋</h1>

@if (!isAuth)
{
    <p>ログインしてください。</p>
}
else
{
    <div class="shop-container">
        <div class="shop-header">
            <p>手持: <strong>@currentUser?.Gil ギル</strong></p>
        </div>
        
        <h2>購入可能な防具</h2>
        <div class="shop-list">
            @foreach (var a in armors)
            {
                <div class="shop-item">
                    <div class="shop-item-name">@a.Name</div>
                    <div>防御: @a.Defense</div>
                    <div>価格: @a.Price ギル</div>
                    <button class="action-button" @onclick="() => BuyArmor(a)">購入 / 装備</button>
                </div>
            }
        </div>

        <h2>アイテムを売却</h2>
        <div class="sell-section">
            @if (currentUser?.Inventory != null && currentUser.Inventory.Any())
            {
                <div class="inventory-list">
                    @foreach (var item in currentUser.Inventory)
                    {
                        <div class="inventory-item">
                            <span>@item.Name x @item.Quantity</span>
                            <span>売却価格: @(item.Price / 2) ギル</span>
                            <button class="sell-button" @onclick="() => SellItem(item)">売却</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>インベントリに売却可能なアイテムがありません。</p>
            }
        </div>
    </div>
}

@code {
    private bool isAuth = false;
    private string? username;
    private User? currentUser;

    private record ArmorForSale(string Name, int Defense, int Price);

    private List<ArmorForSale> armors = new()
    {
        new ArmorForSale("革の铠", 5, 300),
        new ArmorForSale("锁かたびら", 10, 800),
        new ArmorForSale("钢のよろい", 18, 2000),
        new ArmorForSale("プレートアーマー", 25, 5000),
    };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        isAuth = user?.Identity?.IsAuthenticated ?? false;
        username = user?.Identity?.Name;
        
        if (!string.IsNullOrEmpty(username))
        {
            currentUser = UserService.GetByUsername(username);
        }
    }

    private void BuyArmor(ArmorForSale a)
    {
        if (!isAuth || string.IsNullOrEmpty(username) || currentUser == null) return;
        
        if (currentUser.Gil < a.Price)
        {
            return;
        }
        currentUser.Gil -= a.Price;
        currentUser.EquippedArmor = new Armor { Name = a.Name, Defense = a.Defense };
        UserService.UpdateUser(currentUser);
        StateHasChanged();
    }

    private void SellItem(InventoryItem item)
    {
        if (!isAuth || string.IsNullOrEmpty(username) || currentUser == null) return;
        
        var sellPrice = UserService.SellItem(username, item.Name, 1);
        if (sellPrice > 0)
        {
            // Refresh user data
            currentUser = UserService.GetByUsername(username);
            StateHasChanged();
        }
    }
}
