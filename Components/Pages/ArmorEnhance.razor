@page "/armor-enhance/{armorId:int}"
@rendermode InteractiveServer

@using FFA.Models
@using FFA.Services
@inject UserService UserService
@inject ArmorService ArmorService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider

<h1>防具強化</h1>

@if (!isAuth)
{
    <p>ログインしてください。</p>
}
else
{
    @if (armor != null)
    {
        <div class="armor-enhance-container">
            <h2>@armor.Name</h2>
            <div class="armor-info">
                <div>タイプ: @GetArmorTypeName(armor.Type)</div>
                <div>防御: @armor.Defense</div>
                <div>現在の強化レベル: @armor.EnhancementLevel / @armor.MaxEnhancementLevel</div>
                <div>強化成功率: @(armor.EnhancementSuccessRate * 100)%</div>
                @if (armor.IsEnhancementSafe)
                {
                    <div>安全強化: はい</div>
                }
                <div>強化費用: @armor.EnhancementCost ギル</div>
                    <div>あなたの所持金: @(user?.Gil ?? 0) ギル</div>
            </div>

            @if (enhancementResult != null)
            {
                <div class="enhancement-result @enhancementResult.Success.ToString().ToLower()">
                    <h3>強化結果</h3>
                    <p>@enhancementResult.Message</p>
                    @if (enhancementResult.Success)
                    {
                        <div>新しい防御力: @(enhancementResult?.NewDefense ?? 0)</div>
                        <div>新しい強化レベル: @(enhancementResult?.NewLevel ?? 0)</div>
                    }
                </div>
            }

            <button class="action-button" @onclick="EnhanceArmor">強化する</button>
            <button class="action-button" @onclick="NavigateBack">戻る</button>
        </div>
    }
    else
    {
        <p>防具が見つかりません。</p>
    }
}

@code {
    [Parameter]
    public int armorId { get; set; }

    private bool isAuth = false;
    private string? username;
    private User? user;
    private Armor? armor;
    private EnhancementResult? enhancementResult;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authUser = state.User;
        isAuth = authUser?.Identity?.IsAuthenticated ?? false;
        username = authUser?.Identity?.Name;

        if (isAuth && !string.IsNullOrEmpty(username))
        {
            user = UserService.GetByUsername(username);
            armor = ArmorService.GetArmorsByUser(username).FirstOrDefault(a => a.Id == armorId);
        }
    }

    private string GetArmorTypeName(string typeStr)
    {
        if (Enum.TryParse<ArmorType>(typeStr, out var type))
        {
            return type switch
            {
                ArmorType.Light => "軽装",
                ArmorType.Medium => "中装",
                ArmorType.Heavy => "重装",
                ArmorType.Robe => "ローブ",
                _ => "その他"
            };
        }
        return "その他";
    }

    private async Task EnhanceArmor()
    {
        if (armor == null || user == null) return;

        enhancementResult = ArmorService.EnhanceArmor(username!, armor.Id);
        user = UserService.GetByUsername(username!);
        armor = ArmorService.GetArmorsByUser(username!).FirstOrDefault(a => a.Id == armorId);
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/armor-management");
    }
}