@page "/weapon-enhance/{weaponId:int}"
@rendermode InteractiveServer

@using FFA.Models
@using FFA.Services
@inject UserService UserService
@inject WeaponService WeaponService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider

<h1>武器強化</h1>

@if (!isAuth)
{
    <p>ログインしてください。</p>
}
else
{
    @if (weapon != null)
    {
        <div class="weapon-enhance-container">
            <h2>@weapon.Name</h2>
            <div class="weapon-info">
                <div>タイプ: @GetWeaponTypeName(weapon.Type)</div>
                <div>攻撃力: @weapon.Attack</div>
                <div>レアリティ: @GetRarityName(weapon.Rarity)</div>
                <div class="enhancement-level">
                    強化レベル: <span class="level">+@weapon.EnhancementLevel</span> / @weapon.MaxEnhancementLevel
                </div>
                
                <!-- 計算後の強化費用と成功率 -->
                <div class="enhancement-params">
                    <div class="param-item">
                        <span class="label">強化費用:</span>
                        <span class="value cost">@calculatedCost ギル</span>
                    </div>
                    <div class="param-item">
                        <span class="label">成功率:</span>
                        <span class="value rate">@(calculatedSuccessRate * 100)%</span>
                    </div>
                </div>
                
                @if (weapon.IsEnhancementSafe)
                {
                    <div class="safe-badge">🛡️ 安全強化: 有効 (100%)</div>
                }
                
                <div>あなたの所持金: @(user?.Gil ?? 0) ギル</div>
            </div>

            @if (enhancementResult != null)
            {
                <div class="enhancement-result @enhancementResult.Success.ToString().ToLower()">
                    <h3>強化結果</h3>
                    <p>@enhancementResult.Message</p>
                    @if (enhancementResult.Success)
                    {
                        <div>新しい攻撃力: @(enhancementResult?.NewAttack ?? 0)</div>
                        <div>新しい強化レベル: +@(enhancementResult?.NewLevel ?? 0)</div>
                    }
                </div>
            }

            <button class="action-button" @onclick="EnhanceWeapon">強化する</button>
            <button class="action-button" @onclick="NavigateBack">戻る</button>
        </div>
    }
    else
    {
        <p>武器が見つかりません。</p>
    }
}

@code {
    [Parameter]
    public int weaponId { get; set; }

    private bool isAuth = false;
    private string? username;
    private User? user;
    private Weapon? weapon;
    private EnhancementResult? enhancementResult;
    
    // 計算された強化費用と成功率
    private int calculatedCost = 0;
    private double calculatedSuccessRate = 0.8;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authUser = state.User;
        isAuth = authUser?.Identity?.IsAuthenticated ?? false;
        username = authUser?.Identity?.Name;

        if (isAuth && !string.IsNullOrEmpty(username))
        {
            user = UserService.GetByUsername(username);
            weapon = WeaponService.GetWeaponsByUser(username).FirstOrDefault(w => w.Id == weaponId);
            
            // 強化費用と成功率を計算
            if (weapon != null)
            {
                (calculatedCost, calculatedSuccessRate) = WeaponService.CalculateEnhancementParams(weapon);
            }
        }
    }

    private string GetWeaponTypeName(WeaponType type)
    {
        return type switch
        {
            WeaponType.Sword => "剣",
            WeaponType.Axe => "斧",
            WeaponType.Spear => "槍",
            WeaponType.Katana => "刀",
            WeaponType.Dagger => "短剣",
            WeaponType.Club => "棍棒",
            WeaponType.Bow => "弓",
            WeaponType.Staff => "杖",
            _ => "その他"
        };
    }
    
    private string GetRarityName(Rarity rarity)
    {
        return rarity switch
        {
            Rarity.White => "一般",
            Rarity.Purple => "高級",
            Rarity.Red => "稀有",
            Rarity.Orange => "伝説",
            Rarity.Gold => "神話",
            Rarity.Rainbow => "最上位",
            _ => "不明"
        };
    }

    private async Task EnhanceWeapon()
    {
        if (weapon == null || user == null) return;

        enhancementResult = WeaponService.EnhanceWeapon(username!, weapon.Id);
        user = UserService.GetByUsername(username!);
        weapon = WeaponService.GetWeaponsByUser(username!).FirstOrDefault(w => w.Id == weaponId);
        
        // 再度計算
        if (weapon != null)
        {
            (calculatedCost, calculatedSuccessRate) = WeaponService.CalculateEnhancementParams(weapon);
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/weapon-management");
    }
}