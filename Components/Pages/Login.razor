@page "/login"
@rendermode InteractiveServer

<PageTitle>ログイン</PageTitle>

@using System.ComponentModel.DataAnnotations
@using FFA.Services
@using FFA.Models
@using MudBlazor

@inject UserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div style="display:flex;align-items:center;justify-content:center;min-height:60vh;padding:24px;">
    <div style="width:360px;border-radius:8px;padding:20px;background:var(--mud-palette-surface);box-shadow:0 6px 18px rgba(0,0,0,0.08);">
        <h2 style="text-align:center;margin-top:0;margin-bottom:12px;">ログイン</h2>

        @if (loginSuccess)
        {
            <p style="text-align:center">ログイン成功！ リダイレクト中...</p>
        }
        else
        {
            <EditForm Model="loginModel" OnValidSubmit="HandleValidSubmit" FormName="login">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color: red;">@errorMessage</p>
        }

        <div>
            <label for="username">ユーザー名:</label>
            <InputText id="username" @bind-Value="loginModel.Username" />
        </div>

        <div>
            <label for="password">パスワード:</label>
            <InputText id="password" type="password" @bind-Value="loginModel.Password" />
        </div>

                <div style="display:flex; justify-content:center; margin-top:12px;">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" Class="login-button">
                        ログイン
                    </MudButton>
                </div>
            </EditForm>
        }
    </div>
</div>


@code {
    private LoginModel loginModel = new();
    private bool loginSuccess = false;
    private string errorMessage = "";

    private async Task HandleValidSubmit()
    {
        var user = UserService.Login(loginModel.Username, loginModel.Password);
        if (user != null)
        {
            loginSuccess = true;
            // ログイン成功時の処理（セッションなど）
            await SignInUser(user);
            // include premium in redirect if needed
            Navigation.NavigateTo($"/dashboard");
        }
        else
        {
            errorMessage = "ユーザー名またはパスワードが間違っています。";
        }
    }

    private async Task SignInUser(Models.User user)
    {
        // Post from the browser so the Set-Cookie sent by /signin is stored in the user's browser
        var payload = new { Username = user.Username, Password = loginModel.Password };
        var absoluteUri = Navigation.ToAbsoluteUri("/signin").ToString();
        var ok = await JS.InvokeAsync<bool>("fetchSignIn", absoluteUri, payload);
        if (!ok)
        {
            Console.WriteLine("Sign-in failed");
        }
    }

    public class LoginModel
    {
        [Required]
        public string Username { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}