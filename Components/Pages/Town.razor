@page "/town"
@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject Services.UserService UserService
@inject Services.CountryService CountryService
@inject Services.TownService TownService
@inject Services.TimeWeatherService TWService
@inject Services.FieldService FieldService

<PageTitle>街</PageTitle>

<div class="town-container">
    @* ヘッダーセクション *@
    <div class="town-header">
        <div class="town-main-info">
            <h1 class="town-title">@CurrentTown?.Name</h1>
            <p class="town-description">@CurrentTown?.Description</p>
        </div>
        <div class="town-time-weather">
            <div class="tw-display @TWService.Phase.ToString().ToLower()">
                <span class="tw-icon">@GetTimeIcon(TWService.Phase)</span>
                <span class="tw-time">@FormatTime(TWService.TimeOfDay)</span>
                <span class="tw-weather">@TWService.Weather</span>
            </div>
        </div>
    </div>
    
    @* 町の情報バー *@
    <div class="town-info-bar">
        <div class="town-type">
            <span class="type-badge @CurrentTown?.Type">@GetTownTypeName(CurrentTown?.Type)</span>
        </div>
        <div class="town-details">
            <span class="detail-item"><span class="label">人口</span> <span class="value">@CurrentTown?.Population.ToString("N0")</span></span>
            <span class="detail-item"><span class="label">繁栄度</span> <span class="value">@CurrentTown?.Prosperity/100</span></span>
            <span class="detail-item coordinate"><span class="label">座標</span> <span class="value">(@CurrentTown?.X, @CurrentTown?.Y)</span></span>
            @if (CurrentTown?.CountryName != null)
            {
                <span class="detail-item"><span class="label">所属国</span> <span class="value">@CurrentTown.CountryName</span></span>
            }
            @if (CurrentTown?.HasSpecialShop == true)
            {
                <span class="detail-item special-shop"><span class="label">特産</span> <span class="value">@CurrentTown.SpecialShopType</span></span>
            }
        </div>
    </div>

    @* プレイヤーステータス *@
    <div class="player-status-card">
        <div class="player-header">
            <h3>プレイヤー情報</h3>
            <span class="player-name">@currentUser?.Username</span>
        </div>
        <div class="player-stats">
            <div class="stat-row">
                <div class="stat">
                    <span class="stat-label">Lv.</span>
                    <span class="stat-value level">@currentUser?.Level</span>
                    <span class="stat-job">@GetJobName(currentUser?.Job)</span>
                </div>
                <div class="stat">
                    <span class="stat-label">💰</span>
                    <span class="stat-value gold">@currentUser?.Gil.ToString("N0")</span>
                </div>
                <div class="stat">
                    <span class="stat-label">💎</span>
                    <span class="stat-value premium">@currentUser?.Premium</span>
                </div>
            </div>
            <div class="stat-row hp-row">
                <div class="hp-bar">
                    <span class="hp-label">HP</span>
                    <div class="hp-track">
                        <div class="hp-fill" style="width: @GetHpPercent()%"></div>
                    </div>
                    <span class="hp-value">@currentUser?.HP / @currentUser?.MaxHP</span>
                </div>
            </div>
            <div class="stat-row exp-row">
                <div class="exp-bar">
                    <span class="exp-label">EXP</span>
                    <div class="exp-track">
                        <div class="exp-fill" style="width: @GetExpPercent()%"></div>
                    </div>
                    <span class="exp-value">@currentUser?.Exp / @currentUser?.ExpToNext</span>
                </div>
            </div>
        </div>
    </div>

    @if (CurrentTown != null)
    {
        <div class="town-content">
            @* 町の便利情報 *@
            <div class="frame convenience-section">
                <div class="frame-header">
                    <h3>@CurrentTown.Name の情報</h3>
                </div>
                <div class="frame-body">
                    <div class="convenience-grid">
                        @* 固定インフラ *@
                        <div class="convenience-item">
                            <span class="icon">🏨</span>
                            <span class="name">宿屋</span>
                            <span class="info">HP全回復</span>
                        </div>
                        <div class="convenience-item">
                            <span class="icon">🏦</span>
                            <span class="name">銀行</span>
                            <span class="info">@currentUser?.BankedGil.ToString("N0")G</span>
                        </div>
                        
                        @* 町の施設に基づいて表示 *@
                        @foreach (var facility in GetTownFacilitiesList(CurrentTown.Facilities))
                        {
                            <div class="convenience-item">
                                <span class="icon">@facility.Icon</span>
                                <span class="name">@facility.Name</span>
                                <span class="info">@facility.Info</span>
                            </div>
                        }
                        
                        @* 特殊商店があるなら表示 *@
                        @if (CurrentTown.HasSpecialShop)
                        {
                            <div class="convenience-item highlight">
                                <span class="icon">⭐</span>
                                <span class="name">特殊商店</span>
                                <span class="info">@CurrentTown.SpecialShopType</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="town-main-sections">
                @* 町の便利情報 *@
                <div class="frame fields-section">
                    <div class="frame-header">
                        <h3>🗺️ 周辺のフィールド (8方向)</h3>
                    </div>
                    <div class="frame-body">
                        <div class="directions-grid">
                            @foreach (var dir in GetSurroundingFields())
                            {
                                <div class="direction-card @(@dir.Field != null ? "active" : "inactive")" 
                                     @onclick="() => NavigateToDirection(dir)">
                                    <div class="direction-icon">@dir.Icon</div>
                                    <div class="direction-name">@dir.Name</div>
                                    @if (dir.Field != null)
                                    {
                                        <div class="direction-field">🌲 @dir.Field.Name</div>
                                    }
                                    else
                                    {
                                        <div class="direction-field empty">未探索</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="frame facilities-section">
                    <div class="frame-header">
                        <h3>施設</h3>
                    </div>
                    <div class="frame-body">
                        <div class="facilities-list">
                            @foreach (var facility in CurrentTown.Facilities)
                            {
                                <div class="facility-item">@facility</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="frame events-section">
                    <div class="frame-header">
                        <h3>イベント</h3>
                    </div>
                    <div class="frame-body">
                        <div class="events-list">
                            @foreach (var ev in CurrentTown.Events)
                            {
                                <div class="event-item">@ev</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="frame actions-section">
                <div class="frame-header">
                    <h3>アクション</h3>
                </div>
                <div class="frame-body">
                    <div class="town-actions">
                        @if (CurrentTown.HasSpecialShop)
                        {
                            <button class="action-button special" @onclick="GoToSpecialShop">
                                特殊商店 (@CurrentTown.SpecialShopType)
                            </button>
                        }
                        
                        <div class="shop-group">
                            <div class="group-title">商店</div>
                            <div class="basic-shops">
                                <button class="action-button" @onclick="GoToWeaponShop">武器屋</button>
                                <button class="action-button" @onclick="GoToArmorShop">防具屋</button>
                                <button class="action-button" @onclick="GoToAccessoryShop">装飾品屋</button>
                                <button class="action-button" @onclick="GoToConsumablesShop">消耗品屋</button>
                            </div>
                        </div>
                        
                        <div class="service-group">
                            <div class="group-title">サービス</div>
                            <div class="other-actions">
                                <button class="action-button" @onclick="GoToInn">宿屋</button>
                                <button class="action-button" @onclick="GoToBank">銀行</button>
                                <button class="action-button" @onclick="GoToTavern">酒場</button>
                            </div>
                        </div>
                        
                        <div class="management-group">
                            <div class="group-title">管理</div>
                            <div class="other-actions">
                                <button class="action-button" @onclick="GoToAccessoryManagement">装飾品管理</button>
                                <button class="action-button" @onclick="GoToWeaponManagement">武器管理</button>
                                <button class="action-button" @onclick="GoToArmorManagement">防具管理</button>
                            </div>
                        </div>
                        
                        <div class="skill-group">
                            <div class="group-title">スキル</div>
                            <div class="other-actions">
                                <button class="action-button" @onclick="GoToSkillTrees">スキルツリー</button>
                                <button class="action-button" @onclick="GoToAbilities">アビリティ</button>
                            </div>
                        </div>
                        
                        <div class="navigation-group">
                            <div class="group-title">移動</div>
                            <div class="other-actions">
                                <button class="action-button primary" @onclick="GoBack">ダッシュボード</button>
                                <button class="action-button" @onclick="GoToField">フィールド</button>
                                <button class="action-button" @onclick="GoToMap">マップ</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (OtherTowns.Count > 0)
    {
        <div class="frame other-towns-section">
            <div class="frame-header">
                <h3>他の街</h3>
            </div>
            <div class="frame-body">
                <div class="other-towns-list">
                    @foreach (var town in OtherTowns)
                    {
                        <div class="other-town-card" @onclick="() => GoToTown(town.Id)">
                            <h4>@town.Name</h4>
                            <p>@GetTownTypeName(town.Type)</p>
                            <p class="population">人口: @town.Population</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private User? currentUser;
    private Models.Country? currentCountry;
    private Models.Town? CurrentTown { get; set; }
    private List<Models.Town> OtherTowns { get; set; } = new List<Models.Town>();
    private List<SurroundingDirection> SurroundingFields { get; set; } = new List<SurroundingDirection>();

    // 8方向の構造体
    private class SurroundingDirection
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
        public int X { get; set; }
        public int Y { get; set; }
        public int? FieldId { get; set; }
        public Models.Field? Field { get; set; }
    }

    protected override void OnInitialized()
    {
        var users = UserService.GetAllUsers().ToList();
        currentUser = users.FirstOrDefault();
        
        if (currentUser?.CountryId != null)
        {
            currentCountry = CountryService.GetCountryById(currentUser.CountryId.Value);
            var towns = TownService.GetTownsByCountryId(currentUser.CountryId.Value);
            
            // デフォルトで首都を表示
            CurrentTown = towns.FirstOrDefault(t => t.Type == "capital") ?? towns.FirstOrDefault();
            
            // 他の街を取得
            OtherTowns = towns.Where(t => t.Id != CurrentTown?.Id).ToList();
        }
        else
        {
            // 国に所属していない場合は中立の都を表示
            var neutralCountry = CountryService.GetAllCountries().FirstOrDefault(c => c.Name == "中立之城");
            if (neutralCountry != null)
            {
                CurrentTown = neutralCountry.Towns.FirstOrDefault(t => t.Type == "capital");
                OtherTowns = neutralCountry.Towns.Where(t => t.Id != CurrentTown?.Id).ToList();
            }
        }
    }

    private string GetTownTypeName(string? type)
    {
        return type switch
        {
            "capital" => "首都",
            "village" => "田舎",
            "town" => "一般街",
            _ => "街"
        };
    }

    private string GetTimeIcon(FFA.Services.DayPhase phase)
    {
        return phase switch
        {
            FFA.Services.DayPhase.Dawn => "🌅",
            FFA.Services.DayPhase.Day => "☀️",
            FFA.Services.DayPhase.Dusk => "🌆",
            FFA.Services.DayPhase.Night => "🌙",
            _ => "🌤️"
        };
    }

    private string FormatTime(double t)
    {
        int hh = (int)Math.Floor(t);
        int mm = (int)Math.Floor((t - hh) * 60);
        return $"{hh:D2}:{mm:D2}";
    }

    private string GetJobName(Job? job)
    {
        return job switch
        {
            Job.Warrior => "戦士",
            Job.Monk => "武闘家",
            Job.WhiteMage => "白魔道士",
            Job.BlackMage => "黒魔道士",
            Job.Ranger => "レンジャー",
            Job.Paladin => "パラディン",
            Job.DarkKnight => "ダークナイト",
            Job.Bard => "吟遊詩人",
            Job.Thief => "盗賊",
            Job.Ninja => "忍者",
            Job.HolyKnight => "聖騎士",
            Job.DeathKnight => "死騎",
            Job.ArchMage => "大魔道師",
            Job.BeastMaster => "ビーストマスター",
            Job.Duelist => "剣豪",
            Job.Grandmaster => "マスター",
            _ => "初心者"
        };
    }

    private int GetHpPercent()
    {
        if (currentUser == null || currentUser.MaxHP == 0) return 0;
        return (int)((double)currentUser.HP / currentUser.MaxHP * 100);
    }

    private int GetExpPercent()
    {
        if (currentUser == null || currentUser.ExpToNext == 0) return 0;
        return (int)((double)currentUser.Exp / currentUser.ExpToNext * 100);
    }

    private List<TownFacilityInfo> GetTownFacilitiesList(List<string> facilities)
    {
        var result = new List<TownFacilityInfo>();
        
        foreach (var facility in facilities)
        {
            var info = facility.ToLower() switch
            {
                "鍛冶屋" or "鍛冶" or "武器屋" => new TownFacilityInfo { Icon = "⚒️", Name = "鍛冶屋", Info = "強化・修理" },
                "防具屋" => new TownFacilityInfo { Icon = "🛡️", Name = "防具屋", Info = "防具販売" },
                "装飾品屋" or "アクセサリー" => new TownFacilityInfo { Icon = "💍", Name = "装飾品屋", Info = "アクセサリー" },
                "消耗品屋" or "薬屋" => new TownFacilityInfo { Icon = "🧪", Name = "消耗品屋", Info = "薬・道具" },
                "釣り場" or "釣り" => new TownFacilityInfo { Icon = "🎣", Name = "釣り場", Info = "川・海" },
                "鉱山" or "採掘" => new TownFacilityInfo { Icon = "⛏️", Name = "鉱山", Info = "採掘" },
                "ダンジョン" => new TownFacilityInfo { Icon = "🏰", Name = "ダンジョン", Info = "探索" },
                "酒場" or " Tavern" => new TownFacilityInfo { Icon = "🍺", Name = "酒場", Info = "情報" },
                "神殿" or "教会" => new TownFacilityInfo { Icon = "⛪", Name = "神殿", Info = "回復・祈願" },
                "市場" => new TownFacilityInfo { Icon = "🏪", Name = "市場", Info = "交易" },
                "guild" or "ギルド" => new TownFacilityInfo { Icon = "🎖️", Name = "ギルド", Info = "共同活動" },
                _ => new TownFacilityInfo { Icon = "🏛️", Name = facility, Info = "施設" }
            };
            result.Add(info);
        }
        
        return result;
    }

    private class TownFacilityInfo
    {
        public string Icon { get; set; } = "";
        public string Name { get; set; } = "";
        public string Info { get; set; } = "";
    }

    // 8方向の名前とアイコン
    private static readonly (string Name, string Icon, int DX, int DY)[] Directions = new[]
    {
        ("北", "⬆️", 0, -1),
        ("北東", "↗️", 1, -1),
        ("東", "➡️", 1, 0),
        ("南東", "↘️", 1, 1),
        ("南", "⬇️", 0, 1),
        ("南西", "↙️", -1, 1),
        ("西", "⬅️", -1, 0),
        ("北西", "↖️", -1, -1)
    };

    // 8方向のフィールドを取得
    private List<SurroundingDirection> GetSurroundingFields()
    {
        var result = new List<SurroundingDirection>();
        
        if (CurrentTown == null) return result;
        
        // フィールドのマスターデータを取得
        var allFields = FieldService.GetAllFields();
        
        foreach (var (name, icon, dx, dy) in Directions)
        {
            var targetX = CurrentTown.X + dx;
            var targetY = CurrentTown.Y + dy;
            
            // その座標にあるフィールドを探す（名前やIDでマッピング）
            // ここでは簡易的にAvailableFieldsから取得
            var fieldId = GetFieldIdForDirection(targetX, targetY);
            
            result.Add(new SurroundingDirection
            {
                Name = name,
                Icon = icon,
                X = targetX,
                Y = targetY,
                FieldId = fieldId,
                Field = fieldId.HasValue ? FieldService.GetFieldById(fieldId.Value) : null
            });
        }
        
        return result;
    }

    // 座標からフィールドIDを取得する簡易マッピング
    private int? GetFieldIdForDirection(int x, int y)
    {
        // フィールドのマスターデータを使用して座標からフィールドIDへのマッピング
        // ここではAvailableFieldsを基準に返す
        if (CurrentTown?.AvailableFields == null || CurrentTown.AvailableFields.Count == 0)
            return null;
        
        // 北(0,-1)からは最初のフィールド、南(0,1)からは2番目のフィールド...
        // 簡易的なマッピング
        var fieldIndex = (x + 1) + (y + 1) * 3; // -1,-1=0, 0,-1=1, 1,-1=2, etc.
        fieldIndex = Math.Clamp(fieldIndex, 0, CurrentTown.AvailableFields.Count - 1);
        return CurrentTown.AvailableFields[fieldIndex];
    }

    private void GoToSpecialShop()
    {
        if (CurrentTown == null) return;
        
        switch (CurrentTown.SpecialShopType)
        {
            case "武器":
                GoToWeaponShop();
                break;
            case "防具":
                GoToArmorShop();
                break;
            case "装飾品":
                GoToAccessoryShop();
                break;
            case "消耗品":
                GoToConsumablesShop();
                break;
            case "特殊":
                GoToShop();
                break;
        }
    }

    private void NavigateToDirection(SurroundingDirection dir)
    {
        if (dir.FieldId.HasValue)
        {
            GoToFieldWithId(dir.FieldId.Value);
        }
    }

    private void GoToTown(int townId)
    {
        var town = TownService.GetTownById(townId);
        if (town != null)
        {
            CurrentTown = town;
            OtherTowns = TownService.GetTownsByCountryId(town.CountryId)
                .Where(t => t.Id != townId)
                .ToList();
        }
    }

    private void GoToShop() => Navigation.NavigateTo("/shop");
    private void GoToInn() => Navigation.NavigateTo("/inn");
    private void GoToBank() => Navigation.NavigateTo("/bank");
    private void GoToTavern() => Navigation.NavigateTo("/tavern");
    private void GoBack() => Navigation.NavigateTo("/dashboard");
    private void GoToWeaponShop() => Navigation.NavigateTo("/weapon-shop");
    private void GoToArmorShop() => Navigation.NavigateTo("/armor-shop");
    private void GoToAccessoryShop() => Navigation.NavigateTo("/accessory-shop");
    private void GoToAccessoryManagement() => Navigation.NavigateTo("/accessory-management");
    private void GoToWeaponManagement() => Navigation.NavigateTo("/weapon-management");
    private void GoToArmorManagement() => Navigation.NavigateTo("/armor-management");
    private void GoToSkillTrees() => Navigation.NavigateTo("/skill-trees");
    private void GoToAbilities() => Navigation.NavigateTo("/abilities");
    private void GoToConsumablesShop() => Navigation.NavigateTo("/consumables-shop");
    private void GoToField() => Navigation.NavigateTo("/field");
    private void GoToMap() => Navigation.NavigateTo("/map");

    private Models.Field? GetFieldById(int fieldId)
    {
        return FieldService.GetFieldById(fieldId);
    }

    private void GoToFieldWithId(int fieldId)
    {
        Navigation.NavigateTo($"/field?id={fieldId}");
    }
}
