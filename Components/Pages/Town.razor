@page "/town"
@rendermode InteractiveServer
@using MudBlazor
@using MudBlazor.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager Navigation
@inject Services.UserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject Services.CountryService CountryService
@inject Services.TownService TownService
@inject Services.TimeWeatherService TWService
@inject Services.FieldService FieldService
@inject Services.MapService MapService
@inject Services.ChatService ChatService
@inject Services.GuildService GuildService
@inject Services.StaminaService StaminaService
@inject Services.QuestService QuestService
@inject Services.FriendService FriendService
@inject Services.MailService MailService
@inject Services.DailyRewardService DailyRewardService

<PageTitle>街</PageTitle>

<div class="town-page" style="max-width:1400px; margin:0 auto; padding:16px;">
    @* ヘッダー *@
    <div class="town-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <div>
            <h1 style="margin:0;">@CurrentTown?.Name</h1>
            <p style="margin:4px 0 0 0; color:#666;">@CurrentTown?.Description</p>
        </div>
        <div style="text-align:right;">
            <div class="tw-display @TWService.Phase.ToString().ToLower()" style="display:inline-flex; align-items:center; gap:8px; padding:8px 16px; background:#f5f5f5; border-radius:8px;">
                <span>@GetTimeIcon(TWService.Phase)</span>
                <span>@FormatTime(TWService.TimeOfDay)</span>
                <span>@TWService.Weather</span>
            </div>
            <div style="margin-top:4px; color:#666;">
                📅 @GetGameDate()
            </div>
        </div>
    </div>

    @* メインレイアウト: 左(コンテンツ) + 右(アクション) *@
    <div style="display:flex; gap:16px; align-items:flex-start;">
        @* 左側: メインコンテンツ *@
        <div style="flex:1;">
            @* 町の情報バー *@
            <MudPaper Class="pa-4 mb-4">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
                    <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
                        <MudChip T="string" Color="Color.Primary">@GetTownTypeName(CurrentTown?.Type)</MudChip>
                        <span>人口: @CurrentTown?.Population.ToString("N0")</span>
                        <span>繁栄度: @CurrentTown?.Prosperity/100</span>
                        <span>(@CurrentTown?.X, @CurrentTown?.Y)</span>
                        @if (CurrentTown?.CountryName != null)
                        {
                            <span>所属国: @CurrentTown.CountryName</span>
                        }
                    </div>
                    @if (CurrentTown?.HasSpecialShop == true)
                    {
                        <MudChip T="string" Color="Color.Warning">特産: @CurrentTown.SpecialShopType</MudChip>
                    }
                </div>
            </MudPaper>

            @* プレイヤーステータス *@
            <MudPaper Class="pa-4 mb-4">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                    <div>
                        <h3 style="margin:0;">プレイヤー情報</h3>
                        <span style="color:#666;">@currentUser?.Username</span>
                    </div>
                    <div style="display:flex; gap:16px;">
                        <span>Lv.@currentUser?.Level @GetJobName(currentUser?.Job)</span>
                        <span>💰 @currentUser?.Gil.ToString("N0")</span>
                        <span>💎 @currentUser?.Premium</span>
                    </div>
                </div>
                
                <div class="mb-2">
                    <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                        <span>HP</span>
                        <span>@currentUser?.HP / @currentUser?.MaxHP</span>
                    </div>
                    <MudProgressBar Color="Color.Error" Value="@GetHpPercent()" />
                </div>
                
                <div class="mb-2">
                    <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                        <span>EXP</span>
                        <span>@currentUser?.Exp / @currentUser?.ExpToNext</span>
                    </div>
                    <MudProgressBar Color="Color.Success" Value="@GetExpPercent()" />
                </div>

                @if (staminaInfo != null && staminaInfo.Status.TryGetValue(StaminaType.Movement, out var moveStamina))
                {
                    <div>
                        <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                            <span>⚡ 移動スタミナ</span>
                            <span>@moveStamina.Current / @moveStamina.Max</span>
                        </div>
                        <MudProgressBar Color="Color.Warning" Value="@(moveStamina.RecoveryProgress * 100)" />
                    </div>
                }
            </MudPaper>

            @* クイックリンク *@
            <MudPaper Class="pa-4 mb-4">
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <MudButton Variant="Variant.Text" StartIcon="📋" OnClick="GoToQuests">クエスト (@questCount)</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="📧" OnClick="GoToMail">メール (@unreadMailCount)</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="👥" OnClick="GoToFriends">フレンド (@friendCount)</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="🎖️" OnClick="GoToGuild">@(currentGuild?.Name ?? "ギルド未加入")</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="🎁" OnClick="GoToDailyReward" Color="@(dailyRewardClass == "available" ? Color.Success : Color.Default)">@dailyRewardStatus</MudButton>
                </div>
            </MudPaper>

            @if (CurrentTown != null)
            {
                @* 町の施設 *@
                <MudPaper Class="pa-4 mb-4">
                    <h3 style="margin:0 0 16px 0;">🏨 @CurrentTown.Name の施設</h3>
                    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:12px;">
                        <div class="convenience-item" style="text-align:center; padding:12px; background:#f9f9f9; border-radius:8px;">
                            <div style="font-size:24px;">🏨</div>
                            <div>宿屋</div>
                            <div style="font-size:12px; color:#666;">HP全回復</div>
                        </div>
                        <div class="convenience-item" style="text-align:center; padding:12px; background:#f9f9f9; border-radius:8px;">
                            <div style="font-size:24px;">🏦</div>
                            <div>銀行</div>
                            <div style="font-size:12px; color:#666;">@currentUser?.BankedGil.ToString("N0")G</div>
                        </div>
                        @foreach (var facility in GetTownFacilitiesList(CurrentTown.Facilities))
                        {
                            <div class="convenience-item" style="text-align:center; padding:12px; background:#f9f9f9; border-radius:8px;">
                                <div style="font-size:24px;">@facility.Icon</div>
                                <div>@facility.Name</div>
                                <div style="font-size:12px; color:#666;">@facility.Info</div>
                            </div>
                        }
                        @if (CurrentTown.HasSpecialShop)
                        {
                            <div class="convenience-item" style="text-align:center; padding:12px; background:#fff8e1; border-radius:8px; border:2px solid #ffc107;">
                                <div style="font-size:24px;">⭐</div>
                                <div>特殊商店</div>
                                <div style="font-size:12px; color:#666;">@CurrentTown.SpecialShopType</div>
                            </div>
                        }
                    </div>
                </MudPaper>

                @* 周辺のフィールド *@
                <MudPaper Class="pa-4 mb-4">
                    <h3 style="margin:0 0 16px 0;">🗺️ 周辺のフィールド</h3>
                    <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:8px;">
                        @foreach (var dir in GetSurroundingFields())
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="() => NavigateToDirection(dir)"
                                       Style="display:flex; flex-direction:column; align-items:center; padding:12px; height:auto;">
                                <span style="font-size:20px;">@dir.Icon</span>
                                <span>@dir.Name</span>
                                @if (dir.Field != null)
                                {
                                    <span style="font-size:12px; color:green;">🌲 @dir.Field.Name</span>
                                }
                                else
                                {
                                    <span style="font-size:12px; color:#999;">未探索</span>
                                }
                            </MudButton>
                        }
                    </div>
                </MudPaper>

                @* 他の街への移動 *@
                @if (OtherTowns.Count > 0)
                {
                    <MudPaper Class="pa-4">
                        <h3 style="margin:0 0 16px 0;">🏘️ 他の街</h3>
                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            @foreach (var town in OtherTowns)
                            {
                                <MudButton Variant="Variant.Outlined" OnClick="() => GoToTown(town.Id)">
                                    @town.Name (@GetTownTypeName(town.Type))
                                </MudButton>
                            }
                        </div>
                    </MudPaper>
                }

                @* マップ移動モード *@
                @if (isMapMode && currentMapLocation != null)
                {
                    <MudPaper Class="pa-4 mb-4" style="background:#e8f5e9;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                            <h3 style="margin:0;">🗺️ マップ移動</h3>
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="ExitMapMode">終了</MudButton>
                        </div>
                        
                        <div style="text-align:center; margin-bottom:16px;">
                            <h4>@currentMapLocation.Name</h4>
                            <p style="color:#666; font-size:14px;">@currentMapLocation.Description</p>
                            <MudChip T="string" Color="Color.Primary">座標: (@currentMapLocation.X, @currentMapLocation.Y)</MudChip>
                        </div>
                        
                        @* 4方向移動ボタン *@
                        <div style="display:flex; flex-direction:column; align-items:center; gap:8px; margin-bottom:16px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" 
                                       OnClick="() => MoveMap(FFA.Services.Direction.North)"
                                       Disabled="@IsMapEdge('N')"
                                       Style="width:120px;">
                                ⬆️ 北
                            </MudButton>
                            <div style="display:flex; gap:8px;">
                                <MudButton Variant="Variant.Filled" Color="Color.Success" 
                                           OnClick="() => MoveMap(FFA.Services.Direction.West)"
                                           Disabled="@IsMapEdge('W')"
                                           Style="width:100px;">
                                    ⬅️ 西
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" 
                                           OnClick="() => MoveMap(FFA.Services.Direction.East)"
                                           Disabled="@IsMapEdge('E')"
                                           Style="width:100px;">
                                    ➡️ 東
                                </MudButton>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" 
                                       OnClick="() => MoveMap(FFA.Services.Direction.South)"
                                       Disabled="@IsMapEdge('S')"
                                       Style="width:120px;">
                                ⬇️ 南
                            </MudButton>
                        </div>
                        
                        @* 場所タイプ別のアクション *@
                        <div style="text-align:center;">
                            @if (currentMapLocation.Type == "town")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EnterTownFromMap">
                                    町に入る
                                </MudButton>
                            }
                            else if (currentMapLocation.Type == "field" || currentMapLocation.Type == "forest")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="GoToFieldFromMap">
                                    フィールドで探索
                                </MudButton>
                            }
                            else if (currentMapLocation.Type == "dungeon")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="GoToDungeonFromMap">
                                    ダンジョンに入る
                                </MudButton>
                            }
                            else if (currentMapLocation.Type == "river")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="GoToFishingFromMap">
                                    釣りをする
                                </MudButton>
                            }
                            else if (currentMapLocation.Type == "mountain")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="GoToMiningFromMap">
                                    採掘する
                                </MudButton>
                            }
                        </div>
                    </MudPaper>
                }
            }

            @* チャット表示 *@
            <MudPaper Class="pa-4 mb-4">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                    <h3 style="margin:0;">💬 チャット</h3>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="GoToChat">全文</MudButton>
                </div>
                <div class="chat-messages" style="max-height:200px; overflow-y:auto; background:#f5f5f5; border-radius:8px; padding:8px;">
                    @if (chatMessages.Any())
                    {
                        @foreach (var msg in chatMessages.Take(10))
                        {
                            <div style="font-size:12px; margin-bottom:4px;">
                                <span style="color:#888;">[@msg.Timestamp.ToString("HH:mm")]</span>
                                <span style="font-weight:bold;">@msg.Username: </span>
                                <span>@msg.Message</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color:#888; font-size:12px;">メッセージはありません</p>
                    }
                </div>
            </MudPaper>
        </div>

        @* 右側: アクションボタン *@
        <div style="width:220px; flex-shrink:0;">
            <MudPaper Class="pa-4" style="position:sticky; top:16px;">
                <h3 style="margin:0 0 16px 0; font-size:16px;">⚡ アクション</h3>
                <div style="display:flex; flex-direction:column; gap:8px;">
                    @* フィールドへの移動は常に表示 *@
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="GoToField" StartIcon="🌲">
                        フィールド
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="EnterMapMode" StartIcon="🗺️">
                        マップ移動
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="GoToInn" StartIcon="🏨">
                        宿屋
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" OnClick="GoToBank" StartIcon="🏦">
                        銀行
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Default" FullWidth="true" OnClick="GoToTavern" StartIcon="🍺">
                        酒場
                    </MudButton>
                    
                    <MudDivider Class="my-2" />
                    
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="GoToWeaponShop" StartIcon="⚔️">
                        武器屋
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="GoToArmorShop" StartIcon="🛡️">
                        防具屋
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="GoToAccessoryShop" StartIcon="💍">
                        装飾品屋
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="GoToConsumablesShop" StartIcon="🧪">
                        消耗品屋
                    </MudButton>
                    
                    <MudDivider Class="my-2" />
                    
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToWeaponManagement" StartIcon="⚒️">
                        武器管理
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToArmorManagement" StartIcon="🛡️">
                        防具管理
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToAccessoryManagement" StartIcon="💎">
                        装飾品管理
                    </MudButton>
                    
                    <MudDivider Class="my-2" />
                    
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToSkillTrees" StartIcon="🌳">
                        スキルツリー
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToAbilities" StartIcon="✨">
                        アビリティ
                    </MudButton>
                    
                    <MudDivider Class="my-2" />
                    
                    <MudButton Variant="Variant.Filled" Color="Color.Dark" FullWidth="true" OnClick="GoBack" StartIcon="🏠">
                        ダッシュボード
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToMap" StartIcon="🗺️">
                        マップ
                    </MudButton>
                </div>
            </MudPaper>
        </div>
    </div>
</div>

@code {
    private User? currentUser;
    private Models.Country? currentCountry;
    private Models.Town? CurrentTown { get; set; }
    private List<Models.Town> OtherTowns { get; set; } = new List<Models.Town>();
    private List<SurroundingDirection> SurroundingFields { get; set; } = new List<SurroundingDirection>();
    
    private StaminaInfo? staminaInfo;
    private Models.Guild? currentGuild;
    private int questCount;
    private int unreadMailCount;
    private int friendCount;
    private string dailyRewardStatus = "";
    private string dailyRewardClass = "";
    
    // マップ移動モード
    private bool isMapMode = false;
    private MapLocation? currentMapLocation;
    private const int MapOffset = 5; // 町の座標(-3~3)をマップ座標(0~10)に変換
    private int currentCountryId = 5; // デフォルトは中立之城
    
    // チャット
    private List<FFA.Models.ChatMessage> chatMessages = new();
    private FFA.Models.ChatChannel currentChatChannel = FFA.Models.ChatChannel.World;
    
    private class SurroundingDirection
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
        public int X { get; set; }
        public int Y { get; set; }
        public int? FieldId { get; set; }
        public Models.Field? Field { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // チャットメッセージを読み込み
        try {
            chatMessages = ChatService.GetWorldMessages(50);
        } catch { }

        // 認証ユーザーを取得
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var authUser = authState.User;
        var username = authUser?.Identity?.Name;
        if (username != null)
        {
            currentUser = UserService.GetByUsername(username);
        }
        
        if (currentUser != null)
        {
            staminaInfo = StaminaService.GetStaminaInfo(currentUser.Username);
            currentGuild = GuildService.GetUserGuild(currentUser);
            questCount = currentUser.CurrentQuest != null && !currentUser.CurrentQuest.IsCompleted ? 1 : 0;
            unreadMailCount = MailService.GetUnreadCount(currentUser.Id);
            friendCount = FriendService.GetFriendCount(currentUser.Id);
            
            if (DailyRewardService.HasClaimed(currentUser.Username))
            {
                dailyRewardStatus = "明日受取";
                dailyRewardClass = "";
            }
            else
            {
                dailyRewardStatus = "受取可能";
                dailyRewardClass = "available";
            }
        }
        
        if (currentUser?.CountryId != null)
        {
            currentCountry = CountryService.GetCountryById(currentUser.CountryId.Value);
            var towns = TownService.GetTownsByCountryId(currentUser.CountryId.Value);
            CurrentTown = towns.FirstOrDefault(t => t.Type == "capital") ?? towns.FirstOrDefault();
            OtherTowns = towns.Where(t => t.Id != CurrentTown?.Id).ToList();
            
            // 国のIDを設定
            currentCountryId = CurrentTown?.CountryId ?? 5;
        }
        else
        {
            var neutralCountry = CountryService.GetAllCountries().FirstOrDefault(c => c.Name == "Neutral Haven");
            if (neutralCountry != null)
            {
                CurrentTown = neutralCountry.Towns.FirstOrDefault(t => t.Type == "capital");
                OtherTowns = neutralCountry.Towns.Where(t => t.Id != CurrentTown?.Id).ToList();
            }
        }
    }

    private string GetTownTypeName(string? type)
    {
        return type switch
        {
            "capital" => "首都",
            "village" => "田舎",
            "town" => "一般街",
            _ => "街"
        };
    }

    private string GetTimeIcon(FFA.Services.DayPhase phase)
    {
        return phase switch
        {
            FFA.Services.DayPhase.Dawn => "🌅",
            FFA.Services.DayPhase.Day => "☀️",
            FFA.Services.DayPhase.Dusk => "🌆",
            FFA.Services.DayPhase.Night => "🌙",
            _ => "🌤️"
        };
    }

    private string FormatTime(double t)
    {
        int hh = (int)Math.Floor(t);
        int mm = (int)Math.Floor((t - hh) * 60);
        return $"{hh:D2}:{mm:D2}";
    }
    
    private string GetGameDate()
    {
        var now = DateTime.Now;
        int month = now.Month;
        int day = now.Day;
        string[] monthNames = { "", "雪月", "花月", "風月", "鳥月", "虫月", "雨月", "雲月", "霧月", "紅葉月", "神無月", "霜月", "師走" };
        return $"{monthNames[month]} {day}日";
    }

    private string GetJobName(Job? job)
    {
        return job switch
        {
            Job.Warrior => "戦士",
            Job.Monk => "武闘家",
            Job.WhiteMage => "白魔道士",
            Job.BlackMage => "黒魔道士",
            Job.Ranger => "レンジャー",
            Job.Paladin => "パラディン",
            Job.DarkKnight => "ダークナイト",
            Job.Bard => "吟遊詩人",
            Job.Thief => "盗賊",
            Job.Ninja => "忍者",
            Job.HolyKnight => "聖騎士",
            Job.DeathKnight => "死騎",
            Job.ArchMage => "大魔道師",
            Job.BeastMaster => "ビーストマスター",
            Job.Duelist => "剣豪",
            Job.Grandmaster => "マスター",
            _ => "初心者"
        };
    }

    private int GetHpPercent()
    {
        if (currentUser == null || currentUser.MaxHP == 0) return 0;
        return (int)((double)currentUser.HP / currentUser.MaxHP * 100);
    }
    
    private int GetExpPercent()
    {
        if (currentUser == null || currentUser.ExpToNext == 0) return 0;
        return (int)((double)currentUser.Exp / currentUser.ExpToNext * 100);
    }

    private List<TownFacilityInfo> GetTownFacilitiesList(List<string> facilities)
    {
        var result = new List<TownFacilityInfo>();
        
        foreach (var facility in facilities)
        {
            var info = facility.ToLower() switch
            {
                "鍛冶屋" or "鍛冶" or "武器屋" => new TownFacilityInfo { Icon = "⚒️", Name = "鍛冶屋", Info = "強化・修理" },
                "防具屋" => new TownFacilityInfo { Icon = "🛡️", Name = "防具屋", Info = "防具販売" },
                "装飾品屋" or "アクセサリー" => new TownFacilityInfo { Icon = "💍", Name = "装飾品屋", Info = "アクセサリー" },
                "消耗品屋" or "薬屋" => new TownFacilityInfo { Icon = "🧪", Name = "消耗品屋", Info = "薬・道具" },
                "釣り場" or "釣り" => new TownFacilityInfo { Icon = "🎣", Name = "釣り場", Info = "川・海" },
                "鉱山" or "採掘" => new TownFacilityInfo { Icon = "⛏️", Name = "鉱山", Info = "採掘" },
                "ダンジョン" => new TownFacilityInfo { Icon = "🏰", Name = "ダンジョン", Info = "探索" },
                "酒場" or " Tavern" => new TownFacilityInfo { Icon = "🍺", Name = "酒場", Info = "情報" },
                "神殿" or "教会" => new TownFacilityInfo { Icon = "⛪", Name = "神殿", Info = "回復・祈願" },
                "市場" => new TownFacilityInfo { Icon = "🏪", Name = "市場", Info = "交易" },
                "guild" or "ギルド" => new TownFacilityInfo { Icon = "🎖️", Name = "ギルド", Info = "共同活動" },
                _ => new TownFacilityInfo { Icon = "🏛️", Name = facility, Info = "施設" }
            };
            result.Add(info);
        }
        
        return result;
    }

    private class TownFacilityInfo
    {
        public string Icon { get; set; } = "";
        public string Name { get; set; } = "";
        public string Info { get; set; } = "";
    }

    private static readonly (string Name, string Icon, int DX, int DY)[] Directions = new[]
    {
        ("北", "⬆️", 0, -1),
        ("北東", "↗️", 1, -1),
        ("東", "➡️", 1, 0),
        ("南東", "↘️", 1, 1),
        ("南", "⬇️", 0, 1),
        ("南西", "↙️", -1, 1),
        ("西", "⬅️", -1, 0),
        ("北西", "↖️", -1, -1)
    };

    private List<SurroundingDirection> GetSurroundingFields()
    {
        var result = new List<SurroundingDirection>();
        
        if (CurrentTown == null) return result;
        
        var allFields = FieldService.GetAllFields();
        
        foreach (var (name, icon, dx, dy) in Directions)
        {
            var targetX = CurrentTown.X + dx;
            var targetY = CurrentTown.Y + dy;
            var fieldId = GetFieldIdForDirection(targetX, targetY);
            
            result.Add(new SurroundingDirection
            {
                Name = name,
                Icon = icon,
                X = targetX,
                Y = targetY,
                FieldId = fieldId,
                Field = fieldId.HasValue ? FieldService.GetFieldById(fieldId.Value) : null
            });
        }
        
        return result;
    }

    private int? GetFieldIdForDirection(int x, int y)
    {
        if (CurrentTown?.AvailableFields == null || CurrentTown.AvailableFields.Count == 0)
            return null;
        
        var fieldIndex = (x + 1) + (y + 1) * 3;
        fieldIndex = Math.Clamp(fieldIndex, 0, CurrentTown.AvailableFields.Count - 1);
        return CurrentTown.AvailableFields[fieldIndex];
    }

    private void NavigateToDirection(SurroundingDirection dir)
    {
        if (dir.FieldId.HasValue)
        {
            GoToFieldWithId(dir.FieldId.Value);
        }
    }

    private void GoToTown(int townId)
    {
        var town = TownService.GetTownById(townId);
        if (town != null)
        {
            CurrentTown = town;
            OtherTowns = TownService.GetTownsByCountryId(town.CountryId)
                .Where(t => t.Id != townId)
                .ToList();
        }
    }

