    // マップ移動モード
    private void EnterMapMode()
    {
        if (CurrentTown == null) return;
        // 町の座標直接使用
        currentMapLocation = MapService.GetLocationByCoords(currentCountryId, CurrentTown.X, CurrentTown.Y);
        isMapMode = true;
    }
    
    private void ExitMapMode()
    {
        isMapMode = false;
        currentMapLocation = null;
    }
    
    private void MoveMap(FFA.Services.Direction direction)
    {
        if (currentMapLocation == null) return;
        currentMapLocation = MapService.Move(currentCountryId, direction, currentMapLocation.X, currentMapLocation.Y);
    }
    
    private bool IsMapEdge(char direction)
    {
        if (currentMapLocation == null) return true;
        // マップ範囲: -2 から 2
        return direction switch
        {
            'N' => currentMapLocation.Y <= -2,
            'S' => currentMapLocation.Y >= 2,
            'W' => currentMapLocation.X <= -2,
            'E' => currentMapLocation.X >= 2,
            _ => true
        };
    }
    
    private void EnterTownFromMap()
    {
        // マップ上の町位置から対応する街を探す
        if (currentMapLocation == null) return;
        var townX = currentMapLocation.X - MapOffset;
        var townY = currentMapLocation.Y - MapOffset;
        
        // 附近の町を探す
        var allTowns = TownService.GetAllTowns();
        var nearestTown = allTowns.FirstOrDefault(t => t.X == townX && t.Y == townY);
        if (nearestTown != null)
        {
            GoToTown(nearestTown.Id);
        }
        ExitMapMode();
    }
    
    private void GoToFieldFromMap()
    {
        ExitMapMode();
        GoToField();
    }
    
    private void GoToDungeonFromMap()
    {
        ExitMapMode();
