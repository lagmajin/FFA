@page "/town"
@rendermode InteractiveServer
@using MudBlazor
@using MudBlazor.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager Navigation
@inject Services.UserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject Services.CountryService CountryService
@inject Services.TownService TownService
@inject Services.TimeWeatherService TWService
@inject Services.FieldService FieldService
@inject Services.MapService MapService
@inject Services.ChatService ChatService
@inject Services.GuildService GuildService
@inject Services.StaminaService StaminaService
@inject Services.QuestService QuestService
@inject Services.FriendService FriendService
@inject Services.MailService MailService
@inject Services.DailyRewardService DailyRewardService

<PageTitle>街</PageTitle>

<div class="town-page" style="max-width:1400px; margin:0 auto; padding:16px;">
    @* ヘッダー *@
    <div style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 50%,#0f3460 100%);padding:28px 32px;border-radius:16px;margin-bottom:20px;position:relative;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.15);">
        <div style="position:absolute;top:-50px;right:-50px;width:220px;height:220px;background:rgba(255,255,255,0.04);border-radius:50%;pointer-events:none;"></div>
        <div style="position:absolute;bottom:-70px;right:100px;width:160px;height:160px;background:rgba(255,255,255,0.025);border-radius:50%;pointer-events:none;"></div>
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;position:relative;">
            <div>
                <div style="color:rgba(255,255,255,0.45);font-size:11px;letter-spacing:0.15em;text-transform:uppercase;margin-bottom:6px;">@GetTownTypeName(CurrentTown?.Type)@(CurrentTown?.CountryName != null ? $" · {CurrentTown.CountryName}" : "")</div>
                @if (isLoading)
                {
                    <h1 style="margin:0;font-size:2.4rem;font-weight:900;color:rgba(255,255,255,0.3);">読み込み中...</h1>
                }
                else
                {
                    <h1 style="margin:0;font-size:2.4rem;font-weight:900;color:#fff;text-shadow:0 2px 12px rgba(0,0,0,0.4);">@(CurrentTown?.Name ?? "旅の拠点")</h1>
                }
                <p style="margin:8px 0 0 0;color:rgba(255,255,255,0.6);font-size:14px;">@CurrentTown?.Description</p>
            </div>
            <div style="text-align:right;flex-shrink:0;">
                <div style="display:inline-flex;align-items:center;gap:10px;padding:12px 18px;background:rgba(255,255,255,0.1);border-radius:12px;border:1px solid rgba(255,255,255,0.15);color:#fff;">
                    <span style="font-size:1.4em;">@GetTimeIcon(TWService.Phase)</span>
                    <div>
                        <div style="font-size:1.2rem;font-weight:700;line-height:1;">@FormatTime(TWService.TimeOfDay)</div>
                        <div style="font-size:12px;opacity:0.75;margin-top:2px;">@TWService.Weather</div>
                    </div>
                </div>
                <div style="margin-top:6px;color:rgba(255,255,255,0.5);font-size:12px;">📅 @GetGameDate()</div>
            </div>
        </div>
    </div>

    @* メインレイアウト: 左(コンテンツ) + 右(アクション) *@
    <div style="display:flex; gap:16px; align-items:flex-start;">
        @* 左側: メインコンテンツ *@
        <div style="flex:1;">
            @* 町の情報バー *@
            <MudPaper Class="pa-4 mb-4">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
                    <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
                        <MudChip T="string" Color="Color.Primary">@GetTownTypeName(CurrentTown?.Type)</MudChip>
                        <span>人口: @CurrentTown?.Population.ToString("N0")</span>
                        <span>繁栄度: @CurrentTown?.Prosperity/100</span>
                        <span>(@CurrentTown?.X, @CurrentTown?.Y)</span>
                        @if (CurrentTown?.CountryName != null)
                        {
                            <span>所属国: @CurrentTown.CountryName</span>
                        }
                    </div>
                    @if (CurrentTown?.HasSpecialShop == true)
                    {
                        <MudChip T="string" Color="Color.Warning">特産: @CurrentTown.SpecialShopType</MudChip>
                    }
                </div>
            </MudPaper>

            @* プレイヤーステータス *@
            <MudPaper Class="mb-4" Style="overflow:hidden;border-radius:12px!important;">
                <div style="background:linear-gradient(135deg,#2d3561 0%,#c05c7e 100%);padding:18px 20px;color:#fff;">
                    <div style="display:flex;align-items:center;gap:14px;">
                        <div style="width:52px;height:52px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0;border:2px solid rgba(255,255,255,0.25);">@GetJobIcon(currentUser?.Job)</div>
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
                                <div>
                                    <div style="font-size:1.1rem;font-weight:700;white-space:nowrap;">@currentUser?.Username</div>
                                    <div style="font-size:12px;opacity:0.8;margin-top:1px;">Lv.@currentUser?.Level　@GetJobName(currentUser?.Job)</div>
                                </div>
                                <div style="text-align:right;font-size:13px;flex-shrink:0;">
                                    <div>💰 @currentUser?.Gil.ToString("N0") G</div>
                                    <div style="opacity:0.75;">💎 @currentUser?.Premium</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div style="padding:14px 16px;">
                    <div class="mb-2">
                        <div style="display:flex;justify-content:space-between;margin-bottom:3px;font-size:12px;">
                            <span style="color:#e53935;font-weight:600;">❤️ HP</span>
                            <span style="color:#555;">@currentUser?.HP / @currentUser?.MaxHP</span>
                        </div>
                        <MudProgressBar Color="Color.Error" Value="@GetHpPercent()" />
                    </div>
                    <div class="mb-2">
                        <div style="display:flex;justify-content:space-between;margin-bottom:3px;font-size:12px;">
                            <span style="color:#43a047;font-weight:600;">⭐ EXP</span>
                            <span style="color:#555;">@currentUser?.Exp / @currentUser?.ExpToNext</span>
                        </div>
                        <MudProgressBar Color="Color.Success" Value="@GetExpPercent()" />
                    </div>
                    @if (staminaInfo != null && staminaInfo.Status.TryGetValue(StaminaType.Movement, out var moveStamina))
                    {
                        <div>
                            <div style="display:flex;justify-content:space-between;margin-bottom:3px;font-size:12px;">
                                <span style="color:#f57c00;font-weight:600;">⚡ 移動スタミナ</span>
                                <span style="color:#555;">@moveStamina.Current / @moveStamina.Max</span>
                            </div>
                            <MudProgressBar Color="Color.Warning" Value="@(moveStamina.RecoveryProgress * 100)" />
                        </div>
                    }
                </div>
            </MudPaper>

            @* クイックリンク *@
            <MudPaper Class="pa-4 mb-4">
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <MudButton Variant="Variant.Text" StartIcon="📋" OnClick="GoToQuests">クエスト (@questCount)</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="📧" OnClick="GoToMail">メール (@unreadMailCount)</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="👥" OnClick="GoToFriends">フレンド (@friendCount)</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="🎖️" OnClick="GoToGuild">@(currentGuild?.Name ?? "ギルド未加入")</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="🎁" OnClick="GoToDailyReward" Color="@(dailyRewardClass == "available" ? Color.Success : Color.Default)">@dailyRewardStatus</MudButton>
                </div>
            </MudPaper>

            @if (CurrentTown != null)
            {
                @* 町の施設 *@
                <MudPaper Class="pa-4 mb-4">
                    <h3 style="margin:0 0 16px 0;">🏨 @CurrentTown.Name の施設</h3>
                    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:12px;">
                        <div class="convenience-item" style="text-align:center; padding:16px; background:linear-gradient(135deg, #fff5e6 0%, #ffe0b2 100%); border-radius:12px; border:2px solid #ff9800; cursor:pointer; transition:transform 0.2s, box-shadow 0.2s;" @onclick="GoToInn">
                            <div style="font-size:28px;">🏨</div>
                            <div style="font-weight:bold; margin:4px 0;">宿屋</div>
                            <div style="font-size:12px; color:#666;">HP全回復</div>
                            @if (currentUser != null)
                            {
                                <div style="margin-top:8px; padding:6px; background:rgba(255,255,255,0.7); border-radius:6px; font-size:11px;">
                                    <div style="display:flex; justify-content:space-between; margin-bottom:2px;">
                                        <span>HP:</span>
                                        <span style="color:@(currentUser.HP < currentUser.MaxHP ? "#e53935" : "#43a047"); font-weight:bold;">@currentUser.HP / @currentUser.MaxHP</span>
                                    </div>
                                    <div style="display:flex; justify-content:space-between;">
                                        <span>費用:</span>
                                        <span style="color:@(currentUser.Gil >= 100 ? "#43a047" : "#e53935"); font-weight:bold;">100 ギル</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="convenience-item" style="text-align:center; padding:12px; background:#f9f9f9; border-radius:8px;">
                            <div style="font-size:24px;">🏦</div>
                            <div>銀行</div>
                            <div style="font-size:12px; color:#666;">@currentUser?.BankedGil.ToString("N0")G</div>
                        </div>
                        @foreach (var facility in GetTownFacilitiesList(CurrentTown.Facilities))
                        {
                            <div class="convenience-item" style="text-align:center; padding:12px; background:#f9f9f9; border-radius:8px;">
                                <div style="font-size:24px;">@facility.Icon</div>
                                <div>@facility.Name</div>
                                <div style="font-size:12px; color:#666;">@facility.Info</div>
                            </div>
                        }
                        @if (CurrentTown.HasSpecialShop)
                        {
                            <div class="convenience-item" style="text-align:center; padding:12px; background:#fff8e1; border-radius:8px; border:2px solid #ffc107;">
                                <div style="font-size:24px;">⭐</div>
                                <div>特殊商店</div>
                                <div style="font-size:12px; color:#666;">@CurrentTown.SpecialShopType</div>
                            </div>
                        }
                    </div>
                </MudPaper>

                @* 周辺のフィールド *@
                <MudPaper Class="pa-4 mb-4">
                    <h3 style="margin:0 0 16px 0;">🗺️ 周辺のフィールド</h3>
                    <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:8px;">
                        @foreach (var dir in GetSurroundingFields())
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="() => NavigateToDirection(dir)"
                                       Style="display:flex; flex-direction:column; align-items:center; padding:12px; height:auto;">
                                <span style="font-size:20px;">@dir.Icon</span>
                                <span>@dir.Name</span>
                                @if (dir.Field != null)
                                {
                                    <span style="font-size:12px; color:green;">🌲 @dir.Field.Name</span>
                                }
                                else
                                {
                                    <span style="font-size:12px; color:#999;">未探索</span>
                                }
                            </MudButton>
                        }
                    </div>
                </MudPaper>

                @* 他の街への移動 *@
                @if (OtherTowns.Count > 0)
                {
                    <MudPaper Class="pa-4">
                        <h3 style="margin:0 0 16px 0;">🏘️ 他の街</h3>
                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            @foreach (var town in OtherTowns)
                            {
                                <MudButton Variant="Variant.Outlined" OnClick="() => GoToTown(town.Id)">
                                    @town.Name (@GetTownTypeName(town.Type))
                                </MudButton>
                            }
                        </div>
                    </MudPaper>
                }

                @* マップ移動モード *@
                @if (isMapMode && currentMapLocation != null)
                {
                    <MudPaper Class="pa-4 mb-4" style="background:#e8f5e9;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                            <h3 style="margin:0;">🗺️ マップ移動</h3>
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="ExitMapMode">終了</MudButton>
                        </div>
                        
                        <div style="text-align:center; margin-bottom:16px;">
                            <h4>@currentMapLocation.Name</h4>
                            <p style="color:#666; font-size:14px;">@currentMapLocation.Description</p>
                            <MudChip T="string" Color="Color.Primary">座標: (@currentMapLocation.X, @currentMapLocation.Y)</MudChip>
                        </div>
                        
                        @* 4方向移動ボタン *@
                        <div style="display:flex; flex-direction:column; align-items:center; gap:8px; margin-bottom:16px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" 
                                       OnClick="() => MoveMap(FFA.Services.Direction.North)"
                                       Disabled="@IsMapEdge('N')"
                                       Style="width:120px;">
                                ⬆️ 北
                            </MudButton>
                            <div style="display:flex; gap:8px;">
                                <MudButton Variant="Variant.Filled" Color="Color.Success" 
                                           OnClick="() => MoveMap(FFA.Services.Direction.West)"
                                           Disabled="@IsMapEdge('W')"
                                           Style="width:100px;">
                                    ⬅️ 西
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" 
                                           OnClick="() => MoveMap(FFA.Services.Direction.East)"
                                           Disabled="@IsMapEdge('E')"
                                           Style="width:100px;">
                                    ➡️ 東
                                </MudButton>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" 
                                       OnClick="() => MoveMap(FFA.Services.Direction.South)"
                                       Disabled="@IsMapEdge('S')"
                                       Style="width:120px;">
                                ⬇️ 南
                            </MudButton>
                        </div>
                        
                        @* 場所タイプ別のアクション *@
                        <div style="text-align:center;">
                            @if (currentMapLocation.Type == "town")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EnterTownFromMap">
                                    町に入る
                                </MudButton>
                            }
                            else if (currentMapLocation.Type == "field" || currentMapLocation.Type == "forest")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="GoToFieldFromMap">
                                    フィールドで探索
                                </MudButton>
                            }
                            else if (currentMapLocation.Type == "dungeon")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="GoToDungeonFromMap">
                                    ダンジョンに入る
                                </MudButton>
                            }
                            else if (currentMapLocation.Type == "river")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="GoToFishingFromMap">
                                    釣りをする
                                </MudButton>
                            }
                            else if (currentMapLocation.Type == "mountain")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="GoToMiningFromMap">
                                    採掘する
                                </MudButton>
                            }
                        </div>
                    </MudPaper>
                }
            }

            @* チャット表示 *@
            <MudPaper Class="pa-4 mb-4">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                    <h3 style="margin:0;">💬 チャット</h3>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="GoToChat">全文</MudButton>
                </div>
                <div class="chat-messages" style="max-height:200px; overflow-y:auto; background:#f5f5f5; border-radius:8px; padding:8px;">
                    @if (chatMessages.Any())
                    {
                        @foreach (var msg in chatMessages.Take(10))
                        {
                            <div style="font-size:12px; margin-bottom:4px;">
                                <span style="color:#888;">[@msg.Timestamp.ToString("HH:mm")]</span>
                                <span style="font-weight:bold;">@msg.Username: </span>
                                <span>@msg.Message</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color:#888; font-size:12px;">メッセージはありません</p>
                    }
                </div>
            </MudPaper>
        </div>

        @* 右側: アクションボタン *@
        <div style="width:230px; flex-shrink:0;">
            <div style="position:sticky; top:16px; display:flex; flex-direction:column; gap:10px;">
                @* 移動・施設 *@
                <MudPaper Class="pa-3" Style="border-radius:12px!important;">
                    <div style="font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:#999;margin-bottom:8px;font-weight:700;">移動・施設</div>
                    <div style="display:flex;flex-direction:column;gap:5px;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="GoToMap" StartIcon="🗺️" Style="border-radius:8px!important;">マップ移動</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="GoToInn" StartIcon="🏨" Style="border-radius:8px!important;">宿屋</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" OnClick="GoToBank" StartIcon="🏦" Style="border-radius:8px!important;">銀行</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="GoToTavern" StartIcon="🍺" Style="border-radius:8px!important;">酒場</MudButton>
                    </div>
                </MudPaper>
                @* ショップ *@
                <MudPaper Class="pa-3" Style="border-radius:12px!important;">
                    <div style="font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:#999;margin-bottom:8px;font-weight:700;">ショップ</div>
                    <div style="display:flex;flex-direction:column;gap:5px;">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="GoToWeaponShop" StartIcon="⚔️" Style="border-radius:8px!important;">武器屋</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="GoToArmorShop" StartIcon="🛡️" Style="border-radius:8px!important;">防具屋</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="GoToAccessoryShop" StartIcon="💍" Style="border-radius:8px!important;">装飾品屋</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="GoToConsumablesShop" StartIcon="🧪" Style="border-radius:8px!important;">消耗品屋</MudButton>
                    </div>
                </MudPaper>
                @* 装備・成長 *@
                <MudPaper Class="pa-3" Style="border-radius:12px!important;">
                    <div style="font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:#999;margin-bottom:8px;font-weight:700;">装備・成長</div>
                    <div style="display:flex;flex-direction:column;gap:2px;">
                        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToWeaponManagement" StartIcon="⚒️" Size="Size.Small">武器管理</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToArmorManagement" StartIcon="🛡️" Size="Size.Small">防具管理</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToAccessoryManagement" StartIcon="💎" Size="Size.Small">装飾品管理</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToSkillTrees" StartIcon="🌳" Size="Size.Small">スキルツリー</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="GoToAbilities" StartIcon="✨" Size="Size.Small">アビリティ</MudButton>
                    </div>
                </MudPaper>
                <MudButton Variant="Variant.Filled" Color="Color.Dark" FullWidth="true" OnClick="GoBack" StartIcon="🏠" Style="border-radius:10px!important;">ダッシュボード</MudButton>
            </div>
        </div>
    </div>
</div>

@code {
    private User? currentUser;
    private Models.Country? currentCountry;
    private Models.Town? CurrentTown { get; set; }
    private List<Models.Town> OtherTowns { get; set; } = new List<Models.Town>();
    private List<SurroundingDirection> SurroundingFields { get; set; } = new List<SurroundingDirection>();
    
    private StaminaInfo? staminaInfo;
    private Models.Guild? currentGuild;
    private int questCount;
    private int unreadMailCount;
    private int friendCount;
    private string dailyRewardStatus = "";
    private string dailyRewardClass = "";
    
    // マップ移動モード
    private bool isMapMode = false;
    private MapLocation? currentMapLocation;
    private const int MapOffset = 5; // 町の座標(-3~3)をマップ座標(0~10)に変換
    private int currentCountryId = 5; // デフォルトは中立之城
    private bool isLoading = true;

    // チャット
    private List<FFA.Models.ChatMessage> chatMessages = new();
    private FFA.Models.ChatChannel currentChatChannel = FFA.Models.ChatChannel.World;
    
    private class SurroundingDirection
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
        public int X { get; set; }
        public int Y { get; set; }
        public int? FieldId { get; set; }
        public Models.Field? Field { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // チャットメッセージを読み込み
        try {
            chatMessages = ChatService.GetWorldMessages(50);
        } catch { }

        // 認証ユーザーを取得
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var authUser = authState.User;
        var username = authUser?.Identity?.Name;
        if (username != null)
        {
            currentUser = UserService.GetByUsername(username);
        }
        
        if (currentUser != null)
        {
            staminaInfo = StaminaService.GetStaminaInfo(currentUser.Username);
            currentGuild = GuildService.GetUserGuild(currentUser);
            questCount = currentUser.CurrentQuest != null && !currentUser.CurrentQuest.IsCompleted ? 1 : 0;
            unreadMailCount = MailService.GetUnreadCount(currentUser.Id);
            friendCount = FriendService.GetFriendCount(currentUser.Id);
            
            if (DailyRewardService.HasClaimed(currentUser.Username))
            {
                dailyRewardStatus = "明日受取";
                dailyRewardClass = "";
            }
            else
            {
                dailyRewardStatus = "受取可能";
                dailyRewardClass = "available";
            }
        }
        
        // 未認証はログインへリダイレクト
        if (currentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // フォールバック1: 所属国の首都
        if (currentUser.CountryId != null)
        {
            currentCountry = CountryService.GetCountryById(currentUser.CountryId.Value);
            var towns = TownService.GetTownsByCountryId(currentUser.CountryId.Value);
            CurrentTown = towns.FirstOrDefault(t => t.Type == "capital") ?? towns.FirstOrDefault();
            OtherTowns = towns.Where(t => t.Id != CurrentTown?.Id).ToList();
            currentCountryId = CurrentTown?.CountryId ?? 5;
        }

        // フォールバック2: 中立国 "Neutral Haven" の首都
        if (CurrentTown == null)
        {
            var neutralCountry = CountryService.GetAllCountries().FirstOrDefault(c => c.Name == "Neutral Haven");
            if (neutralCountry != null)
            {
                currentCountry = neutralCountry;
                CurrentTown = neutralCountry.Towns.FirstOrDefault(t => t.Type == "capital") ?? neutralCountry.Towns.FirstOrDefault();
                OtherTowns = neutralCountry.Towns.Where(t => t.Id != CurrentTown?.Id).ToList();
                currentCountryId = neutralCountry.Id;
            }
        }

        // フォールバック3: 全国から最初の首都を使用
            if (CurrentTown == null)
            {
                var allTowns = TownService.GetAllTowns();
                CurrentTown = allTowns.FirstOrDefault(t => t.Type == "capital") ?? allTowns.FirstOrDefault();
                if (CurrentTown != null)
                {
                    currentCountryId = CurrentTown.CountryId;
                    OtherTowns = TownService.GetTownsByCountryId(CurrentTown.CountryId)
                        .Where(t => t.Id != CurrentTown.Id).ToList();
                }
            }
            isLoading = false;
        }

