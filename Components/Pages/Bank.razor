@code {
    private bool isAuth = false;
    private string? username;
    private User? currentUser;
    private string currentTab = "bank";
    
    private int depositAmount = 0;
    private int withdrawAmount = 0;
    private string message = "";
    private string messageType = "success";
    
    private List<InvestmentProduct> availableProducts = new();
    private List<UserInvestment> userInvestments = new();
    private InvestmentStats stats = new();
    
    private Dictionary<int, int> investmentAmounts = new();
    private Dictionary<int, int> investmentDurations = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var authUser = state.User;
        isAuth = authUser?.Identity?.IsAuthenticated ?? false;
        username = authUser?.Identity?.Name;

        if (isAuth && username != null)
        {
            currentUser = UserService.GetByUsername(username);
            availableProducts = InvestmentService.GetAvailableProducts(username);
            userInvestments = InvestmentService.GetUserInvestments(username);
            stats = InvestmentService.GetUserStats(username);
            
            // 初期化
            foreach (var product in availableProducts)
            {
                investmentAmounts[product.Id] = product.MinInvestment;
                investmentDurations[product.Id] = product.MinDurationDays;
            }
        }
    }

    private void Deposit()
    {
        if (currentUser == null || depositAmount <= 0) return;

        if (depositAmount > currentUser.Gil)
        {
            message = "手持ちギルが足りません";
            messageType = "error";
            return;
        }

        currentUser.Gil -= depositAmount;
        currentUser.BankedGil += depositAmount;
        UserService.UpdateUser(currentUser);
        
        message = $"{depositAmount:N0} ギルを預けました";
        messageType = "success";
        depositAmount = 0;
    }

    private void Withdraw()
    {
        if (currentUser == null || withdrawAmount <= 0) return;

        if (withdrawAmount > currentUser.BankedGil)
        {
            message = "預金が足りません";
            messageType = "error";
            return;
        }

        currentUser.BankedGil -= withdrawAmount;
        currentUser.Gil += withdrawAmount;
        UserService.UpdateUser(currentUser);
        
        message = $"{withdrawAmount:N0} ギルを引き出しました";
        messageType = "success";
        withdrawAmount = 0;
    }

    private void Invest(int productId)
    {
        if (currentUser == null || username == null) return;
        
        var amount = investmentAmounts.GetValueOrDefault(productId, 0);
        var duration = investmentDurations.GetValueOrDefault(productId, 1);
        
        var result = InvestmentService.Invest(username, productId, amount, duration);
        message = result.Message;
        messageType = result.Success ? "success" : "error";
        
        if (result.Success)
        {
            currentUser = UserService.GetByUsername(username);
            userInvestments = InvestmentService.GetUserInvestments(username);
            stats = InvestmentService.GetUserStats(username);
        }
    }

    private void ClaimInvestment(int investmentId)
    {
        if (username == null) return;
        
        var result = InvestmentService.ClaimInvestment(username, investmentId);
        message = result.Message;
        messageType = result.Success ? "success" : "error";
        
        if (result.Success)
        {
            currentUser = UserService.GetByUsername(username);
            userInvestments = InvestmentService.GetUserInvestments(username);
            stats = InvestmentService.GetUserStats(username);
        }
    }

    private void LiquidateInvestment(int investmentId)
    {
        if (username == null) return;
        
        var result = InvestmentService.LiquidateInvestment(username, investmentId);
        message = result.Message;
        messageType = result.Success ? "success" : "error";
        
        if (result.Success)
        {
            currentUser = UserService.GetByUsername(username);
            userInvestments = InvestmentService.GetUserInvestments(username);
            stats = InvestmentService.GetUserStats(username);
        }
    }

    private string GetStatusText(InvestmentStatus status) => status switch
    {
        InvestmentStatus.Active => "投資中",
        InvestmentStatus.Matured => "満期",
        InvestmentStatus.Completed => "完了",
        InvestmentStatus.Liquidated => "清算",
        InvestmentStatus.Failed => "失敗",
        _ => status.ToString()
    };

    private void GoBack()
    {
        Navigation.NavigateTo("/town");
    }
}
