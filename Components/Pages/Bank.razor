@page "/bank"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject Services.UserService UserService
@inject Services.InvestmentService InvestmentService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>銀行 - 投資センター</PageTitle>

<div class="bank-container">
    <h1 class="bank-title">🏦 銀行 - 投資センター</h1>
    
    @if (!isAuth)
    {
        <div class="auth-warning">
            <p>🔐 ログインして銀行サービスを利用してください</p>
        </div>
    }
    else if (currentUser != null)
    {
        <!-- 残高セクション -->
        <div class="balance-section">
            <div class="balance-card">
                <h3>💰 手持ギル</h3>
                <p class="gil-amount">@currentUser.Gil.ToString("N0") G</p>
            </div>
            <div class="balance-card">
                <h3>🏦 預金</h3>
                <p class="gil-amount">@currentUser.BankedGil.ToString("N0") G</p>
            </div>
            <div class="balance-card investment">
                <h3>📈 投資中</h3>
                <p class="gil-amount">@stats.TotalInvested.ToString("N0") G</p>
                <small>評価額: @stats.CurrentValue.ToString("N0") G</small>
            </div>
        </div>

        <!-- タブ -->
        <div class="tab-container">
            <button class="tab-button @(currentTab == "bank" ? "active" : "")" @onclick='() => currentTab = "bank"'>
                🏦 預金
            </button>
            <button class="tab-button @(currentTab == "invest" ? "active" : "")" @onclick='() => currentTab = "invest"'>
                📈 投資
            </button>
            <button class="tab-button @(currentTab == "portfolio" ? "active" : "")" @onclick='() => currentTab = "portfolio"'>
                📊 ポートフォリオ
            </button>
        </div>

        @if (currentTab == "bank")
        {
            <!-- 預金タブ -->
            <div class="tab-content">
                <div class="transaction-section">
                    <h3>📥 預け入れ</h3>
                    <div class="input-group">
                        <input type="number" @bind="depositAmount" placeholder="金額" min="1" />
                        <button class="action-button deposit" @onclick="Deposit">預ける</button>
                    </div>
                </div>

                <div class="transaction-section">
                    <h3>📤 引き出し</h3>
                    <div class="input-group">
                        <input type="number" @bind="withdrawAmount" placeholder="金額" min="1" />
                        <button class="action-button withdraw" @onclick="Withdraw">引き出す</button>
                    </div>
                </div>
            </div>
        }
        else if (currentTab == "invest")
        {
            <!-- 投資タブ -->
            <div class="tab-content">
                <div class="investment-products">
                    <h3>📋 投資商品一覧</h3>
                    
                    @foreach (var product in availableProducts)
                    {
                        <div class="product-card">
                            <div class="product-header">
                                <span class="product-icon">@product.Icon</span>
                                <div class="product-info">
                                    <h4>@product.Name</h4>
                                    <p class="product-desc">@product.Description</p>
                                </div>
                            </div>
                            
                            <div class="product-stats">
                                <div class="stat">
                                    <span class="label">期待リターン</span>
                                    <span class="value positive">+@product.BaseReturnRate%</span>
                                </div>
                                <div class="stat">
                                    <span class="label">リスク</span>
                                    <span class="value risk-@product.RiskLevel">
                                        @for (int i = 0; i < product.RiskLevel; i++)
                                        {
                                            <span>⚡</span>
                                        }
                                    </span>
                                </div>
                                <div class="stat">
                                    <span class="label">期間</span>
                                    <span class="value">@($"{product.MinDurationDays}〜{product.MaxDurationDays}日")</span>
                                </div>
                                <div class="stat">
                                    <span class="label">投資額</span>
                                    <span class="value">@product.MinInvestment〜@product.MaxInvestment G</span>
                                </div>
                            </div>
                            
                            <div class="product-action">
                                <input type="number" placeholder="投資額" @bind="investmentAmounts[product.Id]" min="@product.MinInvestment" max="@product.MaxInvestment" />
                                <select @bind="investmentDurations[product.Id]">
                                    @for (int d = product.MinDurationDays; d <= product.MaxDurationDays; d++)
                                    {
                                        <option value="@d">@($"{d}日")</option>
                                    }
                                </select>
                                <button class="invest-button" @onclick="() => Invest(product.Id)">
                                    投資する
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (currentTab == "portfolio")
        {
            <!-- ポートフォリオタブ -->
            <div class="tab-content">
                <div class="portfolio-stats">
                    <div class="stat-card">
                        <h4>投資中</h4>
                        <p>@stats.ActiveInvestments 件</p>
                    </div>
                    <div class="stat-card">
                        <h4>満期待ち</h4>
                        <p>@stats.MaturedInvestments 件</p>
                    </div>
                    <div class="stat-card">
                        <h4>総リターン</h4>
                        <p class="@(stats.TotalReturns >= 0 ? "positive" : "negative")">
                            @stats.TotalReturns.ToString("+#,##0;-#,##0;0") G
                        </p>
                    </div>
                </div>

                @if (userInvestments.Any())
                {
                    <div class="investments-list">
                        <h3>📊 投資一覧</h3>
                        
                        @foreach (var inv in userInvestments.OrderByDescending(i => i.InvestedAt))
                        {
                            var product = InvestmentDatabase.GetProduct(inv.ProductId);
                            var returnRate = (int)((double)inv.CurrentValue / inv.InvestedAmount * 100) - 100;
                            var daysRemaining = (inv.MaturesAt - DateTime.UtcNow).Days;
                            
                            <div class="investment-card @(inv.Status.ToString().ToLower())">
                                <div class="investment-header">
                                    <span class="investment-icon">@product?.Icon</span>
                                    <div class="investment-info">
                                        <h4>@product?.Name</h4>
                                        <span class="status-badge @inv.Status.ToString().ToLower()">
                                            @GetStatusText(inv.Status)
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="investment-details">
                                    <div class="detail">
                                        <span class="label">投資額</span>
                                        <span class="value">@inv.InvestedAmount.ToString("N0") G</span>
                                    </div>
                                    <div class="detail">
                                        <span class="label">現在価値</span>
                                        <span class="value @(returnRate >= 0 ? "positive" : "negative")">
                                            @inv.CurrentValue.ToString("N0") G
                                        </span>
                                    </div>
                                    <div class="detail">
                                        <span class="label">リターン</span>
                                        <span class="value @(returnRate >= 0 ? "positive" : "negative")">
                                            @returnRate.ToString("+#,##0;-#,##0;0")%
                                        </span>
                                    </div>
                                    @if (inv.Status == InvestmentStatus.Active)
                                    {
                                        <div class="detail">
                                            <span class="label">残り日数</span>
                                            <span class="value">@daysRemaining 日</span>
                                        </div>
                                    }
                                </div>
                                
                                <div class="investment-action">
                                    @if (inv.Status == InvestmentStatus.Matured)
                                    {
                                        <button class="claim-button" @onclick="() => ClaimInvestment(inv.Id)">
                                            💰 受け取る
                                        </button>
                                    }
                                    else if (inv.Status == InvestmentStatus.Active)
                                    {
                                        <button class="liquidate-button" @onclick="() => LiquidateInvestment(inv.Id)">
                                            ⚠️ 早期清算
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-investments">
                        <p>まだ投資していません</p>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="message @messageType">@message</div>
        }
    }

    <div class="back-section">
        <button class="back-button" @onclick="GoBack">← 街へ戻る</button>
    </div>
</div>

