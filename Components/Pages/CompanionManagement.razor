</style>

@code {
    private User? user;
    private List<Companion> companions = new();
    private List<Companion> partyMembers = new();
    private List<Companion> availableCompanions = new();
    private int partyPower;
    private int maxCompanions = 10;
    private int currentTab = 0;
    
    private Job? selectedJob;
    private Companion? selectedCompanion;
    private Companion? hiredCompanion;
    private bool showHireDialog = false;
    
    private List<UniqueCharacterTemplate> uniqueCharacters = new();
    
    private readonly List<(Job Key, string DisplayName, string Icon)> availableJobs = new()
    {
        (Job.Warrior, "戦士", "⚔️"),
        (Job.Monk, "モンク", "🧘"),
        (Job.WhiteMage, "白魔道士", "✨"),
        (Job.BlackMage, "黒魔道士", "🔮"),
        (Job.Thief, "盗賊", "🗡️"),
        (Job.Paladin, "パラディン", "🛡️"),
        (Job.Ranger, "レンジャー", "🏹"),
        (Job.DarkKnight, "暗黒騎士", "🌑"),
        (Job.Ninja, "忍者", "🥷"),
        (Job.Bard, "吟遊詩人", "🎵"),
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        uniqueCharacters = CompanionService.GetAvailableUniqueCharacters();
    }

    private async Task LoadData()
    {
        var username = await GetUsername();
        if (string.IsNullOrEmpty(username)) return;
        
        user = UserService.GetUser(username);
        companions = CompanionService.GetUserCompanions(username);
        partyMembers = CompanionService.GetPartyMembers(username);
        availableCompanions = companions.Where(c => !c.IsInParty).ToList();
        partyPower = CompanionService.CalculatePartyPower(username);
        maxCompanions = user?.MaxCompanions ?? 10;
    }

    private async Task<string?> GetUsername()
    {
        // まずセッションから取得を試みる
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.Session != null)
        {
            var username = httpContext.Session.GetString("username");
            if (!string.IsNullOrEmpty(username)) return username;
        }
        
        // フォールバック: 最初のユーザーを取得（テスト用）
        var users = UserService.GetAllUsers().ToList();
        return users.FirstOrDefault()?.Username;
    }

    private string GetRarityClass(CompanionRarity rarity)
    {
        return rarity.ToString().ToLower();
    }

    private string GetJobDisplayName(Job job)
    {
        var found = availableJobs.FirstOrDefault(j => j.Key == job);
        return found.DisplayName ?? job.ToString();
    }

    private async Task AddToParty(int companionId)
    {
        var username = await GetUsername();
        if (string.IsNullOrEmpty(username)) return;
        
        if (CompanionService.AddToParty(username, companionId))
        {
            await LoadData();
        }
    }

    private async Task RemoveFromParty(int companionId)
    {
        var username = await GetUsername();
        if (string.IsNullOrEmpty(username)) return;
        
        if (CompanionService.RemoveFromParty(username, companionId))
        {
            await LoadData();
        }
    }

    private void SelectCompanion(Companion companion)
    {
        selectedCompanion = companion;
    }

    private async Task HireMercenary()
    {
        var username = await GetUsername();
        if (string.IsNullOrEmpty(username) || !selectedJob.HasValue) return;
        
        // ユーザーのギルを確認
        if (user == null || user.Gil < 100)
        {
            return;
        }
        
        // 雇用
        var companion = CompanionService.HireMercenary(username, selectedJob.Value);
        if (companion != null)
        {
            // ギルを引く
            user.Gil -= companion.HireCost;
            UserService.UpdateUser(user);
            
            hiredCompanion = companion;
            showHireDialog = true;
            await LoadData();
        }
    }

    private async Task HireUnique(string uniqueName)
    {
        var username = await GetUsername();
        if (string.IsNullOrEmpty(username)) return;
        
        var template = uniqueCharacters.FirstOrDefault(u => u.Name == uniqueName);
        if (template == null) return;
        
        // ユーザーのギルを確認
        if (user == null || user.Gil < template.HireCost)
        {
            return;
        }
        
        // 雇用
        var companion = CompanionService.HireUniqueCharacter(username, uniqueName);
        if (companion != null)
        {
            // ギルを引く
            user.Gil -= companion.HireCost;
            UserService.UpdateUser(user);
            
            hiredCompanion = companion;
            showHireDialog = true;
            await LoadData();
        }
    }
}
