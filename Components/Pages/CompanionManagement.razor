@page "/companion"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject Services.UserService UserService
@inject Services.CompanionService CompanionService
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>仲間管理 - FFA</PageTitle>

<div class="companion-container">
    <h1 class="page-title">👥 仲間管理</h1>
    
    <div class="status-bar">
        <span class="status-item">所持数: @companions.Count / @maxCompanions</span>
        <span class="status-item">パーティ戦闘力: @partyPower</span>
        <span class="status-item">💰 @user?.Gil.ToString("N0") ギル</span>
    </div>

    <!-- タブ -->
    <div class="tabs">
        <button class="tab-button @(currentTab == 0 ? "active" : "")" @onclick="() => currentTab = 0">パーティ編成</button>
        <button class="tab-button @(currentTab == 1 ? "active" : "")" @onclick="() => currentTab = 1">傭兵雇用</button>
        <button class="tab-button @(currentTab == 2 ? "active" : "")" @onclick="() => currentTab = 2">仲間詳細</button>
    </div>

    @if (currentTab == 0)
    {
        <!-- パーティ編成タブ -->
        <div class="tab-content">
            <div class="party-section">
                <h2>現在のパーティ (最大3体)</h2>
                @if (partyMembers.Count > 0)
                {
                    <div class="party-list">
                        @foreach (var member in partyMembers)
                        {
                            <div class="companion-card @GetRarityClass(member.Rarity)">
                                <div class="card-header">
                                    <span class="companion-icon">@member.Icon</span>
                                    <div class="companion-info">
                                        <span class="companion-name">
                                            @if (member.IsUnique)
                                            {
                                                <span class="unique-title">[@member.UniqueTitle]</span>
                                            }
                                            @member.Name
                                        </span>
                                        <span class="companion-level">Lv.@member.Level @member.JobName</span>
                                    </div>
                                    <button class="remove-btn" @onclick="() => RemoveFromParty(member.Id)">外す</button>
                                </div>
                                <div class="card-stats">
                                    <div class="stat-row">
                                        <span>HP: @member.CurrentHP / @member.MaxHP</span>
                                        <div class="progress-bar">
                                            <div class="progress-fill hp" style="width: @((double)member.CurrentHP / member.MaxHP * 100)%"></div>
                                        </div>
                                    </div>
                                    <div class="stat-icons">
                                        <span>⚔️@member.Attack</span>
                                        <span>🛡️@member.Defense</span>
                                        <span>✨@member.Magic</span>
                                        <span>💨@member.Speed</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="no-members">パーティメンバーがいません。仲間を追加してください。</p>
                }
            </div>

            <div class="available-section">
                <h2>所持仲間</h2>
                @if (availableCompanions.Count > 0)
                {
                    <div class="available-list">
                        @foreach (var companion in availableCompanions)
                        {
                            <div class="companion-card small @GetRarityClass(companion.Rarity)">
                                <div class="card-header">
                                    <span class="companion-icon">@companion.Icon</span>
                                    <div class="companion-info">
                                        <span class="companion-name">
                                            @if (companion.IsUnique)
                                            {
                                                <span class="unique-title">[@companion.UniqueTitle]</span>
                                            }
                                            @companion.Name
                                        </span>
                                        <span class="companion-level">Lv.@companion.Level @companion.JobName</span>
                                    </div>
                                    <button class="add-btn" @onclick="() => AddToParty(companion.Id)" disabled="@(partyMembers.Count >= 3)">追加</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="no-members">他の仲間がいません。傭兵を雇用してください。</p>
                }
            </div>
        </div>
    }
    else if (currentTab == 1)
    {
        <!-- 傭兵雇用タブ -->
        <div class="tab-content">
            <div class="info-box">
                <p>傭兵を雇用してパーティを強化しましょう。レアリティが高いほど強力ですが、雇用費と日当も高くなります。</p>
            </div>

            <div class="job-selection">
                <h3>職業を選択</h3>
                <div class="job-grid">
                    @foreach (var job in availableJobs)
                    {
                        <div class="job-card @(selectedJob == job.Key ? "selected" : "")" @onclick="() => selectedJob = job.Key">
                            <span class="job-icon">@job.Icon</span>
                            <span class="job-name">@job.DisplayName</span>
                        </div>
                    }
                </div>
            </div>

            <div class="hire-section">
                <div class="hire-info">
                    <span>選択職業: @(selectedJob.HasValue ? GetJobDisplayName(selectedJob.Value) : "未選択")</span>
                    <span>雇用費: 100〜2000ギル / 日当: 10〜85ギル</span>
                </div>
                <button class="hire-btn" @onclick="HireMercenary" disabled="@(!selectedJob.HasValue)">傭兵を雇用</button>
            </div>

            <div class="unique-section">
                <h3>⭐ ユニークキャラクター</h3>
                <p class="section-desc">強力なスキルを持つ特別なキャラクター。高額ですが戦力になります。</p>
                <div class="unique-grid">
                    @foreach (var unique in uniqueCharacters)
                    {
                        <div class="unique-card @GetRarityClass(unique.Rarity)">
                            <div class="unique-header">
                                <span class="unique-icon">@unique.Icon</span>
                                <div class="unique-info">
                                    <span class="unique-name">@unique.Name</span>
                                    <span class="unique-title-text">@unique.Title</span>
                                </div>
                            </div>
                            <p class="unique-desc">@unique.Description</p>
                            <div class="unique-stats">
                                <span>HP:@unique.BaseHP</span>
                                <span>⚔️@unique.BaseAttack</span>
                                <span>🛡️@unique.BaseDefense</span>
                                <span>✨@unique.BaseMagic</span>
                            </div>
                            @if (!string.IsNullOrEmpty(unique.UniqueSkillName))
                            {
                                <div class="unique-skill">🌟 @unique.UniqueSkillName</div>
                            }
                            <div class="unique-footer">
                                <span class="hire-cost">雇用費: @unique.HireCost.ToString("N0")ギル</span>
                                <button class="hire-unique-btn" @onclick="() => HireUnique(unique.Name)">雇用</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (currentTab == 2)
    {
        <!-- 仲間詳細タブ -->
        <div class="tab-content">
            @if (selectedCompanion != null)
            {
                <div class="detail-view">
                    <div class="detail-header @GetRarityClass(selectedCompanion.Rarity)">
                        <span class="detail-icon">@selectedCompanion.Icon</span>
                        <div class="detail-info">
                            <h2>
                                @if (selectedCompanion.IsUnique)
                                {
                                    <span class="unique-title">[@selectedCompanion.UniqueTitle]</span>
                                }
                                @selectedCompanion.Name
                            </h2>
                            <p>Lv.@selectedCompanion.Level @selectedCompanion.JobName</p>
                            <span class="rarity-badge @GetRarityClass(selectedCompanion.Rarity)">@selectedCompanion.Rarity</span>
                        </div>
                    </div>
                    
                    <div class="detail-stats">
                        <h3>ステータス</h3>
                        <div class="stat-grid">
                            <div class="stat-item-detail">
                                <span class="stat-label">HP</span>
                                <span class="stat-value">@selectedCompanion.CurrentHP / @selectedCompanion.MaxHP</span>
                                <div class="progress-bar">
                                    <div class="progress-fill hp" style="width: @((double)selectedCompanion.CurrentHP / selectedCompanion.MaxHP * 100)%"></div>
                                </div>
                            </div>
                            <div class="stat-item-detail">
                                <span class="stat-label">経験値</span>
                                <span class="stat-value">@selectedCompanion.Experience / @selectedCompanion.ExpToNextLevel</span>
                                <div class="progress-bar">
                                    <div class="progress-fill exp" style="width: @((double)selectedCompanion.Experience / selectedCompanion.ExpToNextLevel * 100)%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-box">
                                <span class="stat-icon">⚔️</span>
                                <span class="stat-num">@selectedCompanion.Attack</span>
                                <span class="stat-label">攻撃力</span>
                            </div>
                            <div class="stat-box">
                                <span class="stat-icon">🛡️</span>
                                <span class="stat-num">@selectedCompanion.Defense</span>
                                <span class="stat-label">防御力</span>
                            </div>
                            <div class="stat-box">
                                <span class="stat-icon">✨</span>
                                <span class="stat-num">@selectedCompanion.Magic</span>
                                <span class="stat-label">魔力</span>
                            </div>
                            <div class="stat-box">
                                <span class="stat-icon">💨</span>
                                <span class="stat-num">@selectedCompanion.Speed</span>
                                <span class="stat-label">素早さ</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-skills">
                        <h3>スキル</h3>
                        <div class="skill-list">
                            @foreach (var skill in selectedCompanion.Skills)
                            {
                                <div class="skill-chip">
                                    <span class="skill-icon">@skill.Icon</span>
                                    <span class="skill-name">@skill.Name</span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (selectedCompanion.UniqueSkill != null)
                    {
                        <div class="unique-skill-box">
                            <h3>ユニークスキル</h3>
                            <div class="unique-skill-detail">
                                <span class="skill-icon">@selectedCompanion.UniqueSkill.Icon</span>
                                <span class="skill-name">@selectedCompanion.UniqueSkill.Name</span>
                            </div>
                            <p class="skill-desc">@selectedCompanion.UniqueSkill.Description</p>
                            <p class="skill-stats">威力: @selectedCompanion.UniqueSkill.Power / 消費MP: @selectedCompanion.UniqueSkill.MPCost</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="no-selection">詳細を見る仲間を選択してください。</p>
                <div class="companion-select-list">
                    @foreach (var companion in companions)
                    {
                        <div class="companion-card small @GetRarityClass(companion.Rarity)" @onclick="() => SelectCompanion(companion)">
                            <span class="companion-icon">@companion.Icon</span>
                            <span class="companion-name">@companion.Name</span>
                            <span class="companion-level">Lv.@companion.Level</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- 雇用結果ダイアログ -->
@if (showHireDialog)
{
    <div class="dialog-overlay" @onclick="() => showHireDialog = false">
        <div class="dialog" @onclick:stopPropagation="true">
            <h3>傭兵を雇用しました！</h3>
            @if (hiredCompanion != null)
            {
                <div class="hired-result @GetRarityClass(hiredCompanion.Rarity)">
                    <span class="hired-icon">@hiredCompanion.Icon</span>
                    <div class="hired-info">
                        <span class="hired-name">@hiredCompanion.Name</span>
                        <span class="hired-level">Lv.@hiredCompanion.Level @hiredCompanion.JobName</span>
                        <span class="rarity-badge @GetRarityClass(hiredCompanion.Rarity)">@hiredCompanion.Rarity</span>
                    </div>
                </div>
            }
            <button class="dialog-close-btn" @onclick="() => showHireDialog = false">閉じる</button>
        </div>
    </div>
}

