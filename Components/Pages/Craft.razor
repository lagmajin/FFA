@page "/craft"
@using FFA.Models
@using FFA.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject UserService UserService
@inject CraftService CraftService
@inject StaminaService StaminaService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>クラフト - FFA</PageTitle>

<div class="craft-container">
    <h1>⚒️ クラフト</h1>

    @if (!isLoggedIn)
    {
        <div class="login-prompt">
            <p>クラフトを行うにはログインしてください。</p>
            <button class="btn-primary" @onclick='() => Navigation.NavigateTo("/login")'>ログイン</button>
        </div>
    }
    else
    {
        <div class="stamina-bar">
            <span>🍡 スタミナ: @currentStamina / @maxStamina</span>
            @if (nextRecovery.HasValue)
            {
                <span class="next-recovery"> 回復: @nextRecovery.Value.ToString("HH:mm")</span>
            }
        </div>

        <div class="category-tabs">
            <button class="tab-btn @(selectedCategory == null ? "active" : "")" @onclick="() => SelectCategory(null)">
                すべて
            </button>
            <button class="tab-btn @(selectedCategory == CraftCategory.Weapon ? "active" : "")" @onclick="() => SelectCategory(CraftCategory.Weapon)">
                武器
            </button>
            <button class="tab-btn @(selectedCategory == CraftCategory.Armor ? "active" : "")" @onclick="() => SelectCategory(CraftCategory.Armor)">
                防具
            </button>
            <button class="tab-btn @(selectedCategory == CraftCategory.Consumable ? "active" : "")" @onclick="() => SelectCategory(CraftCategory.Consumable)">
                消耗品
            </button>
            <button class="tab-btn @(selectedCategory == CraftCategory.Cooking ? "active" : "")" @onclick="() => SelectCategory(CraftCategory.Cooking)">
                料理
            </button>
        </div>

        @if (!string.IsNullOrEmpty(resultMessage))
        {
            <div class="result-message @resultClass">
                @resultMessage
                @if (expGained > 0)
                {
                    <span class="exp-gained"> (+@expGained 経験値)</span>
                }
            </div>
        }

        <div class="recipes-grid">
            @foreach (var recipe in filteredRecipes)
            {
                <div class="recipe-card @GetRarityClass(recipe.Rarity)">
                    <div class="recipe-header">
                        <h3>@recipe.Name</h3>
                        <span class="success-rate">成功率: @(recipe.SuccessRate * 100)%</span>
                    </div>
                    
                    <p class="recipe-description">@recipe.Description</p>
                    
                    <div class="recipe-result">
                        <strong>作成結果:</strong>
                        <span class="result-item">
                            @recipe.ResultItem.ItemName x@recipe.ResultItem.Quantity
                            (@GetItemStats(recipe))
                        </span>
                    </div>

                    <div class="required-materials">
                        <strong>必要素材:</strong>
                        <ul>
                            @foreach (var material in recipe.RequiredMaterials)
                            {
                                <li class="@GetMaterialClass(material)">
                                    @material.MaterialName x@material.Quantity
                                    (@GetPlayerMaterialCount(material.MaterialName))
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="required-gold">
                        <strong>必要ゴールド:</strong>
                        <span class="@(HasEnoughGold(recipe.RequiredGil) ? "enough" : "not-enough")">
                            @recipe.RequiredGil G
                        </span>
                    </div>

                    <div class="recipe-footer">
                        <span class="craft-level">必要Lv: @recipe.RequiredCraftLevel</span>
                        <span class="exp-reward">経験値: +@recipe.ExpReward</span>
                    </div>

                    <div class="craft-actions">
                        <input type="number" min="1" max="10" @bind="craftQuantity" class="quantity-input" />
                        <button class="btn-craft" 
                                @onclick="() => CraftItem(recipe.Id)"
                                disabled="@(!CanCraft(recipe))">
                            作成
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (!filteredRecipes.Any())
        {
            <div class="no-recipes">
                <p>このカテゴリにレシピがありません。</p>
            </div>
        }
    }
</div>

@code {
    private bool isLoggedIn = false;
    private User? currentUser;
    private string? currentUsername;
    private List<CraftRecipe> allRecipes = new();
    private CraftCategory? selectedCategory;
    private int craftQuantity = 1;
    private int currentStamina = 100;
    private int maxStamina = 100;
    private DateTime? nextRecovery;
    
    private string resultMessage = "";
    private string resultClass = "";
    private int expGained = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserAsync();
        await LoadRecipesAsync();
    }

    private async Task LoadUserAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUsername = state.User?.Identity?.Name;
            
            if (!string.IsNullOrEmpty(currentUsername))
            {
                isLoggedIn = true;
                currentUser = UserService.GetByUsername(currentUsername);
                
                if (currentUser != null)
                {
                    var staminaInfo = StaminaService.GetStaminaInfo(currentUsername);
                    if (staminaInfo.Status.TryGetValue(StaminaType.Crafting, out var craftingStatus))
                    {
                        currentStamina = craftingStatus.Current;
                        maxStamina = craftingStatus.Max;
                        nextRecovery = craftingStatus.NextRecovery;
                    }
                }
            }
        }
        catch
        {
            isLoggedIn = false;
        }
    }

    private async Task LoadRecipesAsync()
    {
        allRecipes = await Task.Run(() => CraftService.GetAllRecipes());
    }

    private List<CraftRecipe> filteredRecipes
    {
        get
        {
            if (selectedCategory == null)
                return allRecipes;
            return allRecipes.Where(r => r.Category == selectedCategory).ToList();
        }
    }

    private void SelectCategory(CraftCategory? category)
    {
        selectedCategory = category;
        resultMessage = "";
    }

    private async Task CraftItem(int recipeId)
    {
        if (currentUser == null) return;

        resultMessage = "";
        
        var result = await Task.Run(() => CraftService.Craft(currentUser.Id, recipeId, craftQuantity));
        
        if (result.IsSuccess)
        {
            resultClass = "success";
            resultMessage = result.Message ?? "作成成功！";
            expGained = result.ExpGained;
        }
        else
        {
            resultClass = result.Message?.Contains("失敗") == true ? "failure" : "error";
            resultMessage = result.Message ?? "エラーが発生しました。";
            expGained = result.ExpGained;
        }

        await LoadUserAsync();
        craftQuantity = 1;
    }

    private bool CanCraft(CraftRecipe recipe)
    {
        if (currentUser == null) return false;
        if (currentStamina < craftQuantity) return false;
        if (currentUser.Gil < recipe.RequiredGil * craftQuantity) return false;

        foreach (var material in recipe.RequiredMaterials)
        {
            int required = material.Quantity * craftQuantity;
            int have = GetPlayerMaterialCount(material.MaterialName);
            if (have < required) return false;
        }

        return true;
    }

    private int GetPlayerMaterialCount(string materialName)
    {
        if (currentUser?.Inventory == null) return 0;
        
        var item = currentUser.Inventory.FirstOrDefault(i => 
            i.Name == materialName && 
            (i.Type == "Material" || i.Type == "Fish" || i.Type == "Consumable"));
        
        return item?.Quantity ?? 0;
    }

    private bool HasEnoughGold(int requiredGil)
    {
        return currentUser?.Gil >= requiredGil * craftQuantity;
    }

    private string GetMaterialClass(CraftMaterial material)
    {
        int required = material.Quantity * craftQuantity;
        int have = GetPlayerMaterialCount(material.MaterialName);
        
        if (have >= required) return "enough";
        if (have > 0) return "partial";
        return "not-enough";
    }

    private string GetItemStats(CraftRecipe recipe)
    {
        var stats = new List<string>();
        if (recipe.ResultItem.Attack > 0) stats.Add($"攻撃+{recipe.ResultItem.Attack}");
        if (recipe.ResultItem.Defense > 0) stats.Add($"防御+{recipe.ResultItem.Defense}");
        if (recipe.ResultItem.HealAmount > 0) stats.Add($"HP+{recipe.ResultItem.HealAmount}");
        if (recipe.ResultItem.SellPrice > 0) stats.Add($"売値{recipe.ResultItem.SellPrice}");
        
        return stats.Any() ? string.Join(", ", stats) : "";
    }

    private string GetRarityClass(int rarity)
    {
        return rarity switch
        {
            1 => "rarity-white",
            2 => "rarity-green",
            3 => "rarity-blue",
            4 => "rarity-purple",
            5 => "rarity-red",
            6 => "rarity-orange",
            7 => "rarity-gold",
            8 => "rarity-rainbow",
            _ => "rarity-white"
        };
    }
}
