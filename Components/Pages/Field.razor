@page "/field"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject Services.UserService UserService
@inject Services.FieldService FieldService

<PageTitle>冒険の場所選択</PageTitle>

<div class="field-container">
    <h1 class="field-title">🗺️ 冒険の旅</h1>
    <p class="field-subtitle">探索する場所を選んでください</p>

    @if (currentUser == null)
    {
        <div class="auth-warning">
            <p>🔐 ログインして冒険を始めましょう</p>
            <button class="action-button" @onclick="GoToLogin">ログイン</button>
        </div>
    }
    else
    {
        <div class="player-status">
            <div class="status-item">
                <span class="status-label">プレイヤー</span>
                <span class="status-value">@currentUser.Username</span>
            </div>
            <div class="status-item">
                <span class="status-label">レベル</span>
                <span class="status-value">@(currentUser.Exp / 100 + 1)</span>
            </div>
            <div class="status-item">
                <span class="status-label">HP</span>
                <span class="status-value">@currentUser.HP / @currentUser.MaxHP</span>
            </div>
            <div class="status-item">
                <span class="status-label">ギル</span>
                <span class="status-value">@currentUser.Gil G</span>
            </div>
        </div>

        <div class="field-list">
            @foreach (var field in fields)
            {
                <div class="field-card" @onclick="() => GoToBattle(field.Id)">
                    <div class="field-header">
                        <span class="field-icon">@GetFieldIcon(field.Difficulty)</span>
                        <div class="field-title-area">
                            <h3>@field.Name</h3>
                            <div class="field-difficulty">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <span class="star @(i < field.Difficulty ? "active" : "")">★</span>
                                }
                            </div>
                        </div>
                    </div>
                    <p class="field-description">@field.Description</p>
                    <div class="field-info">
                        <div class="info-item">
                            <span class="info-label">推奨Lv</span>
                            <span class="info-value">@(field.Difficulty * 5)</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">敵数</span>
                            <span class="info-value">@field.Enemies.Length 種類</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">ドロップ</span>
                            <span class="info-value">@field.Drops.Length 種類</span>
                        </div>
                    </div>
                    <div class="field-enemies">
                        @foreach (var enemy in field.Enemies.Take(3))
                        {
                            <span class="enemy-tag">@GetEnemyIcon(enemy) @enemy</span>
                        }
                        @if (field.Enemies.Length > 3)
                        {
                            <span class="enemy-tag more">+@(field.Enemies.Length - 3)</span>
                        }
                    </div>
                    <button class="explore-btn">
                        🔍 探索する
                    </button>
                </div>
            }
        </div>
    }
</div>

<style>
    .field-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
    }
    
    .field-title {
        text-align: center;
        color: var(--mud-palette-primary);
        margin-bottom: 5px;
    }
    
    .field-subtitle {
        text-align: center;
        color: var(--mud-palette-text-secondary);
        margin-bottom: 20px;
    }
    
    .auth-warning {
        text-align: center;
        padding: 40px;
        background: var(--mud-palette-surface);
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .player-status {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 20px;
        padding: 15px;
        background: var(--mud-palette-surface);
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .status-item {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    
    .status-label {
        font-size: 0.8em;
        color: var(--mud-palette-text-secondary);
    }
    
    .status-value {
        font-weight: bold;
        color: var(--mud-palette-primary);
    }
    
    .field-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }
    
    .field-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-divider);
        border-radius: 12px;
        padding: 20px;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .field-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    }
    
    .field-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 10px;
    }
    
    .field-icon {
        font-size: 2.5rem;
    }
    
    .field-title-area h3 {
        margin: 0;
        color: var(--mud-palette-text-primary);
    }
    
    .field-difficulty {
        margin-top: 5px;
    }
    
    .star {
        color: #ddd;
        font-size: 0.9em;
    }
    
    .star.active {
        color: #ffd700;
    }
    
    .field-description {
        color: var(--mud-palette-text-secondary);
        font-size: 0.9em;
        margin-bottom: 15px;
        line-height: 1.4;
    }
    
    .field-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
        padding: 10px;
        background: rgba(0,0,0,0.05);
        border-radius: 8px;
    }
    
    .info-item {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    
    .info-label {
        font-size: 0.75em;
        color: var(--mud-palette-text-secondary);
    }
    
    .info-value {
        font-weight: bold;
        font-size: 0.9em;
    }
    
    .field-enemies {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-bottom: 15px;
    }
    
    .enemy-tag {
        padding: 3px 8px;
        background: rgba(0,0,0,0.1);
        border-radius: 4px;
        font-size: 0.8em;
    }
    
    .enemy-tag.more {
        background: var(--mud-palette-primary);
        color: white;
    }
    
    .explore-btn {
        width: 100%;
        padding: 12px;
        background: var(--mud-palette-primary);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s;
    }
    
    .explore-btn:hover {
        background: var(--mud-palette-primary-dark);
    }
    
    .action-button {
        padding: 10px 20px;
        background: var(--mud-palette-primary);
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }
</style>

@code {
    private User? currentUser;
    private List<Models.Field> fields = new();

    protected override void OnInitialized()
    {
        fields = FieldService.GetAllFields();
        currentUser = UserService.GetAllUsers().FirstOrDefault();
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void GoToBattle(int fieldId)
    {
        Navigation.NavigateTo($"/battle/{fieldId}");
    }
    
    private string GetFieldIcon(int difficulty)
    {
        return difficulty switch
        {
            1 => "🌿",
            2 => "🌲",
            3 => "🏜️",
            4 => "🏔️",
            5 => "🌋",
            _ => "🗺️"
        };
    }
    
    private string GetEnemyIcon(string enemyName)
    {
        return enemyName switch
        {
            "スライム" => "🟢",
            "ウサギ" => "🐰",
            "蝶" => "🦋",
            "ゴブリン" => "👺",
            "狼" or "ウolf" => "🐺",
            "毒キノコ" => "🍄",
            "水.Elemental" => "💧",
            "魚人" => "🐟",
            "アシガエル" => "🐸",
            "サソリ" => "🦂",
            "トカゲ" => "🦎",
            "ミイラ" => "🧟",
            "雪だるま" => "⛄",
            "冰ゴーレム" => "🧊",
            "白狼" => "🐺",
            "溶岩ゴーレム" => "🔥",
            "火織" => "🔥",
            "炎 Elemental" => "🔥",
            "スケルトン" => "💀",
            "リッチ" => "👻",
            "オーク" => "👹",
            _ => "👾"
        };
    }
}
