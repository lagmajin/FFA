@page "/dashboard"
@rendermode InteractiveServer

@using FFA.Services
@using FFA.Models
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject KarmaService Karma
@inject TimeWeatherService TimeWeather
@inject UserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject WorldGridService WorldGrid
@inject Services.TownService TownService

<PageTitle>ダッシュボード</PageTitle>

<div class="dashboard-container" style="display:flex; justify-content:center;">
    <div class="dashboard-content" style="max-width:1200px; width:100%;">
    @if (!isAuth)
    {
        <div class="auth-required">
            <p>ログインしてください。</p>
        </div>
    }
    else
    {
        @* ヘッダー *@
        <div class="dashboard-header">
            <div class="user-welcome">
                <h1>おかえりなさい、<span class="username">@username</span>さん</h1>
            </div>
            <div class="time-weather">
                <div class="tw-display @TimeWeather.Phase.ToString().ToLower()">
                    <span class="tw-icon">@GetTimeIcon(TimeWeather.Phase)</span>
                    <span class="tw-time">@timeStr</span>
                    <span class="tw-weather">@TimeWeather.Weather</span>
                </div>
            </div>
        </div>

        @* メインレイアウト: 左側(コンテンツ) + 右側(アクションボタン) *@
        <div class="dashboard-main-layout" style="display:flex; gap:16px; align-items:flex-start;">
            @* 左側: プレイヤーカードと位置情報 *@
            <div class="dashboard-main-content" style="flex:1;">
                @* プレイヤーステータス *@
                <div class="player-card">
                    <div class="player-header">
                        <div class="player-avatar">
                            <span class="avatar-icon">🧙</span>
                        </div>
                        <div class="player-info">
                            <h2>@username</h2>
                            <div class="player-badges">
                                <span class="badge job">@GetJobName(job)</span>
                                <span class="badge level">Lv.@level</span>
                                <span class="badge karma" title="Karma">@karma</span>
                            </div>
                        </div>
                        <div class="player-currency">
                            <div class="currency-item gold">
                                <span class="currency-icon">💰</span>
                                <span class="currency-value">@gil.ToString("N0")</span>
                            </div>
                            <div class="currency-item">
                                <span class="currency-icon">🪙</span>
                                <span class="currency-value">@oldcoin</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="player-stats-bars">
                        <div class="stat-bar hp-bar">
                            <div class="bar-label">
                                <span>HP</span>
                                <span class="bar-value">@(user?.HP ?? 0) / @(user?.MaxHP ?? 0)</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill hp" style="width: @GetHpPercent()%"></div>
                            </div>
                        </div>
                        <div class="stat-bar exp-bar">
                            <div class="bar-label">
                                <span>EXP</span>
                                <span class="bar-value">@(user?.Exp ?? 0) / @(user?.ExpToNext ?? 1)</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill exp" style="width: @GetExpPercent()%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="player-attributes">
                        <div class="attr">
                            <span class="attr-label">STR</span>
                            <span class="attr-value">@(status?.Str ?? 0)</span>
                        </div>
                        <div class="attr">
                            <span class="attr-label">DEX</span>
                            <span class="attr-value">@(status?.Dex ?? 0)</span>
                        </div>
                        <div class="attr">
                            <span class="attr-label">INT</span>
                            <span class="attr-value">@(status?.Int ?? 0)</span>
                        </div>
                        <div class="attr">
                            <span class="attr-label">VIT</span>
                            <span class="attr-value">@(status?.Vit ?? 0)</span>
                        </div>
                    </div>
                </div>

                @* 位置情報 *@
                <div class="location-info">
                    <div class="location-card">
                        <span class="location-icon">📍</span>
                        <div class="location-details">
                            <span class="location-label">現在地</span>
                            <span class="location-value">@GetLocationName()</span>
                            <span class="location-coords">(@currentX, @currentY)</span>
                        </div>
                    </div>
                    <div class="ip-info">
                        <span class="ip-label">最終ログインIP</span>
                        <span class="ip-value">@user?.LastIp</span>
                    </div>
                </div>
            </div>

            @* 右側: アクションボタン *@
            <div class="dashboard-actions-panel" style="width:200px; flex-shrink:0;">
                <h3 style="margin:0 0 12px 0; font-size:14px; color:#666;">アクション</h3>
                <div class="action-buttons" style="display:flex; flex-direction:column; gap:8px;">
                    @if (showTownButton)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" 
                                   OnClick="GoToTown" StartIcon="@Icons.Material.Filled.Home">
                            🏠 街へ
                        </MudButton>
                    }
                    else if (showFieldButton)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" 
                                   OnClick="GoToField" StartIcon="@Icons.Material.Filled.Forest">
                            🌲 フィールド
                        </MudButton>
                    }
                    else
                    {
                        @* 未定義位置の場合は救済策として街へ *@
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" 
                                   OnClick="RescueToTown" StartIcon="@Icons.Material.Filled.Help">
                            🆘 街へ
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true" 
                               OnClick="GoToStatus" StartIcon="@Icons.Material.Filled.Analytics">
                        📊 ステータス
                    </MudButton>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isAuth = false;
    private string? username;
    private int karma = 0;
    private int gil = 0;
    private int oldcoin = 0;
    private string job = "";
    private int level = 1;
    private PlayerStatus status = new PlayerStatus();
    private User? user;
    private DotNetObjectReference<Dashboard>? objRef;
    private IJSObjectReference? moduleRef;
    private bool showTownButton = true;
    private bool showFieldButton = true;
    private int currentX = 0;
    private int currentY = 0;
    private string currentLocationName = "不明";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var auth = state.User;
        isAuth = auth?.Identity?.IsAuthenticated ?? false;
        username = auth?.Identity?.Name;
        if (isAuth && username != null)
        {
            karma = Karma.GetKarma(username);
            var authCopy = auth;
            gil = int.TryParse(authCopy?.FindFirst("Gil")?.Value, out var g) ? g : 0;
            oldcoin = int.TryParse(authCopy?.FindFirst("OldCoin")?.Value, out var o) ? o : 0;
            job = authCopy?.FindFirst("Job")?.Value ?? "";
            level = int.TryParse(authCopy?.FindFirst("Level")?.Value, out var lv) ? lv : 1;
            user = UserService.GetByUsername(username);
            if (user?.Status != null) status = user.Status;
            if (user != null) level = user.Level;
            
            try
            {
                var pos = WorldGrid.GetOrCreatePlayerPosition(username);
                currentX = pos.X;
                currentY = pos.Y;
                var loc = WorldGrid.GetLocation(currentX, currentY);
                currentLocationName = loc?.Name ?? "フィールド";
                showTownButton = loc?.Type == LocationType.Town;
                showFieldButton = !(loc?.Type == LocationType.Town);
            }
            catch { }
        }
    }

    private string timeStr => FormatTime(TimeWeather.TimeOfDay);

    private string FormatTime(double t)
    {
        int hh = (int)Math.Floor(t);
        int mm = (int)Math.Floor((t - hh) * 60);
        return $"{hh:D2}:{mm:D2}";
    }

    private string GetTimeIcon(FFA.Services.DayPhase phase)
    {
        return phase switch
        {
            FFA.Services.DayPhase.Dawn => "🌅",
            FFA.Services.DayPhase.Day => "☀️",
            FFA.Services.DayPhase.Dusk => "🌆",
            FFA.Services.DayPhase.Night => "🌙",
            _ => "🌤️"
        };
    }

    private string GetJobName(string jobName)
    {
        return jobName switch
        {
            "Warrior" => "戦士",
            "Monk" => "武闘家",
            "WhiteMage" => "白魔道士",
            "BlackMage" => "黒魔道士",
            "Ranger" => "レンジャー",
            "Paladin" => "パラディン",
            "DarkKnight" => "ダークナイト",
            "Bard" => "吟遊詩人",
            "Thief" => "盗賊",
            "Ninja" => "忍者",
            "HolyKnight" => "聖騎士",
            "DeathKnight" => "死騎",
            "ArchMage" => "大魔道師",
            "BeastMaster" => "ビーストマスター",
            "Duelist" => "剣豪",
            "Grandmaster" => "マスター",
            _ => jobName
        };
    }

    private string GetLocationName()
    {
        return currentLocationName;
    }

    private int GetHpPercent()
    {
        if (user == null || user.MaxHP == 0) return 0;
        return (int)((double)user.HP / user.MaxHP * 100);
    }

    private int GetExpPercent()
    {
        if (user == null || user.ExpToNext == 0) return 0;
        return (int)((double)user.Exp / user.ExpToNext * 100);
    }

    [JSInvokable]
    public Task OnWorldUpdated(string json)
    {
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                objRef = DotNetObjectReference.Create(this);
                moduleRef = await JS.InvokeAsync<IJSObjectReference>("import", "/js/worldhub.js");
                await moduleRef.InvokeVoidAsync("start", objRef);
            }
            catch (JSDisconnectedException) { }
            catch (Exception ex)
            {
                Console.WriteLine($"Dashboard OnAfterRenderAsync error: {ex.Message}");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (moduleRef != null)
            {
                await moduleRef.InvokeVoidAsync("stop");
                await moduleRef.DisposeAsync();
            }
        }
        catch { }
        finally
        {
            objRef?.Dispose();
        }
    }

    private void GoToTown()
    {
        Navigation.NavigateTo("/town");
    }

    private void GoToField()
    {
        Navigation.NavigateTo("/field");
    }

    private void GoToDungeon()
    {
        Navigation.NavigateTo("/dungeon");
    }

    private void GoToGuild()
    {
        Navigation.NavigateTo("/guild");
    }

    private void GoToShop()
    {
        Navigation.NavigateTo("/shop");
    }

    private void GoToTavern()
    {
        Navigation.NavigateTo("/tavern");
    }

    private void GoToQuests()
    {
        Navigation.NavigateTo("/quests");
    }

    private void GoToStatus()
    {
        Navigation.NavigateTo("/status");
    }

    private void GoToInventory()
    {
        Navigation.NavigateTo("/inventory");
    }
    
    private void RescueToTown()
    {
        // プレイヤーの所属国の街へランダムで飛ばす救済措置
        try {
            int? countryId = user?.CountryId;
            List<Models.Town> towns;
            
            if (countryId.HasValue)
            {
                towns = TownService.GetTownsByCountryId(countryId.Value);
            }
            else
            {
                towns = TownService.GetAllTowns();
            }
            
            if (towns.Count > 0)
            {
                var random = new Random();
                var randomTown = towns[random.Next(towns.Count)];
                Navigation.NavigateTo($"/town?id={randomTown.Id}");
            }
            else
            {
                Navigation.NavigateTo("/town");
            }
        }
        catch
        {
            Navigation.NavigateTo("/town");
        }
    }
}
</div>
