@page "/dashboard"
@rendermode InteractiveServer

@using FFA.Services
@using FFA.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject KarmaService Karma
@inject TimeWeatherService TimeWeather
@inject UserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject WorldGridService WorldGrid

<PageTitle>ダッシュボード</PageTitle>

<div class="dashboard-container">
    <div class="dashboard-content">
    @if (!isAuth)
    {
        <div class="auth-required">
            <p>ログインしてください。</p>
        </div>
    }
    else
    {
        @* ヘッダー *@
        <div class="dashboard-header">
            <div class="user-welcome">
                <h1>おかえりなさい、<span class="username">@username</span>さん</h1>
            </div>
            <div class="time-weather">
                <div class="tw-display @TimeWeather.Phase.ToString().ToLower()">
                    <span class="tw-icon">@GetTimeIcon(TimeWeather.Phase)</span>
                    <span class="tw-time">@timeStr</span>
                    <span class="tw-weather">@TimeWeather.Weather</span>
                </div>
            </div>
        </div>

        @* プレイヤーステータス *@
        <div class="player-card">
            <div class="player-header">
                <div class="player-avatar">
                    <span class="avatar-icon">🧙</span>
                </div>
                <div class="player-info">
                    <h2>@username</h2>
                    <div class="player-badges">
                        <span class="badge job">@GetJobName(job)</span>
                        <span class="badge level">Lv.@level</span>
                        <span class="badge karma" title="Karma">@karma</span>
                    </div>
                </div>
                <div class="player-currency">
                    <div class="currency-item gold">
                        <span class="currency-icon">💰</span>
                        <span class="currency-value">@gil.ToString("N0")</span>
                    </div>
                    <div class="currency-item">
                        <span class="currency-icon">🪙</span>
                        <span class="currency-value">@oldcoin</span>
                    </div>
                </div>
            </div>
            
            <div class="player-stats-bars">
                <div class="stat-bar hp-bar">
                    <div class="bar-label">
                        <span>HP</span>
                        <span class="bar-value">@(user?.HP ?? 0) / @(user?.MaxHP ?? 0)</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill hp" style="width: @GetHpPercent()%"></div>
                    </div>
                </div>
                <div class="stat-bar exp-bar">
                    <div class="bar-label">
                        <span>EXP</span>
                        <span class="bar-value">@(user?.Exp ?? 0) / @(user?.ExpToNext ?? 1)</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill exp" style="width: @GetExpPercent()%"></div>
                    </div>
                </div>
            </div>

            <div class="player-attributes">
                <div class="attr">
                    <span class="attr-label">STR</span>
                    <span class="attr-value">@(status?.Str ?? 0)</span>
                </div>
                <div class="attr">
                    <span class="attr-label">DEX</span>
                    <span class="attr-value">@(status?.Dex ?? 0)</span>
                </div>
                <div class="attr">
                    <span class="attr-label">INT</span>
                    <span class="attr-value">@(status?.Int ?? 0)</span>
                </div>
                <div class="attr">
                    <span class="attr-label">VIT</span>
                    <span class="attr-value">@(status?.Vit ?? 0)</span>
                </div>
            </div>
        </div>

        @* アクションボタン *@
        <div class="dashboard-actions">
            <div class="action-card town-action" @onclick="GoToTown">
                <span class="action-icon">🏘️</span>
                <span class="action-text">街へ</span>
                <span class="action-desc">施設を使う・装備整える</span>
            </div>
            <div class="action-card field-action" @onclick="GoToField">
                <span class="action-icon">🌲</span>
                <span class="action-text">フィールドへ</span>
                <span class="action-desc">冒険・戦闘・採取</span>
            </div>
            <div class="action-card status-action" @onclick="GoToStatus">
                <span class="action-icon">📊</span>
                <span class="action-text">ステータス</span>
                <span class="action-desc">能力値詳細</span>
            </div>
            <div class="action-card inventory-action" @onclick="GoToInventory">
                <span class="action-icon">🎒</span>
                <span class="action-text">持ち物</span>
                <span class="action-desc">アイテム管理</span>
            </div>
        </div>

        @* 位置情報 *@
        <div class="location-info">
            <div class="location-card">
                <span class="location-icon">📍</span>
                <div class="location-details">
                    <span class="location-label">現在地</span>
                    <span class="location-value">@GetLocationName()</span>
                    <span class="location-coords">(@currentX, @currentY)</span>
                </div>
            </div>
            <div class="ip-info">
                <span class="ip-label">最終ログインIP</span>
                <span class="ip-value">@user?.LastIp</span>
            </div>
        </div>
    }
</div>

@code {
    private bool isAuth = false;
    private string? username;
    private int karma = 0;
    private int gil = 0;
    private int oldcoin = 0;
    private string job = "";
    private int level = 1;
    private PlayerStatus status = new PlayerStatus();
    private User? user;
    private DotNetObjectReference<Dashboard>? objRef;
    private IJSObjectReference? moduleRef;
    private bool showTownButton = true;
    private bool showFieldButton = true;
    private int currentX = 0;
    private int currentY = 0;
    private string currentLocationName = "不明";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var auth = state.User;
        isAuth = auth?.Identity?.IsAuthenticated ?? false;
        username = auth?.Identity?.Name;
        if (isAuth && username != null)
        {
            karma = Karma.GetKarma(username);
            gil = int.TryParse(auth.FindFirst("Gil")?.Value, out var g) ? g : 0;
            oldcoin = int.TryParse(auth.FindFirst("OldCoin")?.Value, out var o) ? o : 0;
            job = auth.FindFirst("Job")?.Value ?? "";
            level = int.TryParse(auth.FindFirst("Level")?.Value, out var lv) ? lv : 1;
            user = UserService.GetByUsername(username);
            if (user?.Status != null) status = user.Status;
            if (user != null) level = user.Level;
            
            try
            {
                var pos = WorldGrid.GetOrCreatePlayerPosition(username);
                currentX = pos.X;
                currentY = pos.Y;
                var loc = WorldGrid.GetLocation(currentX, currentY);
                currentLocationName = loc?.Name ?? "フィールド";
                showTownButton = loc?.Type == LocationType.Town;
                showFieldButton = !(loc?.Type == LocationType.Town);
            }
            catch { }
        }
    }

    private string timeStr => FormatTime(TimeWeather.TimeOfDay);

    private string FormatTime(double t)
    {
        int hh = (int)Math.Floor(t);
        int mm = (int)Math.Floor((t - hh) * 60);
        return $"{hh:D2}:{mm:D2}";
    }

    private string GetTimeIcon(FFA.Services.DayPhase phase)
    {
        return phase switch
        {
            FFA.Services.DayPhase.Dawn => "🌅",
            FFA.Services.DayPhase.Day => "☀️",
            FFA.Services.DayPhase.Dusk => "🌆",
            FFA.Services.DayPhase.Night => "🌙",
            _ => "🌤️"
        };
    }

    private string GetJobName(string jobName)
    {
        return jobName switch
        {
            "Warrior" => "戦士",
            "Monk" => "武闘家",
            "WhiteMage" => "白魔道士",
            "BlackMage" => "黒魔道士",
            "Ranger" => "レンジャー",
            "Paladin" => "パラディン",
            "DarkKnight" => "ダークナイト",
            "Bard" => "吟遊詩人",
            "Thief" => "盗賊",
            "Ninja" => "忍者",
            "HolyKnight" => "聖騎士",
            "DeathKnight" => "死騎",
            "ArchMage" => "大魔道師",
            "BeastMaster" => "ビーストマスター",
            "Duelist" => "剣豪",
            "Grandmaster" => "マスター",
            _ => jobName
        };
    }

    private string GetLocationName()
    {
        return currentLocationName;
    }

    private int GetHpPercent()
    {
        if (user == null || user.MaxHP == 0) return 0;
        return (int)((double)user.HP / user.MaxHP * 100);
    }

    private int GetExpPercent()
    {
        if (user == null || user.ExpToNext == 0) return 0;
        return (int)((double)user.Exp / user.ExpToNext * 100);
    }

    [JSInvokable]
    public Task OnWorldUpdated(string json)
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            moduleRef = await JS.InvokeAsync<IJSObjectReference>("import", "/js/worldhub.js");
            await moduleRef.InvokeVoidAsync("start", objRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (moduleRef != null)
        {
            await moduleRef.InvokeVoidAsync("stop");
            await moduleRef.DisposeAsync();
        }
        if (objRef != null)
        {
            objRef.Dispose();
        }
    }

    private void GoToTown()
    {
        Navigation.NavigateTo("/town");
    }

    private void GoToField()
    {
        Navigation.NavigateTo("/field");
    }

    private void GoToStatus()
    {
        Navigation.NavigateTo("/status");
    }

    private void GoToInventory()
    {
        Navigation.NavigateTo("/inventory");
    }
}
</div>
