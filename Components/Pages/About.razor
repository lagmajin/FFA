@page "/about"

<PageTitle>About - FFA</PageTitle>

<MudCard Class="pa-4" Style="max-width:900px; margin:1rem auto;">
    <MudText Typo="Typo.h5">About FFA</MudText>
    <MudText Typo="Typo.body1" Class="mt-2">
        FFA は Blazor Server で構築されたオンラインRPGです。キャラクター育成、装備強化、探索、戦闘、ランキングなどを
        ひとつの世界で楽しめます。
    </MudText>

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.h6">主な要素</MudText>
    <MudList Dense="true" Class="mt-2">
        <MudListItem>ジョブ育成とステータス強化</MudListItem>
        <MudListItem>武器・防具・アクセサリー管理</MudListItem>
        <MudListItem>探索、ダンジョン、ギルド、ランキング</MudListItem>
    </MudList>
</MudCard>
