@page "/Error"
@using System.Diagnostics

@inject FFA.Services.DeveloperExceptionService DevEx
@inject IWebHostEnvironment Env
@inject NavigationManager Navigation

<PageTitle>Error</PageTitle>

<div style="max-width: 880px; margin: 2rem auto; padding: 2rem; background: linear-gradient(135deg, #fff7ed 0%, #ffffff 50%, #eff6ff 100%); border: 1px solid #fed7aa; border-radius: 20px; box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);">
    <div style="display:flex; flex-wrap:wrap; gap:1.5rem; align-items:flex-start; justify-content:space-between;">
        <div style="flex:1; min-width:280px;">
            <div style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.35rem 0.75rem; border-radius:999px; background:#fff; border:1px solid #fdba74; color:#9a3412; font-size:0.9rem; font-weight:700;">
                System Error
            </div>
            <h1 style="margin:1rem 0 0.5rem; font-size:2rem; line-height:1.2; color:#7c2d12;">処理中にエラーが発生しました</h1>
            <p style="margin:0; color:#7c2d12; line-height:1.7;">
                まずはページの再読み込みを試し、それでも解消しない場合はホームへ戻って操作をやり直してください。
            </p>
        </div>
        <div style="min-width:220px; padding:1rem 1.25rem; background:#fff; border:1px solid #e5e7eb; border-radius:16px;">
            <div style="font-size:0.8rem; letter-spacing:0.08em; text-transform:uppercase; color:#6b7280;">Environment</div>
            <div style="margin-top:0.25rem; font-weight:700; color:#111827;">@Env.EnvironmentName</div>
            @if (ShowRequestId)
            {
                <div style="margin-top:0.9rem; font-size:0.8rem; letter-spacing:0.08em; text-transform:uppercase; color:#6b7280;">Request ID</div>
                <code style="display:block; margin-top:0.25rem; color:#1f2937;">@RequestId</code>
            }
        </div>
    </div>

    <div style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:1.5rem;">
        <button @onclick="ReloadPage" style="padding:0.85rem 1.25rem; background:#ea580c; color:white; border:none; border-radius:999px; font-weight:700; cursor:pointer;">
            再読み込み
        </button>
        <button @onclick="GoHome" style="padding:0.85rem 1.25rem; background:#2563eb; color:white; border:none; border-radius:999px; font-weight:700; cursor:pointer;">
            ホームへ
        </button>
        <a href="/contact" style="padding:0.85rem 1.25rem; background:white; color:#111827; border:1px solid #d1d5db; border-radius:999px; text-decoration:none; font-weight:700;">
            Contact
        </a>
    </div>

    @if (DevEx.Get() is Exception ex)
    {
        <div style="margin-top: 1.75rem; background-color: #fff; border: 1px solid #fecaca; border-radius: 16px; padding: 1.25rem;">
            <h2 style="margin-top:0; color:#b91c1c; font-size:1.1rem;">例外情報</h2>
            <p style="margin:0.5rem 0;"><strong>型:</strong> @ex.GetType().FullName</p>
            <p style="margin:0.5rem 0;"><strong>メッセージ:</strong> @ex.Message</p>
            @if (ex.InnerException != null)
            {
                <p style="margin:0.5rem 0;"><strong>Inner Exception:</strong> @ex.InnerException.Message</p>
            }
            <details style="margin-top:1rem;">
                <summary style="cursor: pointer; font-weight: bold;">詳細を表示</summary>
                <pre style="white-space: pre-wrap; max-width: 100%; overflow: auto; background: #f8fafc; padding: 10px; font-size: 12px; border-radius: 12px;">@ex.ToString()</pre>
            </details>
        </div>
    }
    else if (Env.IsDevelopment())
    {
        <div style="margin-top: 1.75rem; background-color: #fff; border: 1px solid #fde68a; border-radius: 16px; padding: 1.25rem;">
            <h2 style="margin-top:0; color:#92400e; font-size:1.1rem;">開発環境向けの確認ポイント</h2>
            <p style="color:#78350f; line-height:1.7;">
                例外が取得できていない場合は、ブラウザコンソール、Visual Studio の出力、`App_Data/startup.log` を確認してください。
            </p>
        </div>
    }
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private void ReloadPage()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
