@page "/Error"
@using System.Diagnostics

@inject FFA.Services.DeveloperExceptionService DevEx
@inject IWebHostEnvironment Env

<PageTitle>Error</PageTitle>

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

<p><strong>環境:</strong> <code>@Env.EnvironmentName</code></p>

@if (ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

@if (DevEx.Get() is Exception ex)
{
    <div style="background-color: #fee; border: 2px solid #c00; border-radius: 8px; padding: 20px; margin: 20px 0;">
        <h3 style="color: #c00;">🚨 例外の詳細</h3>
        <p><strong>種類:</strong> @ex.GetType().FullName</p>
        <p><strong>メッセージ:</strong> @ex.Message</p>
        @if (ex.InnerException != null)
        {
            <p><strong>内部例外:</strong> @ex.InnerException.Message</p>
        }
        <details>
            <summary style="cursor: pointer; font-weight: bold;">フルスタックトレース</summary>
            <pre style="white-space: pre-wrap; max-width: 100%; overflow: auto; background: #f5f5f5; padding: 10px; font-size: 12px;">@ex.ToString()</pre>
        </details>
    </div>
}
else if (Env.IsDevelopment())
{
    <div style="background-color: #fff3cd; border: 2px solid #ffc107; border-radius: 8px; padding: 20px; margin: 20px 0;">
        <h3 style="color: #856404;">⚠️ 例外の詳細が取得できません</h3>
        <p>このページが表示される場合、以下を確認してください：</p>
        <ul>
            <li>ブラウザの<strong>開発者ツール → Console</strong> に詳細な例外情報が出力されています（F12キー）</li>
            <li>Visual Studio の<strong>出力ウィンドウ</strong>にサーバーサイドの例外ログが出ています</li>
            <li><code>App_Data/startup.log</code> にも記録されている場合があります</li>
        </ul>
    </div>
}

<div style="margin-top: 20px;">
    <a href="/" style="padding: 10px 20px; background: #2196F3; color: white; text-decoration: none; border-radius: 4px;">ホームへ戻る</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
