@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject Services.UserService UserService

<PageTitle>CGI風ゲーム</PageTitle>

<div class="home-container">
    @if (!string.IsNullOrEmpty(gilQuery) || !string.IsNullOrEmpty(oldCoinQuery) || !string.IsNullOrEmpty(jobQuery))
    {
        <p>所持金: @gilQuery ギル 旧貨幣: @oldCoinQuery 枚 プレミア: @premiumQuery 職業: @jobQuery</p>
    }

    @if (!gameStarted)
    {
        <div class="start-section">
            <p>シンプルなテキストベースのゲームへようこそ！</p>
            <button class="start-button" @onclick="StartGame">ゲームスタート</button>
        </div>
    }
    else
    {
        <div class="game-section">
            <p class="game-message">@currentMessage</p>
            <div class="input-group">
                <input class="game-input" @bind="userInput" @onkeydown="HandleKeyDown" placeholder="コマンドを入力..." />
                <button class="submit-button" @onclick="SubmitInput">送信</button>
            </div>
        </div>
    }
</div>

@code {
    private bool gameStarted = false;
    private string currentMessage = "ゲームを開始しました。何をしますか？";
    private string userInput = "";
    private string gilQuery = string.Empty;
    private string oldCoinQuery = string.Empty;
    private string premiumQuery = string.Empty;
    private string jobQuery = string.Empty;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("gil", out var value))
        {
            gilQuery = value;
        }
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("oldcoin", out var oc))
        {
            oldCoinQuery = oc;
        }
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("premium", out var pv))
        {
            premiumQuery = pv;
        }
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("job", out var jv))
        {
            jobQuery = jv;
        }
    }

    private void StartGame()
    {
        gameStarted = true;
    }

    private void SubmitInput()
    {
        // シンプルなロジック、例えば入力に応じてメッセージ変更
        if (userInput.ToLower() == "hello")
        {
            currentMessage = "こんにちは！";
        }
        else
        {
            currentMessage = $"あなたは '{userInput}' と言いました。";
        }
        userInput = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SubmitInput();
        }
    }
}
