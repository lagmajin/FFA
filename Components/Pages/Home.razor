@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject NavigationManager Navigation
@inject Services.UserService UserService
@inject Services.RankingService RankingService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>FFA - トップ</PageTitle>

<div style="max-width:1100px; margin:1rem auto; padding:1rem;">
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudCard Class="pa-4">
                <MudText Typo="Typo.h4">FFA World</MudText>
                <MudText Typo="Typo.body1" Class="mt-2">
                    育成・探索・戦闘を行いながら、ランキング上位とチャンピオンを目指すRPGです。
                </MudText>
                <div class="mt-4" style="display:flex; gap:8px; flex-wrap:wrap;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HomeLoginClicked">
                        @(isAuth ? "ダッシュボードへ" : "ログイン")
                    </MudButton>
                    @if (!isAuth)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/register">
                            新規登録
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="TestPlay">
                            テストプレイ
                        </MudButton>
                    }
                </div>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Class="pa-4">
                <MudText Typo="Typo.h6">ゲーム統計</MudText>
                <MudText Typo="Typo.body2" Class="mt-2">総ユーザー: @totalUsers</MudText>
                <MudText Typo="Typo.body2">ランキング対象: @rankedUsers</MudText>
                <MudText Typo="Typo.body2">最高レベル: @maxLevel</MudText>
            </MudCard>
        </MudItem>

        <MudItem xs="12">
            <MudCard Class="pa-4">
                <MudText Typo="Typo.h6">現チャンピオン</MudText>
                @if (champion == null)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">チャンピオンはまだ決まっていません。</MudText>
                }
                else
                {
                    <MudGrid Class="mt-2">
                        <MudItem xs="12" md="4"><MudText Typo="Typo.body2">ユーザー: @champion.Username</MudText></MudItem>
                        <MudItem xs="12" md="4"><MudText Typo="Typo.body2">ジョブ: @champion.Job</MudText></MudItem>
                        <MudItem xs="12" md="4"><MudText Typo="Typo.body2">レベル: @champion.Level</MudText></MudItem>
                    </MudGrid>
                }
            </MudCard>
        </MudItem>

        <MudItem xs="12">
            <MudCard Class="pa-4">
                <MudText Typo="Typo.h6">ランキング TOP 10</MudText>
                @if (rankingRows.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">ランキングデータがありません。</MudText>
                }
                else
                {
                    <MudTable Items="@rankingRows.Take(10)" Dense="true" Hover="true" Class="mt-3">
                        <HeaderContent>
                            <MudTh>順位</MudTh>
                            <MudTh>ユーザー</MudTh>
                            <MudTh>レベル</MudTh>
                            <MudTh>Gil</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Rank</MudTd>
                            <MudTd>@context.Username</MudTd>
                            <MudTd>@context.Level</MudTd>
                            <MudTd>@context.Gil.ToString("N0")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCard>
        </MudItem>
    </MudGrid>
</div>

@code {
    private bool isAuth = false;
    private string? username;
    private User? currentUser;
    private User? champion;
    private int totalUsers = 0;
    private int rankedUsers = 0;
    private int maxLevel = 0;
    private List<RankingRow> rankingRows = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        isAuth = user?.Identity?.IsAuthenticated ?? false;
        username = user?.Identity?.Name;

        if (isAuth && username != null)
        {
            currentUser = UserService.GetByUsername(username);
        }

    

        // Load champion and stats
        try
        {
            var allUsers = UserService.GetAllUsers().ToList();
            champion = allUsers.FirstOrDefault(u => u.IsChampion);
            totalUsers = allUsers.Count;

            var ranking = RankingService.GetCurrentRanking().ToList();
            rankedUsers = ranking.Count();
            maxLevel = allUsers.Any() ? allUsers.Max(u => u.Level) : 0;

            // Prepare table rows
            rankingRows = ranking.Select((r, idx) => new RankingRow
            {
                Rank = idx + 1,
                Username = r.Username,
                Gil = r.Gil,
                Level = r.Level
            }).ToList();
        }
        catch { }
    }

public class RankingRow
{
    public int Rank { get; set; }
    public string Username { get; set; } = string.Empty;
    public int Gil { get; set; }
    public int Level { get; set; }
}

    private void HomeLoginClicked()
    {
        if (isAuth)
        {
            // Already authenticated: navigate to dashboard and force full reload to ensure auth cookie/state
            Navigation.NavigateTo("/dashboard", true);
        }
        else
        {
            // Not authenticated: go to login page
            Navigation.NavigateTo("/login");
        }
    }

    private async Task TestPlay()
    {
        const string testUsername = "testplayer";
        const string testPassword = "test123";
        try
        {
            var existingUser = UserService.GetByUsername(testUsername);
            if (existingUser == null)
            {
                UserService.Register(testUsername, testPassword, Models.Job.Warrior);
            }
            var url = Navigation.ToAbsoluteUri("signin").ToString();
            var payload = new { Username = testUsername, Password = testPassword };
            var ok = await JSRuntime.InvokeAsync<bool>("fetchSignIn", url, payload);
            if (ok) Navigation.NavigateTo("/status", true);
        }
        catch { }
    }
}
