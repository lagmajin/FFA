@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject Services.UserService UserService

<PageTitle>CGI風ゲーム</PageTitle>

<link href="/css/home.css" rel="stylesheet" />

@* TODO: 現在のチャンピオン表示機能を実装する *@
<div class="champion-section">
    <div class="champion-card">
        <h3>🏆 現在のチャンピオン</h3>
        <div class="champion-info">
            <div class="champion-avatar">
                <span class="avatar-placeholder">👑</span>
            </div>
            <div class="champion-details">
                <p class="champion-name">--</p>
                <p class="champion-title">チャンピオンが決定するまでお待ちください</p>
                <p class="champion-stats">勝利数: -- | 連続勝利: --</p>
            </div>
        </div>
    </div>
</div>

<div class="home-container">
    @if (!string.IsNullOrEmpty(gilQuery) || !string.IsNullOrEmpty(oldCoinQuery) || !string.IsNullOrEmpty(jobQuery))
    {
        <p>所持金: @gilQuery ギル 旧貨幣: @oldCoinQuery 枚 プレミア: @premiumQuery 職業: @jobQuery</p>
    }

    <div class="game-section">
        <p class="welcome-message">FFAゲームへようこそ！</p>
        <p class="game-description">冒険の世界で戦い、成長し、栄光を手に入れましょう！</p>
        <button class="test-play-button" @onclick="TestPlay">テストプレイ</button>
    </div>
</div>

@code {
    private string gilQuery = string.Empty;
    private string oldCoinQuery = string.Empty;
    private string premiumQuery = string.Empty;
    private string jobQuery = string.Empty;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("gil", out var value))
        {
            gilQuery = value;
        }
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("oldcoin", out var oc))
        {
            oldCoinQuery = oc;
        }
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("premium", out var pv))
        {
            premiumQuery = pv;
        }
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("job", out var jv))
        {
            jobQuery = jv;
        }
    }

    private async Task TestPlay()
    {
        // テストプレイ用のアカウント名とパスワード
        const string testUsername = "testplayer";
        const string testPassword = "test123";

        // 既存のテストアカウントを検索
        var existingUser = UserService.GetByUsername(testUsername);
        
        if (existingUser == null)
        {
            // テストアカウントが存在しない場合は作成
            UserService.Register(testUsername, testPassword, Models.Job.Warrior);
        }

        // テストアカウントでログイン
        var user = UserService.Login(testUsername, testPassword);
        
        if (user != null)
        {
            // ログイン成功後、ステータスページにリダイレクト
            Navigation.NavigateTo("/status");
        }
        else
        {
            // ログイン失敗の処理（ここでは簡易的にアラート表示）
            Console.WriteLine("テストプレイアカウントのログインに失敗しました。");
        }
    }
}
