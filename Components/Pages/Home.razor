@page "/"

<PageTitle>CGI風ゲーム</PageTitle>

<div class="home-container">
    <h1 class="home-title">CGI風ゲーム</h1>

    @if (!gameStarted)
    {
        <div class="start-section">
            <p>シンプルなテキストベースのゲームへようこそ！</p>
            <button class="start-button" @onclick="StartGame">ゲームスタート</button>
        </div>
    }
    else
    {
        <div class="game-section">
            <p class="game-message">@currentMessage</p>
            <div class="input-group">
                <input class="game-input" @bind="userInput" @onkeydown="HandleKeyDown" placeholder="コマンドを入力..." />
                <button class="submit-button" @onclick="SubmitInput">送信</button>
            </div>
        </div>
    }
</div>

@code {
    private bool gameStarted = false;
    private string currentMessage = "ゲームを開始しました。何をしますか？";
    private string userInput = "";

    private void StartGame()
    {
        gameStarted = true;
    }

    private void SubmitInput()
    {
        // シンプルなロジック、例えば入力に応じてメッセージ変更
        if (userInput.ToLower() == "hello")
        {
            currentMessage = "こんにちは！";
        }
        else
        {
            currentMessage = $"あなたは '{userInput}' と言いました。";
        }
        userInput = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SubmitInput();
        }
    }
}
