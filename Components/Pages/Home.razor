@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject Services.UserService UserService
@inject Services.RankingService RankingService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>FFA - トップ</PageTitle>

<div style="font-family: 'MS PGothic', monospace; max-width:1024px; margin:1rem auto; background:#faf8ef; padding:18px; border:1px solid #ccc;">
    <div style="text-align:center;">
        <h1 style="font-size:2.2rem; margin:0; letter-spacing:2px;">FFA — CGI風オンラインRPG</h1>
        <div style="margin-top:6px; color:#666;">古き良きテキスト式インターフェース風トップページ</div>
    </div>

    @* Champion & Stats Section *@
    <div style="margin-top:18px; background:#fff; padding:14px; border:1px solid #ddd;">
        <div style="display:flex; gap:16px;">
            <div style="flex:1; background:#ffffee; padding:12px; border:1px solid #e0e0a0; border-radius:6px;">
                <h3 style="margin:0 0 8px 0;">🏆 現在のチャンピオン</h3>
                @if (champion != null)
                {
                    <div style="font-size:1.1rem;">
                        <strong>@champion.Username</strong> @if (champion.Username == "CPU_Champion") { <em>(CPU)</em> }
                    </div>
                    <div style="margin-top:4px; color:#555;">レベル @champion.Level | 所持金 @champion.Gil ギル</div>
                    <div style="margin-top:4px; color:#555;">職業: @champion.Job</div>
                }
                else
                {
                    <div style="color:#999;">チャンピオン不在（天空闘技場で挑戦しよう！）</div>
                }
            </div>

            <div style="width:240px; background:#f0f8ff; padding:12px; border:1px solid #d0e0ff; border-radius:6px;">
                <h4 style="margin:0 0 8px 0;">統計情報</h4>
                <div style="margin:4px 0;">総登録冒険者: <strong>@totalUsers</strong> 人</div>
                <div style="margin:4px 0;">ランキング登録: <strong>@rankedUsers</strong> 人</div>
                <div style="margin:4px 0;">最高レベル: <strong>@maxLevel</strong></div>
            </div>
        </div>
    </div>

    <div style="display:flex; gap:16px; margin-top:18px;">
        <div style="width:260px; background:#fff; padding:12px; border:1px solid #ddd;">
            <h3 style="margin-top:0;">メニュー</h3>
            <ul style="padding-left:1rem;">
                @* Public / always-visible links *@
                <li><NavLink href="/market">マーケット</NavLink></li>
                <li><NavLink href="/sky-arena">天空闘技場</NavLink></li>
                <li><NavLink href="/ranking">ランキング</NavLink></li>
                <li><NavLink href="/chat">チャット</NavLink></li>

                @* Auth-only links: show only when logged in *@
                @if (isAuth)
                {
                    <li><NavLink href="/status">ステータス</NavLink></li>
                    <li><NavLink href="/town">街</NavLink></li>
                    <li><NavLink href="/field">フィールド</NavLink></li>
                    <li><NavLink href="/inventory">インベントリ</NavLink></li>
                    <li><NavLink href="/quests">クエスト</NavLink></li>
                }
            </ul>
        </div>

        <div style="flex:1; background:#fff; padding:14px; border:1px solid #ddd;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">
                <div style="flex:1;">
                    <h2 style="margin:0 0 6px 0;">ようこそ、FFAの世界へ</h2>
                    <p style="margin:0 0 8px 0; color:#444;">テキストベースの世界を探索し、装備を整え、チャンピオンを目指しましょう。</p>
                </div>

                <div style="width:300px;">
                    @if (isAuth && currentUser != null)
                    {
                        <div style="background:#f5f5ff; padding:10px; border:1px solid #e0e0ff; border-radius:6px;">
                            <h4 style="margin:0 0 6px 0;">現在の冒険者</h4>
                            <p style="margin:4px 0;"><strong>@currentUser.Username</strong> (レベル @currentUser.Level)</p>
                            <p style="margin:4px 0;">所持金: @currentUser.Gil ギル</p>
                            <p style="margin:4px 0;">職業: @currentUser.Job</p>
                            <p style="margin:4px 0;">未割り振りポイント: @currentUser.Status.PointsAvailable</p>
                            <div style="margin-top:8px;"><NavLink href="/status">詳細を見る</NavLink></div>
                        </div>
                    }
                    else
                    {
                        <div style="background:#fff7f0; padding:10px; border:1px solid #ffe0c0; border-radius:6px;">
                            <h4 style="margin:0 0 6px 0;">はじめての方へ</h4>
                            <p style="margin:4px 0;">ログインすると冒険を開始できます。</p>
                            <div style="margin-top:8px;"><NavLink href="/login">ログイン</NavLink> / <NavLink href="/register">新規登録</NavLink></div>
                            <div style="margin-top:8px;"><a href="#" @onclick="TestPlay">テストプレイ</a></div>
                        </div>
                    }
                </div>
            </div>

            <hr />

            <div style="display:flex; gap:12px; margin-top:12px;">
                <div style="flex:1; background:#f7f7f7; padding:10px; border:1px solid #eee;">
                    <h4 style="margin-top:0;">今日のトピック</h4>
                    <p style="margin:0;">・新しいダンジョンが近日実装予定。<br/>・天空闘技場のチャンピオンは定期的にリセットされます。<br/>・マーケットで他の冒険者とアイテム取引ができます。</p>
                </div>
                <div style="width:220px; background:#f7f7f7; padding:10px; border:1px solid #eee;">
                    <h4 style="margin-top:0;">クイックリンク</h4>
                    <p style="margin:0;"><NavLink href="/market">マーケット</NavLink><br/><NavLink href="/ranking">ランキング</NavLink><br/><NavLink href="/sky-arena">天空闘技場</NavLink></p>
                </div>
            </div>

            <div style="margin-top:12px; font-size:0.95rem; color:#333;">
                <pre style="background:#fffbe6; padding:10px; border-radius:4px; white-space:pre-wrap;">ようこそ、冒険者よ。コマンドはメニューから選択してください。
（このページはオリジナルのCGI風インターフェースを再現したトップです）</pre>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isAuth = false;
    private string? username;
    private User? currentUser;
    private User? champion;
    private int totalUsers = 0;
    private int rankedUsers = 0;
    private int maxLevel = 0;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        isAuth = user?.Identity?.IsAuthenticated ?? false;
        username = user?.Identity?.Name;

        if (isAuth && username != null)
        {
            currentUser = UserService.GetByUsername(username);
        }

        // Load champion and stats
        try
        {
            var allUsers = UserService.GetAllUsers().ToList();
            champion = allUsers.FirstOrDefault(u => u.IsChampion);
            totalUsers = allUsers.Count;

            var ranking = RankingService.GetCurrentRanking();
            rankedUsers = ranking.Count();
            maxLevel = allUsers.Any() ? allUsers.Max(u => u.Level) : 0;
        }
        catch { }
    }

    private async Task TestPlay()
    {
        const string testUsername = "testplayer";
        const string testPassword = "test123";
        try
        {
            var existingUser = UserService.GetByUsername(testUsername);
            if (existingUser == null)
            {
                UserService.Register(testUsername, testPassword, Models.Job.Warrior);
            }
            var url = Navigation.ToAbsoluteUri("/signin").ToString();
            var payload = new { Username = testUsername, Password = testPassword };
            var ok = await JSRuntime.InvokeAsync<bool>("fetchSignIn", url, payload);
            if (ok) Navigation.NavigateTo("/status", true);
        }
        catch { }
    }
}
