@page "/mining"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject Services.MiningService MiningService
@inject Services.UserService UserService
@inject NavigationManager Navigation

<PageTitle>採掘場 - FFA</PageTitle>

<div class="mining-container">
    <div class="mining-header">
        <h1>⛏️ 採掘場</h1>
        <p>鉱石を採掘して素材を集めよう！</p>
    </div>

    @if (!isAuth)
    {
        <div class="auth-warning">
            <p>🔐 ログインして採掘を始めましょう</p>
            <button class="action-button" @onclick="GoToLogin">ログイン</button>
        </div>
    }
    else
    {
        <div class="mining-content">
            <!-- プレイヤー情報 -->
            <div class="player-panel">
                <div class="player-header">
                    <span class="player-icon">👤</span>
                    <div class="player-info">
                        <h3>@currentUser?.Username</h3>
                        <span class="gil">💰 @currentUser?.Gil G</span>
                    </div>
                </div>
                
                @if (miningSkill != null)
                {
                    <div class="skill-panel">
                        <div class="skill-header">
                            <span class="skill-icon">⛏️</span>
                            <span class="skill-name">採掘スキル</span>
                            <span class="skill-level">Lv.@miningSkill.Level</span>
                        </div>
                        <div class="exp-bar">
                            <div class="exp-fill" style="width: @expPercent%"></div>
                        </div>
                        <div class="exp-text">
                            <span>EXP: @miningSkill.Experience / @miningSkill.ExperienceToNext</span>
                            <span>総採掘数: @miningSkill.TotalOresMined</span>
                        </div>
                    </div>
                }
            </div>

            <!-- 採掘エリア選択 -->
            <div class="mining-areas">
                <h2>📍 採掘エリア</h2>
                <div class="area-grid">
                    @foreach (var area in miningAreas)
                    {
                        <div class="area-card @(selectedArea?.Id == area.Id ? "selected" : "")" 
                             @onclick="() => SelectArea(area)">
                            <div class="area-icon">@area.Icon</div>
                            <div class="area-info">
                                <h4>@area.Name</h4>
                                <p class="area-desc">@area.Description</p>
                                <div class="area-ores">
                                    @foreach (var ore in area.AvailableOres.Take(3))
                                    {
                                        <span class="ore-tag">@ore</span>
                                    }
                                </div>
                                <div class="area-requirement">
                                    <span>必要Lv: @area.RequiredLevel</span>
                                    <span>費用: @area.Cost G</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 採掘アクション -->
            @if (selectedArea != null)
            {
                <div class="mining-action">
                    <div class="selected-area">
                        <span class="area-icon-large">@selectedArea.Icon</span>
                        <div>
                            <h3>@selectedArea.Name</h3>
                            <p>費用: @selectedArea.Cost G / 回</p>
                        </div>
                    </div>
                    
                    <div class="action-buttons">
                        <button class="mine-btn" @onclick="DoMining" disabled="@isMining">
                            @if (isMining)
                            {
                                <span class="loading">⛏️ 採掘中...</span>
                            }
                            else
                            {
                                <span>⛏️ 採掘する</span>
                            }
                        </button>
                        <button class="auto-btn" @onclick="DoAutoMining" disabled="@isMining">
                            🔄 連続採掘 (10回)
                        </button>
                    </div>
                </div>
            }

            <!-- 採掘結果 -->
            @if (lastResult != null)
            {
                <div class="result-panel @(lastResult.Success ? "success" : "failure")">
                    @if (lastResult.Success)
                    {
                        <div class="result-content">
                            <span class="result-icon">💎</span>
                            <div class="result-details">
                                <h3>@lastResult.OreName x @lastResult.Quantity</h3>
                                @if (lastResult.LeveledUp)
                                {
                                    <p class="level-up">🎉 スキルレベルアップ！ Lv.@lastResult.SkillLevel</p>
                                }
                                <p class="exp-gained">+@lastResult.ExpGained EXP</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="result-content">
                            <span class="result-icon">❌</span>
                            <p>@lastResult.Message</p>
                        </div>
                    }
                </div>
            }

            <!-- 連続採掘結果 -->
            @if (autoResults.Count > 0)
            {
                <div class="auto-results">
                    <h3>📊 連続採掘結果</h3>
                    <div class="results-summary">
                        <div class="summary-item">
                            <span class="label">成功回数</span>
                            <span class="value">@autoResults.Count(r => r.Success)</span>
                        </div>
                        <div class="summary-item">
                            <span class="label">総獲得数</span>
                            <span class="value">@autoResults.Where(r => r.Success).Sum(r => r.Quantity)</span>
                        </div>
                        <div class="summary-item">
                            <span class="label">総経験値</span>
                            <span class="value">@autoResults.Sum(r => r.ExpGained)</span>
                        </div>
                    </div>
                    <div class="results-list">
                        @foreach (var result in autoResults.Where(r => r.Success).TakeLast(10))
                        {
                            <span class="result-item">@result.OreName x@result.Quantity</span>
                        }
                    </div>
                </div>
            }

            <!-- 鉱石図鑑 -->
            <div class="ore-dex">
                <h2>📖 鉱石図鑑</h2>
                <div class="ore-grid">
                    @foreach (var ore in allOres)
                    {
                        var canMine = miningSkill != null && miningSkill.Level >= ore.RequiredSkillLevel;
                        <div class="ore-card @(canMine ? "available" : "locked")">
                            <div class="ore-icon">@GetOreIcon(ore.Type)</div>
                            <div class="ore-info">
                                <h4>@ore.JapaneseName</h4>
                                <div class="ore-stats">
                                    <span>価値: @ore.Value G</span>
                                    <span>必要Lv: @ore.RequiredSkillLevel</span>
                                </div>
                                @if (!canMine)
                                {
                                    <span class="locked-label">🔒 ロック</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
