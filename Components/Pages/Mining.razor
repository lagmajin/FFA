        padding: 10px 20px;
        background: var(--mud-palette-primary);
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }
</style>

@code {
    private bool isAuth = false;
    private string? username;
    private User? currentUser;
    private MiningSkill? miningSkill;
    private MiningResult? lastResult;
    private List<MiningResult> autoResults = new();
    private List<Ore> allOres = new();
    private MiningArea? selectedArea;
    private bool isMining = false;
    
    private int expPercent => miningSkill != null 
        ? (int)((double)miningSkill.Experience / miningSkill.ExperienceToNext * 100) 
        : 0;

    private List<MiningArea> miningAreas = new()
    {
        new MiningArea 
        { 
            Id = 1, 
            Name = "初心者の洞窟", 
            Icon = "🕳️", 
            Description = "銅と鉄が採れる入門用エリア",
            RequiredLevel = 1, 
            Cost = 5,
            AvailableOres = new List<string> { "銅鉱石", "鉄鉱石" }
        },
        new MiningArea 
        { 
            Id = 2, 
            Name = "銀の坑道", 
            Icon = "🪨", 
            Description = "銀と金が採れる中級エリア",
            RequiredLevel = 10, 
            Cost = 15,
            AvailableOres = new List<string> { "銀鉱石", "金鉱石" }
        },
        new MiningArea 
        { 
            Id = 3, 
            Name = "ミスリル鉱山", 
            Icon = "💎", 
            Description = "ミスリルが採れる上級エリア",
            RequiredLevel = 25, 
            Cost = 30,
            AvailableOres = new List<string> { "ミスリル鉱石", "アダマンタイト" }
        },
        new MiningArea 
        { 
            Id = 4, 
            Name = "古代の遺跡", 
            Icon = "🏛️", 
            Description = "オリハルコンが眠る伝説のエリア",
            RequiredLevel = 45, 
            Cost = 50,
            AvailableOres = new List<string> { "オリハルコン", "魔法結晶" }
        },
        new MiningArea 
        { 
            Id = 5, 
            Name = "竜の巣", 
            Icon = "🐉", 
            Description = "ダイヤと不死鳥の羽がある最上級エリア",
            RequiredLevel = 70, 
            Cost = 100,
            AvailableOres = new List<string> { "ダイヤモンド", "不死鳥の羽" }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var authUser = state.User;
        isAuth = authUser?.Identity?.IsAuthenticated ?? false;
        username = authUser?.Identity?.Name;

        if (isAuth && username != null)
        {
            currentUser = UserService.GetByUsername(username);
            miningSkill = MiningService.GetSkill(username) ?? MiningService.InitializeSkill(username);
        }
        
        allOres = MiningDatabase.Ores;
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void SelectArea(MiningArea area)
    {
        if (miningSkill != null && miningSkill.Level >= area.RequiredLevel)
        {
            selectedArea = area;
        }
    }

    private async Task DoMining()
    {
        if (username == null || selectedArea == null) return;
        
        isMining = true;
        StateHasChanged();
        
        await Task.Delay(500);
        
        lastResult = MiningService.Mine(username);
        
        // ユーザー情報を更新
        currentUser = UserService.GetByUsername(username);
        miningSkill = MiningService.GetSkill(username);
        
        isMining = false;
        StateHasChanged();
    }

    private async Task DoAutoMining()
    {
        if (username == null || selectedArea == null) return;
        
        isMining = true;
        autoResults.Clear();
        StateHasChanged();
        
        for (int i = 0; i < 10; i++)
        {
            await Task.Delay(200);
            
            var result = MiningService.Mine(username);
            autoResults.Add(result);
            
            if (!result.Success)
                break;
        }
        
        // ユーザー情報を更新
        currentUser = UserService.GetByUsername(username);
        miningSkill = MiningService.GetSkill(username);
        
        isMining = false;
        StateHasChanged();
    }
    
    private string GetOreIcon(OreType type)
    {
        return type switch
        {
            OreType.Copper => "🟤",
            OreType.Iron => "⚫",
            OreType.Silver => "⚪",
            OreType.Gold => "🟡",
            OreType.Mithril => "🔵",
            OreType.Adamantite => "🟣",
            OreType.Orichalcum => "🟠",
            OreType.Crystal => "💠",
            OreType.Diamond => "💎",
            OreType.Phoenix => "🔥",
            _ => "🪨"
        };
    }
    
    private class MiningArea
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "🪨";
        public string Description { get; set; } = "";
        public int RequiredLevel { get; set; }
        public int Cost { get; set; }
        public List<string> AvailableOres { get; set; } = new();
    }
}
