@code {
    [Parameter]
    public int? FieldId { get; set; }
    
    private User? currentUser;
    private Models.Field? currentField;
    private List<Enemy> currentEnemies = new();
    private List<string> battleLog = new();
    
    // 同時に出現するモンスターの最大数（基盤整備）
    private int MaxConcurrentEnemies = 3;
    
    // 現在のターゲット（攻撃対象）のインデックス
    private int targetEnemyIndex = 0;
    
    // ターゲットとしている敵（便利プロパティ）
    private Enemy? GetCurrentTarget() => 
        currentEnemies.Count > 0 && targetEnemyIndex < currentEnemies.Count 
            ? currentEnemies[targetEnemyIndex] 
            : null;
    
    // ターゲットを設定
    private void SetTarget(int index)
    {
        if (index >= 0 && index < currentEnemies.Count)
        {
            targetEnemyIndex = index;
        }
    }
    
    // 死亡した敵を移除
    private void RemoveDeadEnemies()
    {
        currentEnemies = currentEnemies.Where(e => e.HP > 0).ToList();
        if (targetEnemyIndex >= currentEnemies.Count)
        {
            targetEnemyIndex = Math.Max(0, currentEnemies.Count - 1);
        }
    }
    
    // 戦闘終了判定
    private bool IsBattleComplete => currentEnemies.Count == 0;
    
    // 生存している敵の数
    private int ActiveEnemyCount => currentEnemies.Count(e => e.HP > 0);
    
    // urrentEnemyプロパティ（旧バージョンとの互換性のため）
    private Enemy? currentEnemy {
        get => GetCurrentTarget();
        set {
            if (value != null)
            {
                currentEnemies.Add(value);
            }
        }
    }
    private DungeonService.BattleSession? battleSession;
    
    private bool isProcessing = false;
    private int gainedExp = 0;
    private int gainedGil = 0;
    private int bonusExp = 0;
    private int bonusGil = 0;
    private int expLoss = 0;
    private List<DungeonService.DropResult> droppedItems = new();
    
    private int enemyHpPercent => currentEnemy != null ? (currentEnemy.HP * 100 / Math.Max(1, currentEnemy.MaxHP)) : 0;
    private int playerHpPercent => currentUser != null ? (currentUser.HP * 100 / Math.Max(1, currentUser.MaxHP)) : 100;

    protected override void OnInitialized()
    {
        currentUser = UserService.GetAllUsers().FirstOrDefault();
        
        if (FieldId.HasValue)
        {
            currentField = FieldService.GetFieldById(FieldId.Value);
        }
    }
    
    protected override void OnParametersSet()
    {
        if (FieldId.HasValue)
        {
            currentField = FieldService.GetFieldById(FieldId.Value);
        }
    }

    private void GoToField()
    {
        Navigation.NavigateTo("/field");
    }

    private void SearchEnemy()
    {
        if (currentField == null || currentUser == null) return;
        
        battleLog.Clear();
        droppedItems.Clear();
        bonusExp = 0;
        bonusGil = 0;
        
        // 複数モンスター出現基盤: 1〜MaxConcurrentEnemies体の敵を出現
        var rand = new Random();
        var enemyCount = rand.Next(1, Math.Min(MaxConcurrentEnemies, (currentField.Enemies?.Length ?? 1)) + 1);
        
        currentEnemies.Clear();
        for (int i = 0; i < enemyCount; i++)
        {
            var enemy = GenerateEnemyForField(currentField, i);
            currentEnemies.Add(enemy);
        }
        
        targetEnemyIndex = 0;
        
        // バトルセッション開始
        battleSession = new DungeonService.BattleSession();
        
        // 先制攻撃判定（最初の敵に対して）
        var firstEnemy = currentEnemies[0];
        if (DungeonService.CheckPreemptiveStrike(currentUser, firstEnemy))
        {
            battleSession.IsPlayerTurn = true;
            battleLog.Add($"⚡ 先制攻撃のチャンス！");
        }
        else
        {
            battleSession.IsPlayerTurn = true;
        }
        
        var enemyNames = string.Join("、", currentEnemies.Select(e => $"{e.Icon}{e.Name}"));
        battleLog.Add($"{currentField.Name}で {enemyNames} が現れた！");
    }
    
    // 複数敵生成対応
    private Enemy GenerateEnemyForField(Models.Field field, int groupIndex = 0)
    {
        var random = new Random();
        var modifiers = TimeWeatherService.GetModifiers();
        
        // 夜間-only monsters chance
        var isNight = TimeWeatherService.IsNight;
        string enemyName;
        
        if (isNight && random.NextDouble() < 0.15)
        {
            // 夜は特別な敵に出逢う可能性がある
            var nightMonsters = TimeWeatherService.GetNightOnlyMonsters();
            if (nightMonsters.Count > 0)
            {
                enemyName = nightMonsters[random.Next(nightMonsters.Count)];
            }
            else
            {
                enemyName = field.Enemies[random.Next(field.Enemies.Length)];
            }
        }
        else
        {
            enemyName = field.Enemies[random.Next(field.Enemies.Length)];
        }
        
        var userLevel = currentUser?.Exp / 100 + 1 ?? 1;
        
        // エリア難易度に基づく基本ステータス
        var baseHp = 30 + field.Difficulty * 20;
        var baseAtk = 8 + field.Difficulty * 5;
        var baseDef = 3 + field.Difficulty * 2;
        var baseExp = 15 + field.Difficulty * 10;
        var baseGil = 10 + field.Difficulty * 8;
        
        // レベル調整
        var levelMultiplier = 1.0 + (userLevel - 1) * 0.05;
        
        // モンスタータイプ決定（低確率でエリート・レア）
        var typeRoll = random.Next(100);
        var enemyType = EnemyType.Normal;
        var typeMultiplier = 1.0;
        
        // 夜はエリート・レア出現率上昇
        var eliteChance = isNight ? 15 : 10;
        var rareChance = isNight ? 8 : 3;
        
        if (typeRoll < rareChance) // 8% レア（夜）
        {
            enemyType = EnemyType.Rare;
            typeMultiplier = 2.0;
        }
        else if (typeRoll < eliteChance) // 7% エリート（夜）
        {
            enemyType = EnemyType.Elite;
            typeMultiplier = 1.5;
        }
        
        // 夜間-débuffs apply
        var nightHpMult = modifiers.MonsterHPMultiplier;
        var nightAtkMult = modifiers.MonsterAttackMultiplier;
        var nightDefMult = modifiers.MonsterDefenseMultiplier;
        var nightExpMult = modifiers.MonsterExpMultiplier;
        var nightDropMult = modifiers.MonsterDropRateMultiplier;
        
        // ドロップアイテム生成
        var drops = new List<DropItem>();
        var dropName = field.Drops[random.Next(field.Drops.Length)];
        drops.Add(new DropItem 
        { 
            Name = dropName, 
            DropRate = (int)((25 + field.Difficulty * 5) * nightDropMult),
            MinQuantity = 1,
            MaxQuantity = 1 + field.Difficulty / 2
        });
        
        // レアドロップ（エリート・レアのみ）
        DropItem? rareDrop = null;
        if (enemyType != EnemyType.Normal)
        {
            rareDrop = new DropItem
            {
                Name = GetRareDropForField(field),
                DropRate = (int)((enemyType == EnemyType.Rare ? 30 : 15) * nightDropMult),
                Rarity = enemyType == EnemyType.Rare ? ItemRarity.Epic : ItemRarity.Rare,
                MinQuantity = 1,
                MaxQuantity = 1
            };
        }
        
        // 夜間-warning tag
        var nightTag = isNight ? " [夜]" : "";
        
        return new Enemy
        {
            Name = enemyName + nightTag,
            Icon = GetEnemyIcon(enemyName),
            Level = Math.Max(1, field.Difficulty * 3 + random.Next(-1, 2)),
            HP = (int)(baseHp * levelMultiplier * typeMultiplier * nightHpMult),
            MaxHP = (int)(baseHp * levelMultiplier * typeMultiplier * nightHpMult),
            Attack = (int)(baseAtk * levelMultiplier * typeMultiplier * nightAtkMult),
            Defense = (int)(baseDef * levelMultiplier * typeMultiplier * nightDefMult),
            Exp = (int)(baseExp * typeMultiplier * nightExpMult),
            Gil = (int)(baseGil * typeMultiplier),
            Type = enemyType,
            Speed = 10 + field.Difficulty * 2,
            DropItems = drops,
            RareDrop = rareDrop,
            BonusExp = enemyType != EnemyType.Normal ? (int)(baseExp * 0.5 * (int)typeMultiplier * nightExpMult) : 0,
            BonusGil = enemyType != EnemyType.Normal ? (int)(baseGil * 0.5 * (int)typeMultiplier) : 0
        };
    }
    
    private string GetEnemyIcon(string enemyName)
    {
        return enemyName switch
        {
            "スライム" => "🟢",
            "ウサギ" => "🐰",
            "蝶" => "🦋",
            "ゴブリン" => "👺",
            "狼" or "ウolf" => "🐺",
            "毒キノコ" => "🍄",
            "水.Elemental" => "💧",
            "魚人" => "🐟",
            "アシガエル" => "🐸",
