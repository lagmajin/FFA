        padding: 10px 20px;
        background: #757575;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }
</style>

@code {
    [Parameter]
    public int? FieldId { get; set; }
    
    private User? currentUser;
    private Models.Field? currentField;
    private Enemy? currentEnemy;
    private List<string> battleLog = new();
    private DungeonService.BattleSession? battleSession;
    
    private bool isProcessing = false;
    private int gainedExp = 0;
    private int gainedGil = 0;
    private int bonusExp = 0;
    private int bonusGil = 0;
    private int expLoss = 0;
    private List<DungeonService.DropResult> droppedItems = new();
    
    private int enemyHpPercent => currentEnemy != null ? (currentEnemy.HP * 100 / Math.Max(1, currentEnemy.MaxHP)) : 0;
    private int playerHpPercent => currentUser != null ? (currentUser.HP * 100 / Math.Max(1, currentUser.MaxHP)) : 100;

    protected override void OnInitialized()
    {
        currentUser = UserService.GetAllUsers().FirstOrDefault();
        
        if (FieldId.HasValue)
        {
            currentField = FieldService.GetFieldById(FieldId.Value);
        }
    }
    
    protected override void OnParametersSet()
    {
        if (FieldId.HasValue)
        {
            currentField = FieldService.GetFieldById(FieldId.Value);
        }
    }

    private void GoToField()
    {
        Navigation.NavigateTo("/field");
    }

    private void SearchEnemy()
    {
        if (currentField == null || currentUser == null) return;
        
        battleLog.Clear();
        droppedItems.Clear();
        bonusExp = 0;
        bonusGil = 0;
        
        // モンスター生成
        currentEnemy = GenerateEnemyForField(currentField);
        
        // バトルセッション開始
        battleSession = new DungeonService.BattleSession();
        
        // 先制攻撃判定
        if (DungeonService.CheckPreemptiveStrike(currentUser, currentEnemy))
        {
            battleSession.IsPlayerTurn = true;
            battleLog.Add($"⚡ 先制攻撃のチャンス！");
        }
        else
        {
            battleSession.IsPlayerTurn = true;
        }
        
        battleLog.Add($"{currentField.Name}で {currentEnemy.Icon} {currentEnemy.Name} が現れた！");
    }
    
    private Enemy GenerateEnemyForField(Models.Field field)
    {
        var random = new Random();
        var enemyName = field.Enemies[random.Next(field.Enemies.Length)];
        var userLevel = currentUser?.Exp / 100 + 1 ?? 1;
        
        // エリア難易度に基づく基本ステータス
        var baseHp = 30 + field.Difficulty * 20;
        var baseAtk = 8 + field.Difficulty * 5;
        var baseDef = 3 + field.Difficulty * 2;
        var baseExp = 15 + field.Difficulty * 10;
        var baseGil = 10 + field.Difficulty * 8;
        
        // レベル調整
        var levelMultiplier = 1.0 + (userLevel - 1) * 0.05;
        
        // モンスタータイプ決定（低確率でエリート・レア）
        var typeRoll = random.Next(100);
        var enemyType = EnemyType.Normal;
        var typeMultiplier = 1.0;
        
        if (typeRoll < 3) // 3% レア
        {
            enemyType = EnemyType.Rare;
            typeMultiplier = 2.0;
        }
        else if (typeRoll < 10) // 7% エリート
        {
            enemyType = EnemyType.Elite;
            typeMultiplier = 1.5;
        }
        
        // ドロップアイテム生成
        var drops = new List<DropItem>();
        var dropName = field.Drops[random.Next(field.Drops.Length)];
        drops.Add(new DropItem 
        { 
            Name = dropName, 
            DropRate = 25 + field.Difficulty * 5,
            MinQuantity = 1,
            MaxQuantity = 1 + field.Difficulty / 2
        });
        
        // レアドロップ（エリート・レアのみ）
        DropItem? rareDrop = null;
        if (enemyType != EnemyType.Normal)
        {
            rareDrop = new DropItem
            {
                Name = GetRareDropForField(field),
                DropRate = enemyType == EnemyType.Rare ? 30 : 15,
                Rarity = enemyType == EnemyType.Rare ? ItemRarity.Epic : ItemRarity.Rare,
                MinQuantity = 1,
                MaxQuantity = 1
            };
        }
        
        return new Enemy
        {
            Name = enemyName,
            Icon = GetEnemyIcon(enemyName),
            Level = Math.Max(1, field.Difficulty * 3 + random.Next(-1, 2)),
            HP = (int)(baseHp * levelMultiplier * typeMultiplier),
            MaxHP = (int)(baseHp * levelMultiplier * typeMultiplier),
            Attack = (int)(baseAtk * levelMultiplier * typeMultiplier),
            Defense = (int)(baseDef * levelMultiplier * typeMultiplier),
            Exp = (int)(baseExp * typeMultiplier),
            Gil = (int)(baseGil * typeMultiplier),
            Type = enemyType,
            Speed = 10 + field.Difficulty * 2,
            DropItems = drops,
            RareDrop = rareDrop,
            BonusExp = enemyType != EnemyType.Normal ? (int)(baseExp * 0.5 * (int)typeMultiplier) : 0,
            BonusGil = enemyType != EnemyType.Normal ? (int)(baseGil * 0.5 * (int)typeMultiplier) : 0
        };
    }
    
    private string GetEnemyIcon(string enemyName)
    {
        return enemyName switch
        {
            "スライム" => "🟢",
            "ウサギ" => "🐰",
            "蝶" => "🦋",
            "ゴブリン" => "👺",
            "狼" or "ウolf" => "🐺",
            "毒キノコ" => "🍄",
            "水.Elemental" => "💧",
            "魚人" => "🐟",
            "アシガエル" => "🐸",
            "サソリ" => "🦂",
            "トカゲ" => "🦎",
            "ミイラ" => "🧟",
            "雪だるま" => "⛄",
            "冰ゴーレム" => "🧊",
            "白狼" => "🐺",
            "溶岩ゴーレム" => "🔥",
            "火織" => "🔥",
            "炎 Elemental" => "🔥",
            "スケルトン" => "💀",
            "リッチ" => "👻",
            "オーク" => "👹",
            _ => "👾"
        };
    }
    
    private string GetRareDropForField(Models.Field field)
    {
        return field.Difficulty switch
        {
            1 => "不思議な種",
            2 => "精霊の雫",
            3 => "古代の砂",
            4 => "氷晶石",
            5 => "ドラゴンの牙",
            _ => "神秘の結晶"
        };
    }
    
    private string GetEnemyTypeLabel(EnemyType type)
    {
        return type switch
        {
            EnemyType.Elite => "エリート",
            EnemyType.Rare => "レア",
            EnemyType.Boss => "ボス",
            EnemyType.Event => "イベント",
            _ => ""
        };
    }
    
    private string GetRarityClass(ItemRarity rarity)
    {
        return $"rarity-{rarity.ToString().ToLower()}";
    }

    private async Task PlayerAttack()
    {
        if (currentEnemy == null || currentUser == null || battleSession == null) return;
        
        isProcessing = true;
        
        var result = DungeonService.PlayerAttack(currentUser, currentEnemy, battleSession);
        battleLog.Add(result.Message);
        
        if (result.BattleEnded)
        {
            await HandleVictory();
        }
        else
        {
            // 敵のターンへ
            battleSession.IsPlayerTurn = false;
            StateHasChanged();
            
            await Task.Delay(1000);
            await EnemyTurn();
        }
        
        isProcessing = false;
    }
    
    private async Task PlayerDefend()
    {
        if (currentEnemy == null || currentUser == null || battleSession == null) return;
        
        isProcessing = true;
        
        var result = DungeonService.PlayerDefend(currentUser, currentEnemy, battleSession);
        battleLog.Add(result.Message);
        
        // 敵のターンへ
        battleSession.IsPlayerTurn = false;
        StateHasChanged();
        
        await Task.Delay(1000);
        await EnemyTurn();
        
        isProcessing = false;
    }
    
    private async Task PlayerFlee()
    {
        if (currentEnemy == null || currentUser == null || battleSession == null) return;
        
        isProcessing = true;
        
        var result = DungeonService.PlayerFlee(currentUser, currentEnemy, battleSession);
        battleLog.Add(result.Message);
        
        if (result.Success)
        {
            currentEnemy = null;
            battleSession = null;
        }
        else
        {
            // 逃走失敗、敵のターン
            battleSession.IsPlayerTurn = false;
            StateHasChanged();
            
            await Task.Delay(1000);
            await EnemyTurn();
        }
        
        isProcessing = false;
    }
    
    private async Task EnemyTurn()
    {
        if (currentEnemy == null || currentUser == null || battleSession == null) return;
        
        var result = DungeonService.EnemyAttack(currentUser, currentEnemy, battleSession);
        battleLog.Add(result.Message);
        
        battleSession.Turn++;
        
        if (result.BattleEnded)
        {
            await HandleDefeat();
        }
        else
        {
            // プレイヤーのターンへ
            battleSession.IsPlayerTurn = true;
        }
        
        StateHasChanged();
    }
    
    private async Task HandleVictory()
    {
        if (currentUser == null || currentEnemy == null || battleSession == null) return;
        
        // 報酬計算
        var (baseExp, baseGil, bExp, bGil) = DungeonService.CalculateRewards(currentEnemy, battleSession);
        gainedExp = baseExp;
        gainedGil = baseGil;
        bonusExp = bExp;
        bonusGil = bGil;
        
        // 経験値・ギル付与
        currentUser.Exp += gainedExp + bonusExp;
        currentUser.Gil += gainedGil + bonusGil;
        
        // ドロップ生成
        droppedItems = DungeonService.GenerateDrops(currentEnemy, battleSession.ComboCount);
        
        // インベントリに追加
        foreach (var drop in droppedItems)
        {
            var existingItem = currentUser.Inventory.FirstOrDefault(i => i.Name == drop.Name);
            if (existingItem != null)
            {
                existingItem.Quantity += drop.Quantity;
            }
            else
            {
                currentUser.Inventory.Add(new InventoryItem { Name = drop.Name, Quantity = drop.Quantity });
            }
        }
        
        // クエスト進捗更新
        QuestService.UpdateProgress(currentUser, enemyName: currentEnemy.Name);
        
        UserService.UpdateUser(currentUser);
        
        battleLog.Add($"✨ 戦闘終了！勝利！");
    }
    
    private async Task HandleDefeat()
    {
        if (currentUser == null) return;
        
        // 経験値損失: 基本10 + レベルの5%
        expLoss = 10 + (currentUser.Exp / 20);
        currentUser.Exp = Math.Max(0, currentUser.Exp - expLoss);
        
        // Gold損失: 持有Goldの5%（最低100）
        var goldLoss = Math.Max(100, currentUser.Gil / 20);
        currentUser.Gil = Math.Max(0, currentUser.Gil - goldLoss);
        
        // HPを1に
        currentUser.HP = 1;
        
        UserService.UpdateUser(currentUser);
        
        battleLog.Add($"💀 敗北... {expLoss}経験値、{goldLoss}Gil失った！");
        battleLog.Add("💀 HPが1になった！arlyに回復せよ！");
    }

    private void ContinueSearch()
    {
        if (currentUser == null) return;
        
        // HPを少し回復
        currentUser.HP = Math.Min(currentUser.MaxHP, currentUser.HP + currentUser.MaxHP / 10);
        
        battleSession = null;
        currentEnemy = null;
        battleLog.Clear();
        droppedItems.Clear();
        
        UserService.UpdateUser(currentUser);
    }

    private void Respawn()
    {
        if (currentUser == null) return;
        
        currentUser.HP = currentUser.MaxHP;
        battleSession = null;
        currentEnemy = null;
        battleLog.Clear();
        
        UserService.UpdateUser(currentUser);
    }
}
