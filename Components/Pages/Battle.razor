    private async Task PlayerAttack()
    {
        if (currentEnemy == null || currentUser == null || battleSession == null) return;
        
        isProcessing = true;
        
        var result = DungeonService.PlayerAttack(currentUser, currentEnemy, battleSession);
        battleLog.Add(result.Message);
        
        if (result.BattleEnded)
        {
            await HandleVictory();
        }
        else
        {
            // 敵のターンへ
            battleSession.IsPlayerTurn = false;
            StateHasChanged();
            
            await Task.Delay(1000);
            await EnemyTurn();
        }
        
        isProcessing = false;
    }
    
    private async Task PlayerDefend()
    {
        if (currentEnemy == null || currentUser == null || battleSession == null) return;
        
        isProcessing = true;
        
        var result = DungeonService.PlayerDefend(currentUser, currentEnemy, battleSession);
        battleLog.Add(result.Message);
        
        // 敵のターンへ
        battleSession.IsPlayerTurn = false;
        StateHasChanged();
        
        await Task.Delay(1000);
        await EnemyTurn();
        
        isProcessing = false;
    }
    
    private async Task PlayerFlee()
    {
        if (currentEnemy == null || currentUser == null || battleSession == null) return;
        
        isProcessing = true;
        
        var result = DungeonService.PlayerFlee(currentUser, currentEnemy, battleSession);
        battleLog.Add(result.Message);
        
        if (result.Success)
        {
            currentEnemy = null;
            battleSession = null;
        }
        else
        {
            // 逃走失敗、敵のターン
            battleSession.IsPlayerTurn = false;
            StateHasChanged();
            
            await Task.Delay(1000);
            await EnemyTurn();
        }
        
        isProcessing = false;
    }
    
    private async Task EnemyTurn()
    {
        if (currentEnemy == null || currentUser == null || battleSession == null) return;
        
        var result = DungeonService.EnemyAttack(currentUser, currentEnemy, battleSession);
        battleLog.Add(result.Message);
        
        battleSession.Turn++;
        
        if (result.BattleEnded)
        {
            await HandleDefeat();
        }
        else
        {
            // プレイヤーのターンへ
            battleSession.IsPlayerTurn = true;
        }
        
        StateHasChanged();
    }
    
    private async Task HandleVictory()
    {
        if (currentUser == null || currentEnemy == null || battleSession == null) return;
        
        // 報酬計算
        var (baseExp, baseGil, bExp, bGil) = DungeonService.CalculateRewards(currentEnemy, battleSession);
        gainedExp = baseExp;
        gainedGil = baseGil;
        bonusExp = bExp;
        bonusGil = bGil;
        
        // 経験値・ギル付与
        currentUser.Exp += gainedExp + bonusExp;
        currentUser.Gil += gainedGil + bonusGil;
        
        // ドロップ生成
        droppedItems = DungeonService.GenerateDrops(currentEnemy, battleSession.ComboCount);
        
        // 未鑑定アイテムドロップ判定
        var unidentifiedItem = AppraisalService.GenerateItem(currentField.Difficulty, $"バトル: {currentEnemy.Name}");
        if (unidentifiedItem != null)
        {
            AppraisalService.AddItemToUser(currentUser.Username, unidentifiedItem);
            battleLog.Add($"🔮 未鑑定アイテム「{unidentifiedItem.DisplayName}」を入手！");
        }
        
        // インベントリに追加
        foreach (var drop in droppedItems)
        {
            var existingItem = currentUser.Inventory.FirstOrDefault(i => i.Name == drop.Name);
            if (existingItem != null)
            {
                existingItem.Quantity += drop.Quantity;
            }
            else
            {
                currentUser.Inventory.Add(new InventoryItem { Name = drop.Name, Quantity = drop.Quantity });
            }
        }
        
        // クエスト進捗更新
        QuestService.UpdateProgress(currentUser, enemyName: currentEnemy.Name);
        
        UserService.UpdateUser(currentUser);
        
        battleLog.Add($"✨ 戦闘終了！勝利！");
    }
    
    private async Task HandleDefeat()
    {
        if (currentUser == null) return;
        
        // 経験値損失: 基本10 + レベルの5%
        expLoss = 10 + (currentUser.Exp / 20);
        currentUser.Exp = Math.Max(0, currentUser.Exp - expLoss);
        
        // Gold損失: 持有Goldの5%（最低100）
        var goldLoss = Math.Max(100, currentUser.Gil / 20);
        currentUser.Gil = Math.Max(0, currentUser.Gil - goldLoss);
        
        // HPを1に
        currentUser.HP = 1;
        
        UserService.UpdateUser(currentUser);
        
        battleLog.Add($"💀 敗北... {expLoss}経験値、{goldLoss}Gil失った！");
        battleLog.Add("💀 HPが1になった！arlyに回復せよ！");
    }

    private void ContinueSearch()
    {
        if (currentUser == null) return;
        
        // HPを少し回復
        currentUser.HP = Math.Min(currentUser.MaxHP, currentUser.HP + currentUser.MaxHP / 10);
        
        battleSession = null;
        currentEnemy = null;
        battleLog.Clear();
        droppedItems.Clear();
        
        UserService.UpdateUser(currentUser);
    }

    private void Respawn()
    {
        if (currentUser == null) return;
        
        currentUser.HP = currentUser.MaxHP;
        battleSession = null;
        currentEnemy = null;
        battleLog.Clear();
        
        UserService.UpdateUser(currentUser);
    }
}
