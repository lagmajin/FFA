@page "/battle"
@page "/battle/{FieldId:int}"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject Services.UserService UserService
@inject Services.FieldService FieldService
@inject Services.DungeonService DungeonService
@inject Services.QuestService QuestService
@inject Services.CombatService Combat

<PageTitle>バトル</PageTitle>

<div class="battle-container">
    @if (currentField == null)
    {
        <div class="no-field">
            <h2>場所が選択されていません</h2>
            <p>探索する場所を選んでください</p>
            <button class="action-button" @onclick="GoToField">場所を選ぶ</button>
        </div>
    }
    else if (currentEnemy == null)
    {
        <div class="searching">
            <h2>@currentField.Name</h2>
            <p>@currentField.Description</p>
            <div class="field-info">
                <span>難易度: @currentField.Difficulty</span>
                <span>推奨Lv: @(currentField.Difficulty * 5)</span>
            </div>
            <button class="action-button search-btn" @onclick="SearchEnemy">🔍 敵を探す</button>
            <button class="back-button" @onclick="GoToField">場所を変える</button>
        </div>
    }
    else
    {
        <div class="battle-section">
            <!-- 敵情報 -->
            <div class="enemy-info">
                <div class="enemy-header">
                    <span class="enemy-icon">@currentEnemy.Icon</span>
                    <div class="enemy-details">
                        <h3>@currentEnemy.Name</h3>
                        <span class="enemy-level">Lv.@currentEnemy.Level</span>
                        @if (currentEnemy.Type != EnemyType.Normal)
                        {
                            <span class="enemy-type @currentEnemy.Type.ToString().ToLower()">[@GetEnemyTypeLabel(currentEnemy.Type)]</span>
                        }
                    </div>
                </div>
                <div class="hp-bar-container">
                    <div class="hp-bar enemy-hp">
                        <div class="hp-fill" style="width: @enemyHpPercent%"></div>
                    </div>
                    <span class="hp-text">HP: @currentEnemy.HP / @currentEnemy.MaxHP</span>
                </div>
            </div>

            <!-- プレイヤー情報 -->
            <div class="player-info">
                <h4>👤 @currentUser?.Username</h4>
                <div class="hp-bar-container">
                    <div class="hp-bar player-hp">
                        <div class="hp-fill" style="width: @playerHpPercent%"></div>
                    </div>
                    <span class="hp-text">HP: @currentUser?.HP / @currentUser?.MaxHP</span>
                </div>
                @if (battleSession != null)
                {
                    <div class="battle-stats">
                        <span>ターン: @battleSession.Turn</span>
                        <span>コンボ: @battleSession.ComboCount</span>
                    </div>
                }
            </div>

            <!-- バトルログ -->
            @if (battleLog.Count > 0)
            {
                <div class="battle-log">
                    @foreach (var log in battleLog.TakeLast(5))
                    {
                        <p>@log</p>
                    }
                </div>
            }

            <!-- アクションボタン -->
            @if (battleSession != null && !battleSession.IsFinished && battleSession.IsPlayerTurn)
            {
                <div class="action-buttons">
                    <button class="battle-btn attack-btn" @onclick="PlayerAttack" disabled="@isProcessing">
                        ⚔️ 攻撃
                    </button>
                    <button class="battle-btn defend-btn" @onclick="PlayerDefend" disabled="@isProcessing">
                        🛡️ 防御
                    </button>
                    <button class="battle-btn flee-btn" @onclick="PlayerFlee" disabled="@isProcessing">
                        🏃 逃走
                    </button>
                </div>
            }
            else if (battleSession != null && !battleSession.IsFinished && !battleSession.IsPlayerTurn)
            {
                <div class="waiting-message">
                    <p>敵のターン...</p>
                </div>
            }

            <!-- 勝利結果 -->
            @if (battleSession?.IsFinished == true && battleSession.PlayerWon)
            {
                <div class="result victory">
                    <h3>🎉 勝利！</h3>
                    <div class="rewards">
                        <p>経験値: <strong>+@gainedExp</strong>@if (bonusExp > 0) { <span class="bonus">(+@bonusExp ボーナス)</span> }</p>
                        <p>ギル: <strong>+@gainedGil</strong>@if (bonusGil > 0) { <span class="bonus">(+@bonusGil ボーナス)</span> }</p>
                    </div>
                    @if (droppedItems.Count > 0)
                    {
                        <div class="drops">
                            <h4>📦 ドロップアイテム</h4>
                            @foreach (var drop in droppedItems)
                            {
                                <p class="@GetRarityClass(drop.Rarity)">
                                    @if (drop.IsRare) { <span>★</span> }
                                    @drop.Name x@drop.Quantity
                                </p>
                            }
                        </div>
                    }
                    <div class="result-actions">
                        <button class="action-button" @onclick="ContinueSearch">続きを探索</button>
                        <button class="back-button" @onclick="GoToField">場所を変える</button>
                    </div>
                </div>
            }

            <!-- 敗北結果 -->
            @if (battleSession?.IsFinished == true && !battleSession.PlayerWon)
            {
                <div class="result defeat">
                    <h3>💀 敗北...</h3>
                    <p>経験値を @expLoss 失った</p>
                    <button class="back-button" @onclick="Respawn">リスポーン</button>
                </div>
            }
        </div>
    }
</div>

<style>
    .battle-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
    }
    
    .no-field, .searching {
        text-align: center;
        padding: 40px;
        background: var(--mud-palette-surface);
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .searching h2 {
        color: var(--mud-palette-primary);
        margin-bottom: 10px;
    }
    
    .field-info {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 15px 0;
        color: var(--mud-palette-text-secondary);
    }
    
    .search-btn {
        font-size: 1.2rem;
        padding: 15px 30px;
        margin: 10px;
    }
    
    .battle-section {
        background: var(--mud-palette-surface);
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .enemy-info, .player-info {
        margin-bottom: 15px;
    }
    
    .enemy-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }
    
    .enemy-icon {
        font-size: 2.5rem;
    }
    
    .enemy-details h3 {
        margin: 0;
        display: inline;
    }
    
    .enemy-level {
        margin-left: 10px;
        color: var(--mud-palette-text-secondary);
    }
    
    .enemy-type {
        margin-left: 5px;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.8em;
    }
    
    .enemy-type.elite { background: #ffd700; color: #000; }
    .enemy-type.rare { background: #9932cc; color: #fff; }
    .enemy-type.boss { background: #ff4500; color: #fff; }
    
    .hp-bar-container {
        margin: 5px 0;
    }
    
    .hp-bar {
        height: 20px;
        background: #333;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 5px;
    }
    
    .enemy-hp .hp-fill {
        background: linear-gradient(90deg, #ff4444, #ff6666);
        height: 100%;
        transition: width 0.3s;
    }
    
    .player-hp .hp-fill {
        background: linear-gradient(90deg, #44ff44, #66ff66);
        height: 100%;
        transition: width 0.3s;
    }
    
    .hp-text {
        font-size: 0.9em;
        color: var(--mud-palette-text-secondary);
    }
    
    .battle-stats {
        display: flex;
        gap: 20px;
        margin-top: 10px;
        font-size: 0.9em;
    }
    
    .battle-log {
        background: rgba(0,0,0,0.1);
        border-radius: 8px;
        padding: 10px;
        margin: 15px 0;
        max-height: 150px;
        overflow-y: auto;
    }
    
    .battle-log p {
        margin: 5px 0;
        font-size: 0.9em;
    }
    
    .action-buttons {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 15px;
    }
    
    .battle-btn {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        cursor: pointer;
        transition: transform 0.1s, opacity 0.2s;
    }
    
    .battle-btn:hover:not(:disabled) {
        transform: scale(1.05);
    }
    
    .battle-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .attack-btn {
        background: #e53935;
        color: white;
    }
    
    .defend-btn {
        background: #1e88e5;
        color: white;
    }
    
    .flee-btn {
        background: #757575;
        color: white;
    }
    
    .waiting-message {
        text-align: center;
        padding: 15px;
        color: var(--mud-palette-text-secondary);
    }
    
    .result {
        margin-top: 20px;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
    }
    
    .result.victory {
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
        border: 2px solid #4caf50;
    }
    
    .result.defeat {
        background: linear-gradient(135deg, #ffebee, #ffcdd2);
        border: 2px solid #f44336;
    }
    
