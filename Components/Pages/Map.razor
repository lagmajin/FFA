    private string? copyStatus;

    private async Task CopyDiagnostics()
    {
        try
        {
            var lines = new List<string>();
            if (!string.IsNullOrEmpty(loadError))
            {
                lines.Add($"Error: {loadError}");
                lines.Add("");
            }
            if (MapService?.LoadDiagnostics != null && MapService.LoadDiagnostics.Count > 0)
                lines.AddRange(MapService.LoadDiagnostics);
            var text = string.Join("\n", lines);
            if (string.IsNullOrEmpty(text))
            {
                copyStatus = "コピーする診断情報がありません";
                return;
            }
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            copyStatus = "クリップボードにコピーしました";
        }
        catch (Exception ex)
        {
            copyStatus = $"コピー失敗: {ex.Message}";
        }
    }
